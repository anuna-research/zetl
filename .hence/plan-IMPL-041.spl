;; ── Rule metadata ───────────────────────────────────────────────────

(meta r-ready-tier1-review-spec
  (description "The spec-level Tier-1 review is ready immediately and gates all implementation.")
  (justification "PROTO-001 §AI Trust Boundaries lists authentication core as a no-go area requiring explicit human approval before implementation; SPEC-041 §14 makes Phase-start conditional on it. Building against an unreviewed authentication spec risks discarding work if S1 defects surface."))

(meta r-ready-trait
  (description "Phase 0 starts only after the spec-review gate passes.")
  (justification "Every downstream task builds on the Authenticator trait shape; if the review changes the trait contract, starting earlier wastes the whole refactor."))

(meta r-ready-gate-refactor
  (description "The gate refactor depends on the trait, the middleware, and both existing-method adapters.")
  (justification "REQ-4103 demands the refactor be behaviour-preserving — it can only be proven once passkey + agent-token are both behind the trait and `auth_resolve` exists to route through."))

(meta r-ready-chain-builder
  (description "The chain builder depends on the config lens.")
  (justification "The builder consumes `CollabAuthConfig`; the lens must parse + validate before the builder can assemble an ordered chain (REQ-4102/REQ-4103)."))

(meta r-ready-capability-impl
  (description "The capability-URL authenticator depends on the shared EdDSA-JWT recogniser from Phase 0.")
  (justification "ADR-4109 reuses the `src/user/invite.rs` signing infrastructure via the single `token.rs` recogniser (REQ-4120 one-parser-per-language); the capability token is the same primitive with a disjoint `sub` domain."))

(meta r-ready-oidc-impl
  (description "The OIDC authenticator depends on its cargo feature and on shared auto-provisioning.")
  (justification "ADR-4105 isolates OIDC behind `collab-oidc`; REQ-4111 routes first-login provisioning through the shared `provision.rs` built in Phase 2."))

(meta r-ready-adversarial-review
  (description "The cross-model adversarial review runs once the implementation — including observability — is complete.")
  (justification "PROTO-001 Constitutional Principle 12: no artifact is validated by the session that produced it; the review needs the finished, instrumented system to attack."))

(meta r-ready-changelog-mark
  (description "Final gate: every implementation task, the adversarial review, and the docs.")
  (justification "PROTO-001 §Specification Status Lifecycle: status flips to `implemented` only after all Phase-3 quality gates pass — traceability, tests, docs, and adversarial review of the deliverable."))

(meta r-assign-tier1-review-spec
  (description "Security-sensitive spec review -> the security reviewer agent (fresh context, cross-model).")
  (justification "PROTO-001 §Multi-Model Cognitive Diversity: a Tier-1 review must not be performed by the generating session."))

(meta r-assign-trait
  (description "Rust implementation tasks -> the coder agent."))

(meta r-assign-docs
  (description "Prose documentation -> the docs-writer agent."))

;; ── End of plan ─────────────────────────────────────────────────────

