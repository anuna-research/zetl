(meta plan
  (id "clig-audit-2026-04")
  (title "clig.dev audit remediation")
  (status "active")
  (created "2026-04-14")
  (description "Fix concrete gaps between zetl CLI and clig.dev guidelines: JSON error stream routing, global flag propagation to subcommands, shell completion generation, and --no-input flag for unattended scripting."))

;; ── Agents ──────────────────────────────────────────────────────────
(given agent-claude-available)

;; ── Tasks ───────────────────────────────────────────────────────────

(given task-json-error-stderr)
(meta task-json-error-stderr
  (description "exit_json_error prints to stdout via println!; clig.dev requires errors on stderr so piped JSON consumers can distinguish success. Change println! to eprintln! in src/main.rs:487.")
  (acceptance "`zetl links NoSuch 2>/dev/null | jq .` prints nothing on stdout; error appears on stderr; exit code 1")
  (priority "P0"))

(given task-global-flags)
(meta task-global-flags
  (description "Global flags (--json, --format, --dir, --quiet, --verbose, --no-color, --no-cache) are defined at top level but not marked global=true in clap, so `zetl list --json` fails. Add global=true to each.")
  (acceptance "`zetl list --json`, `zetl search foo --quiet`, `zetl links Page -v` all accept the flag after the subcommand")
  (priority "P0"))

(given task-shell-completions)
(meta task-shell-completions
  (description "Add `zetl completions <shell>` subcommand using clap_complete crate to generate bash/zsh/fish/powershell completion scripts to stdout.")
  (acceptance "`zetl completions zsh` prints a valid completion script; command documented in --help")
  (priority "P1"))

(given task-no-input-flag)
(meta task-no-input-flag
  (description "Add global --no-input flag. When set, `zetl view` without a PAGE arg should error out instead of launching the interactive picker. Makes zetl safe for cron/CI.")
  (acceptance "`zetl view --no-input` without PAGE exits non-zero with a clear error; `zetl view Page --no-input` still works")
  (priority "P1"))

(given task-sigpipe-verify)
(meta task-sigpipe-verify
  (description "Verify SIGPIPE is handled — spot test shows `zetl list | head -5` exits 0, but confirm no panic or BrokenPipe traceback on small pipes. If broken, set signal handler to SIG_DFL at main() entry.")
  (acceptance "`zetl list | head -1` always exits 0 or 141 without stderr noise or panic")
  (priority "P2"))

;; ── Dependencies ────────────────────────────────────────────────────

(normally r-ready-json-error
  task-json-error-stderr
  ready-json-error-stderr)

(normally r-ready-global-flags
  task-global-flags
  ready-global-flags)

(normally r-ready-completions
  task-shell-completions
  ready-shell-completions)

(normally r-ready-no-input
  task-no-input-flag
  ready-no-input-flag)

(normally r-ready-sigpipe
  task-sigpipe-verify
  ready-sigpipe-verify)

;; ── Assignments ─────────────────────────────────────────────────────

(normally r-assign-json-error
  (and ready-json-error-stderr agent-claude-available)
  assign-to-json-error-stderr-claude)

(normally r-assign-global-flags
  (and ready-global-flags agent-claude-available)
  assign-to-global-flags-claude)

(normally r-assign-completions
  (and ready-shell-completions agent-claude-available)
  assign-to-shell-completions-claude)

(normally r-assign-no-input
  (and ready-no-input-flag agent-claude-available)
  assign-to-no-input-flag-claude)

(normally r-assign-sigpipe
  (and ready-sigpipe-verify agent-claude-available)
  assign-to-sigpipe-verify-claude)

(claims agent:claude
  :at "2026-04-13T21:40:28Z"
  (given claim-v1-json-error-stderr)
  (normally r-cl-state-v1-json-error-stderr claim-v1-json-error-stderr state-claimed-v1-json-error-stderr)
  (normally r-cl-chain-v1-json-error-stderr state-claimed-v1-json-error-stderr claimed-json-error-stderr)
)

(claims agent:claude
  :at "2026-04-13T21:40:28Z"
  (given claim-v1-global-flags)
  (normally r-cl-state-v1-global-flags claim-v1-global-flags state-claimed-v1-global-flags)
  (normally r-cl-chain-v1-global-flags state-claimed-v1-global-flags claimed-global-flags)
)

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given completed-json-error-stderr))

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given completed-global-flags))

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given claim-v1-shell-completions)
  (normally r-cl-state-v1-shell-completions claim-v1-shell-completions state-claimed-v1-shell-completions)
  (normally r-cl-chain-v1-shell-completions state-claimed-v1-shell-completions claimed-shell-completions)
)

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given completed-shell-completions))

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given claim-v1-no-input-flag)
  (normally r-cl-state-v1-no-input-flag claim-v1-no-input-flag state-claimed-v1-no-input-flag)
  (normally r-cl-chain-v1-no-input-flag state-claimed-v1-no-input-flag claimed-no-input-flag)
)

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given completed-no-input-flag))

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given sigpipe-already-handled))

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given claim-v1-sigpipe-verify)
  (normally r-cl-state-v1-sigpipe-verify claim-v1-sigpipe-verify state-claimed-v1-sigpipe-verify)
  (normally r-cl-chain-v1-sigpipe-verify state-claimed-v1-sigpipe-verify claimed-sigpipe-verify)
)

(claims agent:claude
  :at "2026-04-13T21:43:37Z"
  (given completed-sigpipe-verify))
