(meta plan
  (id "IMPL-035")
  (title "Collaborative Static Asset Uploads — implementation plan")
  (version "0.1.0")
  (status "active")
  (created "2026-04-22")
  (author "agent:architect")
  (spec "SPEC-035")
  (description "Implement SPEC-035 v0.1.0: static asset uploads in collaborative mode. Authorised editors upload files to .zetl/assets/, served under /assets/{*path}, governed by the SPL can-upload predicate. Seven implementation phases: (A) pure core validation + metadata types, (B) storage layer + atomic write, (C) ACL integration, (D) HTTP route handlers, (E) git integration, (F) minimal admin UI, (G) observability + documentation. Spec-level Tier 2 review (task-assets-tier2-review-spec) gates all implementation phases. Tier 1 security review (task-assets-tier1-review-security) gates merge to main."))

;; ── Agents ──────────────────────────────────────────────────────────────────

(given agent-coder-available)
(given agent-reviewer-spec-available)
(given agent-reviewer-security-available)
(given agent-docs-writer-available)

;; ── Phase 0 — Spec review gate ──────────────────────────────────────────────

(given task-assets-tier2-review-spec)
(meta task-assets-tier2-review-spec
  (description "Tier 2 fresh-context, cross-model adversarial review of SPEC-035 v0.1.0. Per USDD Constitutional Principle 12. Reviewer receives SPEC-035 + SPEC-020 §5-§8 (collab architecture) with an explicit mandate to find design defects. Focus areas: (a) ACL predicate defaults — is the distinction between restricted-scope editors and full-scope editors correct? (b) HTML isolation strategy (ADR-3505) — is the CSRF + HttpOnly cookie defence sufficient? (c) Path traversal two-layer defence (REQ-3510) — is the slug validation exhaustive? (d) Cache-Control semantics after overwrite (REQ-3515) — does max-age=300 post-replace break existing cached clients? (e) Open Question 1 (agent tokens and can-upload) — is the proposed exception safe? Reviewer MUST NOT have participated in writing SPEC-035.")
  (acceptance "Review report produced. Zero S1 findings OR all S1 findings resolved in SPEC-035 v0.2.0 which re-invokes this gate. S2 and below findings documented with resolution plan. Spec status advances from `draft` to `approved` only after this gate passes. Review artifact committed to .hence/reviews/assets-spec-review-<date>.md.")
  (priority "P0")
  (spec-ref "SPEC-035 §11.2, USDD Constitutional Principle 12"))

;; ── Phase A — Pure core: validation and metadata ────────────────────────────

(given task-assets-pure-core)
(meta task-assets-pure-core
  (description "Pure-core modules per SPEC-035 §7 purity boundary map. (1) `src/assets/validation.rs`: `validate_slug(slug: &str) -> Result<(), SlugError>` implementing REQ-3510 rules (no `..`, no empty component, no null bytes, no Windows device names, not empty, no leading/trailing `/`); `check_mime_allowlist(mime: &Mime) -> bool` against the allowlist in REQ-3507. (2) `src/assets/metadata.rs`: `AssetMeta` struct (slug, original_filename, mime_type, size_bytes, sha256, uploaded_by, uploaded_at, replaced_at); serde Serialize + Deserialize with `deny_unknown_fields`; `version: u8 = 1`; `cache_control_for(meta: &AssetMeta) -> &'static str` per REQ-3515; `human_size(bytes: u64) -> String` for git commit messages. No std::fs, no std::env, no randomness. Property-based tests on validate_slug. Mutation testing via cargo-mutants on validation.rs ≥ 85% kill rate.")
  (acceptance "Two files: `src/assets/validation.rs` and `src/assets/metadata.rs`. `pub(crate)` visibility. Clippy forbids `std::fs`, `std::env` in core. `cargo test -p zetl assets::` passes. Property tests for slug validation. Mutation testing ≥ 85% kill rate. TEST-3510 (slug cases table) passes as unit tests.")
  (priority "P0")
  (spec-ref "SPEC-035 REQ-3503, REQ-3507, REQ-3510, REQ-3515, CON-3506"))

;; ── Phase B — Storage layer ──────────────────────────────────────────────────

(given task-assets-storage-layer)
(meta task-assets-storage-layer
  (description "`src/assets/store.rs` effectful shell per SPEC-035 §7. (1) `init_storage_total(root) -> Result<u64>`: walks `.zetl/assets/`, sums file sizes (not sidecars). (2) `write_asset(root, slug, body: impl AsyncRead, mime, user_id, original_filename) -> Result<AssetMeta>`: streams to `.zetl/assets/.tmp/{uuid}` computing SHA-256, enforces per-file limit (stream abort), renames to final path, writes sidecar. Atomic: tmp removed on any error. (3) `delete_asset(root, slug) -> Result<()>`: removes asset + sidecar atomically, NotFound if absent. (4) `list_assets(root, prefix: Option<&str>) -> Result<Vec<AssetMeta>>`: walks `.zetl/assets/`, reads `.meta.json` sidecars, filters + sorts. (5) `serve_asset(root, path) -> Result<(AssetMeta, File)>`: reads sidecar, verifies canonical path within assets root, opens file. `StorageCounterGuard`: wraps `Arc<AtomicU64>` with `increment(n)`/`decrement(n)`/`total()`.")
  (acceptance "`src/assets/store.rs` unit and integration tested. TEST-3502 (on-disk + sidecar), TEST-3511 (atomic write + SHA-256), TEST-3525 (partial upload cleanup — simulate mid-stream error), TEST-3526 (concurrent uploads both succeed; concurrent overwrites produce one file). NFR-3504 verified. `cargo test assets::store` green.")
  (priority "P0")
  (spec-ref "SPEC-035 REQ-3502, REQ-3508, REQ-3511, NFR-3503, NFR-3504, NFR-3505, CON-3506"))

;; ── Phase C — ACL integration ────────────────────────────────────────────────

(given task-assets-acl)
(meta task-assets-acl
  (description "Extend `src/acl.rs` with two new predicate evaluation paths per SPEC-035 CON-3505. (1) `check_can_upload(vault_root, user_id) -> Result<bool>`: evaluates `(can-upload USER)` using existing SPL pipeline; injects built-in default rules for `r-editor-upload`, `s-owner-upload`, `r-admin-upload`. (2) `check_can_read_assets(vault_root, user_id: Option<&str>, visibility_mode) -> Result<bool>`: evaluates `(can-read-assets USER \"*\")` or `(can-read-assets anonymous \"*\")`; injects built-in defaults. Open Question 1 resolved: add `(except d-agent-no-upload (is-agent) (not (can-upload USER)))` to built-in defaults — agents cannot upload unless explicitly granted. SPL injection guards: same escaping as existing predicates.")
  (acceptance "Two new functions in `src/acl.rs`. TEST-3504 (all 5 ACL cases) and TEST-3516 (unauthenticated access under transparent vs mixed) pass as integration tests in `tests/assets_acl_integration.rs`. Built-in rules as inline string constants. Clippy clean.")
  (priority "P0")
  (spec-ref "SPEC-035 REQ-3504, REQ-3516, CON-3505"))

;; ── Phase D — HTTP route handlers ───────────────────────────────────────────

(given task-assets-http-routes)
(meta task-assets-http-routes
  (description "Four route handlers in `src/web/routes.rs` + router wiring in `src/web/mod.rs`. (1) `POST /api/assets/{*slug}` → `upload_asset_handler`: Content-Type header (400 if absent), validate slug (400), MIME allowlist (415), Content-Length vs per-file limit (413), `check_can_upload` (403), collab mode (404 if off), overwrite semantics headers (400/404/409 per CON-3501), storage total (507), `store::write_asset`, git commit, StorageCounterGuard.increment, log OBS-3501, return 201/200 JSON. (2) `GET /assets/{*path}` → `serve_asset_handler`: `check_can_read_assets` (401/403), `store::serve_asset`, headers per REQ-3514+REQ-3515, stream. (3) `GET /api/assets` → `list_assets_handler`: `check_can_upload`, `store::list_assets`, JSON array. (4) `DELETE /api/assets/{*slug}` → `delete_asset_handler`: CSRF check, validate slug, `check_can_upload`, `store::delete_asset`, git commit, StorageCounterGuard.decrement, 204. WebState gains `asset_storage: StorageCounterGuard`, `asset_max_file_bytes: u64`, `asset_max_total_bytes: u64`. CLI gains `--asset-max-file-bytes` and `--asset-max-total-bytes`.")
  (acceptance "All four handlers implemented. TEST-3501, TEST-3503, TEST-3505, TEST-3506, TEST-3507, TEST-3508, TEST-3509, TEST-3512, TEST-3513, TEST-3514, TEST-3515, TEST-3517 pass in `tests/assets_http_integration.rs`. `zetl serve --collab` starts cleanly. Manual: upload PNG → appears at `/assets/slug` → list shows it → delete → 404.")
  (priority "P0")
  (spec-ref "SPEC-035 REQ-3501 through REQ-3519, CON-3501, CON-3502, CON-3503, CON-3504"))

;; ── Phase E — Git integration ────────────────────────────────────────────────

(given task-assets-git)
(meta task-assets-git
  (description "Git auto-commit for asset upload/replace/delete per SPEC-035 REQ-3513. Reuse `git_commit_lock` pattern from page-save path. Message format: `asset: upload {slug} ({size_human}) [user: {user_id}]` (new), `asset: replace {slug} ({size_human}) [user: {user_id}]` (overwrite), `asset: delete {slug} [user: {user_id}]`. Commit includes asset file + sidecar for upload/replace, neither for delete. If no git repo: silent skip (consistent with page-save). Git failures logged but do not fail the HTTP response.")
  (acceptance "TEST-3513: after upload in git-initialised vault, `git log --oneline -1` contains expected message with slug and user_id. After delete, delete commit appears. Git errors logged, HTTP 201 still returned.")
  (priority "P1")
  (spec-ref "SPEC-035 REQ-3513"))

;; ── Phase F — Admin UI ───────────────────────────────────────────────────────

(given task-assets-admin-ui)
(meta task-assets-admin-ui
  (description "Minimal asset management panel at `GET /_admin/assets` per SPEC-035 REQ-3518. Access gate: `check_can_upload`. Template `templates/admin_assets.html` extending base layout. (1) Asset table: slug, MIME type, size, uploader username, upload date, Delete button (fetch DELETE with X-CSRF-Token). (2) Upload form: file picker, slug text field pre-populated from `filename.toLowerCase()` (editable), Upload button. Submits via fetch to `POST /api/assets/{slug}`; inline error display (409/413/415/507). (3) Storage summary: `{used} / {max}` human-readable. Vanilla JS consistent with existing admin pages. WCAG 2.2 AA: labels on all inputs, keyboard-accessible delete buttons, aria-live region for upload status.")
  (acceptance "TEST-3518: upload via form → 201 → asset in table. Delete via button → 204 → row removed. Invalid upload → inline error. Storage summary correct. Keyboard nav: Tab through inputs. No critical A11y violations.")
  (priority "P1")
  (spec-ref "SPEC-035 REQ-3518"))

;; ── Phase G — Observability ──────────────────────────────────────────────────

(given task-assets-observability)
(meta task-assets-observability
  (description "Observability signals per SPEC-035 §10. Log lines on upload success (OBS-3501), upload failure (OBS-3502), delete (OBS-3503). Startup log: `[zetl] assets: storage_bytes={N} max_bytes={M} count={C}`. 90%-capacity warning emitted after each upload that pushes usage past 90% of configured max. In --verbose mode: GET /assets/{path} response includes X-Zetl-Asset-Sha256 header. NFR tests: TEST-3528 (upload throughput for 10 MiB ≤ 10s on loopback), TEST-3529 (serve latency P95 ≤ 50ms for 1 MiB).")
  (acceptance "All log lines present in integration test stderr. Startup log on `zetl serve --collab` with existing assets. 90% warning fires in test. TEST-3527 (counter accuracy under concurrent upload/delete), TEST-3528, TEST-3529 pass. Grep-based tests assert exact log format per §10.")
  (priority "P2")
  (spec-ref "SPEC-035 OBS-3501 through OBS-3505, NFR-3501, NFR-3502, NFR-3506"))

;; ── Phase H — Documentation ──────────────────────────────────────────────────

(given task-assets-documentation)
(meta task-assets-documentation
  (description "Documentation deliverables per SPEC-035 and USDD Phase 3. (1) `user-guide/concepts/Asset Uploads.md`: overview, getting started, how-to guides (upload an image, publish a static HTML report, delete an asset, manage storage limits), reference (MIME types, size limits, SPL predicates), troubleshooting (413, 415, 507, 409). (2) Update `user-guide/Index.md`. (3) `docs/asset-acl.md`: three working SPL examples (all editors upload, restrict to admins only, public unauthenticated reads) — each verified against SPL engine in `tests/assets_acl_integration.rs`. (4) Update `specs/SPEC-035.md` status from `draft` to `implemented`.")
  (acceptance "All four documentation files created/updated. SPL examples in `docs/asset-acl.md` verified by test. SPEC-035 status field is `implemented`. `user-guide/Index.md` links to new concept page.")
  (priority "P2")
  (spec-ref "SPEC-035 §1-§14, USDD Phase 3 Documentation"))

;; ── Phase I — Tier 1 security review ────────────────────────────────────────

(given task-assets-tier1-review-security)
(meta task-assets-tier1-review-security
  (description "Tier 1 cross-model adversarial review of security-critical implementation: path traversal defence (slug validation in `src/assets/validation.rs` + canonical-path check in `serve_asset_handler`), MIME enforcement, HTML isolation headers, SPL injection prevention in `check_can_upload`. Adversarial prompt: 'Assume a malicious authenticated editor. Identify every way they can: (a) write a file outside .zetl/assets/, (b) cause a file to be served with a MIME type different from declared, (c) exhaust server disk or memory, (d) steal another user's session via uploaded HTML.' Findings filed as BUG-###. All S1/S2 findings resolved before merge to main.")
  (acceptance "Review report produced. All S1/S2 findings addressed with regression tests. Review artifact committed to `.hence/reviews/assets-security-<date>.md`.")
  (priority "P0")
  (spec-ref "SPEC-035 §11, REQ-3510, REQ-3514, ADR-3504, ADR-3505"))

;; ── Readiness rules ─────────────────────────────────────────────────────────
;; Phase 0: spec review is ready immediately (it operates on the spec itself).

(normally r-ready-tier2-spec-review
  task-assets-tier2-review-spec
  ready-assets-tier2-review-spec)

;; Phase A: pure core can start once spec review is approved.

(normally r-ready-pure-core
  (and task-assets-pure-core completed-assets-tier2-review-spec)
  ready-assets-pure-core)

;; Phase B + C: storage layer and ACL depend on pure core only; can run in parallel.

(normally r-ready-storage-layer
  (and task-assets-storage-layer completed-assets-pure-core)
  ready-assets-storage-layer)

(normally r-ready-acl
  (and task-assets-acl completed-assets-pure-core)
  ready-assets-acl)

;; Phase D: HTTP routes require both storage layer and ACL.

(normally r-ready-http-routes
  (and task-assets-http-routes completed-assets-storage-layer completed-assets-acl)
  ready-assets-http-routes)

;; Phase E + F: git integration and admin UI can run in parallel after HTTP routes.

(normally r-ready-git
  (and task-assets-git completed-assets-http-routes)
  ready-assets-git)

(normally r-ready-admin-ui
  (and task-assets-admin-ui completed-assets-http-routes)
  ready-assets-admin-ui)

;; Phase G: observability after HTTP routes.

(normally r-ready-observability
  (and task-assets-observability completed-assets-http-routes)
  ready-assets-observability)

;; Phase H: documentation after observability + admin UI are complete.

(normally r-ready-documentation
  (and task-assets-documentation completed-assets-observability completed-assets-admin-ui)
  ready-assets-documentation)

;; Phase I: Tier 1 security review after HTTP routes land (reviews code, not docs).

(normally r-ready-tier1-security
  (and task-assets-tier1-review-security completed-assets-http-routes)
  ready-assets-tier1-review-security)

;; ── Assignment rules ─────────────────────────────────────────────────────────

(normally r-assign-tier2-spec-review
  (and ready-assets-tier2-review-spec agent-reviewer-spec-available)
  assign-to-assets-tier2-review-spec-reviewer-spec)

(normally r-assign-pure-core
  (and ready-assets-pure-core agent-coder-available)
  assign-to-assets-pure-core-coder)

(normally r-assign-storage-layer
  (and ready-assets-storage-layer agent-coder-available)
  assign-to-assets-storage-layer-coder)

(normally r-assign-acl
  (and ready-assets-acl agent-coder-available)
  assign-to-assets-acl-coder)

(normally r-assign-http-routes
  (and ready-assets-http-routes agent-coder-available)
  assign-to-assets-http-routes-coder)

(normally r-assign-git
  (and ready-assets-git agent-coder-available)
  assign-to-assets-git-coder)

(normally r-assign-admin-ui
  (and ready-assets-admin-ui agent-coder-available)
  assign-to-assets-admin-ui-coder)

(normally r-assign-observability
  (and ready-assets-observability agent-coder-available)
  assign-to-assets-observability-coder)

(normally r-assign-documentation
  (and ready-assets-documentation agent-docs-writer-available)
  assign-to-assets-documentation-docs-writer)

(normally r-assign-tier1-security
  (and ready-assets-tier1-review-security agent-reviewer-security-available)
  assign-to-assets-tier1-review-security-reviewer-security)

;; ── Rule metadata ────────────────────────────────────────────────────────────

(meta r-ready-tier2-spec-review
  (description "Spec-level review is first-in-queue: it operates on SPEC-035.md, not on code.")
  (justification "No prerequisites except the task declaration itself."))

(meta r-ready-pure-core
  (description "Pure core can only begin after the spec review approves SPEC-035.")
  (justification "Prevents implementation of a spec that may have S1 defects requiring structural redesign."))

(meta r-ready-http-routes
  (description "HTTP handlers require both validated storage layer and ACL before wiring them together.")
  (justification "Parallel development of storage (Phase B) and ACL (Phase C) before integration reduces wall-clock time."))

(meta r-ready-tier1-security
  (description "Tier 1 security review runs after HTTP routes are implemented so the reviewer can examine the actual code paths.")
  (justification "Static spec review (Tier 2, Phase 0) is not a substitute for reviewing the concrete implementation of path traversal guards and header injection."))
