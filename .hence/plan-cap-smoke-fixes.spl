; =============================================================================
; Plan — fixes for gaps surfaced by the IMPL-034 ar-crawl smoke test
; =============================================================================
;
; Two defects were observed while smoke-testing the capability-mode dist:
;
;   1. `cargo build --all-features` fails: `git_show` is
;      `#[cfg(not(feature = "history"))]` but unconditional callers exist at
;      src/main.rs:13018 / 13024 (in `load_vault_at_refs`). Under --all-features
;      both branches compile → symbol-missing error.
;
;   2. CSP `require-trusted-types-for 'script'; trusted-types 'none';` silently
;      blocks the shim's `host.innerHTML = sanitisedHtml` write (render.ts:62
;      + errors.ts:61 `body.innerHTML = ""`). The shim renders nothing and
;      emits no user-visible error. Either the shim needs a Trusted Types
;      policy or CAP_CSP must drop the strict TT directives.

(meta plan
  (id "smoke-034-fixes")
  (title "IMPL-034 smoke-test defects")
  (status "active")
  (created "2026-04-21")
  (author "agent:hugo")
  (description "Fix two defects surfaced by examples/cap_smoke.rs + ar-crawl: broken --all-features build, and strict CSP vs innerHTML render in the capability shim."))

; --- AGENTS ---
(given agent-coder-available)

; --- TASKS ---
(given task-build-git-show)
(given task-shim-trusted-types)
(given task-verify)

; --- TASK METADATA ---
(meta task-build-git-show
  (description "Make src/cap/audit_diff's `load_vault_at_refs` callers compile under every feature combination. `git_show` is cfg-gated to `not(feature=\"history\")`; either provide a `#[cfg(feature=\"history\")]` sibling (using jj-lib or the existing git2 dep) or hoist the callers behind the same cfg. `cargo build --all-features` must succeed. Keep `ztl cap audit-diff` functional under both cfgs.")
  (acceptance "`cargo build --all-features` finishes cleanly. `cargo check --features history` / `--no-default-features` also pass. No new warnings at the callsites. Existing `cap_audit_diff_integration` tests still pass."))

(meta task-shim-trusted-types
  (description "Reconcile CAP_CSP (`require-trusted-types-for 'script'; trusted-types 'none';` at src/cap/deploy_headers.rs:94) with the shim's `innerHTML` writes in src/cap/shim/render.ts:62 and src/cap/shim/errors.ts:61. Pick one of: (a) register a named Trusted Types policy from the shim (`trustedTypes.createPolicy('ztl-cap', {createHTML: s => s})` after sanitisation) and allow it in CAP_CSP (`trusted-types ztl-cap;`), or (b) drop the `require-trusted-types-for` / `trusted-types` directives from CAP_CSP and document the trade-off. SPEC-034 REQ-3421 / CON-3410 govern CSP; any change here updates the CSP snapshot tests in src/cap/deploy_headers.rs + src/cap/html_shell.rs.")
  (acceptance "Default `ztl build --capability` + the serve-locally smoke test renders plaintext into `<main data-ztl-capability>` in a headless Chrome (Playwright) without the local server having to strip the CSP meta tag. All deploy-recipe byte-pin tests updated + green. Spec + operator guide (docs/capability-mode.md §3.4 CSP) reflect the decision."))

(meta task-verify
  (description "Re-run the smoke test end-to-end: fresh `cargo run --example cap_smoke`, launch `python3 /tmp/cap-smoke/serve.py` WITHOUT the CSP-strip workaround, drive `ar-crawl session` through the invite URL, assert `main.innerHTML` contains the original plaintext and the fragment was scrubbed.")
  (acceptance "ar-crawl session logs show `main.innerHTML == <h1>Welcome</h1><p>…</p>` and `location.href` has no `#k=` after wait. `cargo build --all-features` in the same session succeeds."))

; --- DEPENDENCIES ---
; build-fix has no deps — it's a straight compile fix.
(given no-deps-build-git-show)

; --- READINESS RULES ---
(normally r-ready-build-git-show
  (and task-build-git-show no-deps-build-git-show)
  ready-build-git-show)

; Shim/CSP fix is independent of the build fix — can run in parallel, but
; we prefer to land the build fix first so the CI checks the shim fix
; under --all-features.
(normally r-ready-shim-trusted-types
  (and task-shim-trusted-types completed-build-git-show)
  ready-shim-trusted-types)

; Verification runs after both fixes.
(normally r-ready-verify
  (and task-verify completed-build-git-show completed-shim-trusted-types)
  ready-verify)

; --- ASSIGNMENT RULES ---
(normally r-assign-build-git-show
  (and ready-build-git-show agent-coder-available)
  assign-to-build-git-show-coder)

(normally r-assign-shim-trusted-types
  (and ready-shim-trusted-types agent-coder-available)
  assign-to-shim-trusted-types-coder)

(normally r-assign-verify
  (and ready-verify agent-coder-available)
  assign-to-verify-coder)

; --- RULE METADATA ---
(meta r-ready-shim-trusted-types
  (description "Shim/CSP fix waits on the build fix so CI can verify the shim change compiles under --all-features.")
  (justification "Build-fix is a precondition for any meaningful full-feature CI run; avoids a merge window with a red main."))

