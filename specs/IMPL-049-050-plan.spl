;; IMPL-049-050 — Implementation plan for SPEC-049 (Content-Author Components & Directives)
;; and SPEC-050 (Component Islands & Inter-Island Messaging), built on the shipped SPEC-048 core.
;; Dependency-ordered task DAG. Single implementer agent (claude). Implemented regardless of the
;; specs' non-converged strawman status, per explicit operator directive.

(meta plan
  (id "IMPL-049-050")
  (title "Content-Author Components (SPEC-049) + Component Islands (SPEC-050) — implementation")
  (version "1.0.0")
  (status "active")
  (created "2026-06-25")
  (author "agent:claude")
  (spec "SPEC-049,SPEC-050")
  (description "Implement SPEC-049 content directives (directive grammar, default-deny content-invocable allowlist, untrusted prop recognition, isolated body sanitiser, CON-4904 static HTML-context lint over minijinja unstable_machinery, transform-stage expansion, restricted content context) and SPEC-050 component islands (manifest island fields + topic/type grammars, static wiring verification, CSP computation/emission, deterministic island asset emission, the window.zetl bus runtime, capability bridge + controlled-element renderer, pre-paint script, hydration strategies). Built on the existing src/web/components/ module (SPEC-048), wired into engine.rs/build.rs/markdown.rs, behind content-components and component-islands feature gates with byte-identical backward-compatible defaults."))

;; ---- Agents ----
(given agent-claude-available)

;; ---- Tasks ----
(given task-deps)            ; F0: Cargo.toml deps + feature gates (minijinja exact pin + unstable_machinery)
(given task-49-manifest)     ; CON-4903: content_invocable, content_props, url ptype, reserved-key tolerance
(given task-49-directive)    ; REQ-4901 / CON-4901: directive grammar (container/leaf/inline)
(given task-49-sanitize)     ; REQ-4905 / CON-4902: isolated body sanitiser (ammonia, fixed-point)
(given task-49-props)        ; REQ-4904: untrusted prop recognition + url ingestion validation + taint
(given task-49-lint)         ; CON-4904 / NFR-4903: sound static HTML-context lint over unstable_machinery AST
(given task-49-expand)       ; REQ-4906/4907/4908: transform-stage expansion, restricted context, bounds
(given task-49-wire)         ; REQ-4911/4912: markdown/build/engine wiring, diagnostics, backward-compat gate
(given task-49-tests)        ; TEST-49xx integration tests
(given task-50-manifest)     ; CON-5001/5002/5005: island manifest fields, topic grammar, type language
(given task-50-theme)        ; theme island-grants + [security.csp] parsing (CON-5002, REQ-5027 declaration)
(given task-50-wiring)       ; REQ-5008/5009: static wiring verification graph + audit
(given task-50-csp)          ; REQ-5027: CSP computation/emission (meta tag + headers artifact)
(given task-50-emit)         ; REQ-5001/5024: island asset emission, dedup, deterministic, hydration markers
(given task-50-runtime-js)   ; REQ-5004/5005/5007/5019/5030: window.zetl bus runtime JS
(given task-50-bridge-js)    ; REQ-5016/5025/5029, CON-5006/5007: capability bridge + controlled-element renderer
(given task-50-prepaint)     ; REQ-5006/5018: persisted pre-paint script + sha256 CSP hash
(given task-50-wire)         ; REQ-5012/5023: build/engine wiring, backward-compat gate
(given task-50-tests)        ; TEST-50xx integration tests
(given task-verify)          ; final: full build + test + clippy + determinism check

;; ---- Task metadata ----
(meta task-deps
  (description "Cargo.toml: pin minijinja to exact =2.16.0 and add unstable_machinery feature (NFR-4903); confirm ammonia (CON-4902) and a sha256 impl available; add cargo features content-components and component-islands (default-on for build, gate the new behaviour).")
  (acceptance "cargo build succeeds; minijinja::machinery is importable; features resolve."))
(meta task-49-manifest
  (description "Extend src/web/components/manifest.rs: add PropType::Url; add Manifest fields content_invocable:bool and content_props:Vec<String>; reserve-and-ignore these keys (+ publishes/subscribes/island.* for SPEC-050) under gate-off instead of rejecting (CON-4903 forward-compat); validate content_props name declared props and are scalar/url; content-invocable-unfulfillable check.")
  (acceptance "Unit tests: content_invocable/content_props parse; url ptype; reserved keys tolerated; content_props naming undeclared prop -> content-manifest-unknown-ref."))
(meta task-49-directive
  (description "New src/web/components/directive.rs: recognise container ':::name{attrs}…:::', leaf '::name{attrs}', inline ':name[label]{attrs}' (CON-4901); attr grammar (#id/.class/key=value/key=\"quoted\"/flag); kebab name; single-line quoted; reject < > in bare; malformed -> content-directive-malformed inert. Code-fence/code-span exclusion when integrated.")
  (acceptance "Unit tests: each form parses to Directive{form,name,attrs,body,pos}; malformed cases fail closed."))
(meta task-49-sanitize
  (description "New src/web/components/sanitize.rs: isolated body sanitiser (CON-4902) using ammonia — closed default-deny allowlist (elements/attrs/URL schemes), strip script/style/iframe/on*/comments/PIs, scheme allowlist after canonicalisation (reject //host, javascript:, data:, blob:, vbscript:, file:), srcset sub-grammar; serialise->reparse fixed-point stable; drop counts for OBS-4901; missing policy -> sanitiser-policy-missing.")
  (acceptance "Unit tests: vector matrix (script/onerror/javascript:/iframe/style/data:/comment/srcset) each dropped; fixed-point byte-identical; allowlisted prose preserved."))
(meta task-49-props
  (description "REQ-4904 in validate.rs/new module: recognise directive attrs against [props] strictly (unknown/type/missing/enum -> content-prop-*; list/map -> content-prop-unsupported); url ptype ingestion validation (scheme canonicalise+allowlist); represent content-settable values as tainted; |safe of tainted -> content-unsafe-emit.")
  (acceptance "Unit tests: scalar/enum/url recognition; bad url rejected at ingestion; list/map rejected; taint flagged."))
(meta task-49-lint
  (description "New src/web/components/context_lint.rs: CON-4904 sound static HTML-context lint over minijinja::machinery AST. (0) enforce Html-autoescape over taint, forbid whitespace-trim, exhaustive no-_ match + pinned features; (1) HTML/CSS/JS tokeniser state machine over EmitRaw/EmitExpr; closed URL_ATTR set shared with sanitiser; (2) per-value-kind safe-context sets (scalar->TEXT/ATTR_VALUE_DQ; url->+URL_ATTR; slot->TEXT only); (3) control-flow join fixpoint; (4) interprocedural taint across call/extends/block/import/filter/with/set/caller; (5) closed node-shape allowlist; fail-closed errors content-context-unsafe/-indeterminate/-unsafe-emit/-template-unanalyzable.")
  (acceptance "Unit tests: context matrix each a build error; safe placements pass; transitive taint caught; |safe -> content-unsafe-emit; unanalyzable -> fail-closed."))
(meta task-49-expand
  (description "REQ-4906/4907/4908: transform-stage expansion of Directive nodes -> SPEC-048 component invocation. Bottom-up innermost-first with per-provenance sanitisation barrier (each level's own untrusted body sanitised once; nested composed fragments trusted, not re-sanitised). Restricted deny-by-default content context (props + sanitised slot + draft-filtered safe site helpers; NO transclude, NO page-tier). Bounded depth (content-directive-too-deep) + cycle reuse of nesting.rs (content-directive-cycle).")
  (acceptance "Unit/integration: directive expands to component HTML; nested directives' trusted output preserved; transclude absent; depth/cycle fail closed."))
(meta task-49-wire
  (description "REQ-4911/4912: wire directive recognition into markdown.rs pipeline (code-fence aware) and expansion into build/engine render path; HookDiagnostic at author source location, inert text on failure; content-components gate: gate-off -> ':::' literal, byte-identical output; default-deny means no directive resolves without content_invocable.")
  (acceptance "Integration: end-to-end vault with content-invocable callout renders; gate-off byte-identical; diagnostics surfaced."))
(meta task-49-tests
  (description "tests/content_directives_integration.rs: TEST-4901..4912 — recognition, resolution, default-deny, prop recognition+lint matrix, isolated body sanitisation, transform order, restricted context, bounds, island handoff stub, diagnostics, backward-compat.")
  (acceptance "All TEST-49xx pass."))
(meta task-50-manifest
  (description "New src/web/islands/ (manifest.rs, topic.rs, value_type.rs): parse publishes/subscribes/[island.topics].<t>={type,persisted,default}/render/sandbox/paints/hydrate/[island.requests] (CON-5002); topic grammar DFA content: vs trusted: (CON-5001); type-expr language string|bool|int|number|enum(..)|{flat record} (CON-5005) with one shared recogniser; activate the SPEC-048-reserved publishes/subscribes keys.")
  (acceptance "Unit tests: manifest island fields parse+validate; topic grammar accept/reject; type-expr parse+value recognition; error codes island-topic-malformed/-render-invalid/-persisted-no-default/-content-value-type."))
(meta task-50-theme
  (description "Parse [[theme.island-grants]] (component/topic/direction=subscribe) from theme.toml and [security.csp] tables (connect-src/img-src/... host lists, reject '*') from site config + theme; build per-component grant table; content island subscribing trusted topic requires matching grant (island-capability-ungranted).")
  (acceptance "Unit tests: grants parsed; csp tables parsed; wildcard rejected; ungranted trusted-topic subscribe flagged."))
(meta task-50-wiring
  (description "REQ-5008/5009: build the island wiring graph across components — publishes/subscribes edges, unpublished subscriber -> island-topic-unpublished (warning), incompatible co-publisher types -> island-topic-type-conflict (error); emit audit graph (extends OBS-4801) including resolved edges, render mode, paints, [island.requests] approved/unapproved vs [security.csp].")
  (acceptance "Unit/integration: wiring graph correct; unpublished/type-conflict detected; audit graph emitted deterministically."))
(meta task-50-csp
  (description "REQ-5027: per-page effective CSP = default-deny baseline UNION declared widenings (fail-closed); baseline for content-island pages (default-src 'none'; script-src 'self' + sha256 hashes; worker-src 'self' blob:; connect-src 'none'; img/media/font/style-src 'self'; base-uri 'none'; form-action 'none'); reject '*' (csp-wildcard); emit <meta http-equiv> as first <head> child + csp-headers deploy artifact byte-identically; mandatory for content-island pages.")
  (acceptance "Unit tests: baseline computed; widenings unioned; wildcard rejected; meta+headers byte-identical; missing on content-island page -> build error."))
(meta task-50-emit
  (description "REQ-5001/5024: emit <name>.js island assets once per type per page (dedup, deterministic order by name then layer, reuse SPEC-048 emission); hydration markers on data-z nodes carrying island id + hydrate strategy (load/idle/visible[(margin)]/media(query); unrecognised -> island-hydrate-invalid); props serialised inline as JSON for hydration; only pages with >=1 island load island assets.")
  (acceptance "Unit/integration: island JS emitted once; markers correct; hydrate strategy parsed; no-island page emits nothing."))
(meta task-50-runtime-js
  (description "REQ-5004/5005/5007/5019/5030: src/web/assets/islands.js — window.zetl.store(topic){get,set,subscribe} retained last-value-wins replay-on-subscribe with coalesce + per-subscriber try/catch; window.zetl.bus{emit,on}; monotonic per-session seq; bounds (256 topics/1024 subs/64KiB value); deep-freeze window.zetl before islands run; single instance surviving SPA nav; localStorage/storage reflection for persisted topics.")
  (acceptance "JS unit tests (node/deno harness or rust-embedded check): store replay, coalesce, bounds, freeze, seq monotonic."))
(meta task-50-bridge-js
  (description "REQ-5016/5025/5029, CON-5006/5007: capability bridge reference monitor (per-island grant table; validate every inbound msg: known handle + (topic,direction) granted + payload type-recognised; denied+reason); default Web Worker transport (Map<Worker,Grant>); controlled-element renderer painting declarative tree via setAttribute/textContent with closed ELEM/ATTR allowlist + URL scheme validation + egress-taint rule + depth/breadth/node/byte bounds + cycle rejection (denied:render); keyed reconciler; lifecycle teardown (terminate worker, revoke grant, release subs) on SPA nav.")
  (acceptance "JS unit tests: ungranted denied; non-allowlisted tag/attr/url dropped; bounds enforced; reconcile preserves focus/keyed nodes; teardown revokes."))
(meta task-50-prepaint
  (description "REQ-5006/5018: build-time-generated static pre-paint snippet per persisted topic — embeds own minimal type recogniser, reads localStorage in try/catch, applies recognised value or declared default as DOM signal before paint; deterministic bytes; compute sha256 for CSP admission; emitted only when a persisted topic exists.")
  (acceptance "Unit tests: snippet deterministic; sha256 matches; default applied on bad/missing value; emitted iff persisted topic."))
(meta task-50-wire
  (description "REQ-5012/5023: wire island emission + CSP + pre-paint + bus bootstrap into build.rs/engine.rs render context; has-island and has-persisted-topic markers; component-islands gate; backward-compat: no island and no persisted topic -> byte-identical to SPEC-048 (no window.zetl, no bus, no island scripts, no pre-paint, no CSP meta).")
  (acceptance "Integration: island page emits bus+assets+CSP; persisted-only emits pre-paint only; neither -> byte-identical."))
(meta task-50-tests
  (description "tests/islands_integration.rs: TEST-50xx — emission/dedup/determinism, manifest+topic+type recognition, wiring verification, CSP computation/emission, pre-paint, backward-compat, and the content-island handoff from SPEC-049 (REQ-4910).")
  (acceptance "All TEST-50xx pass."))
(meta task-verify
  (description "Final verification: cargo build, cargo test (full suite incl. existing components_integration), cargo clippy, and a determinism re-run (build twice, diff output) for the new assets.")
  (acceptance "Green build, all tests pass, no new clippy errors, byte-identical re-build of new assets."))

