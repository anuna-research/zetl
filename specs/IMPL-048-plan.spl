;; IMPL-048 — Implementation plan for SPEC-048 (Template Components & Templated Static Pages, v0.2.1)
;; Dependency-ordered task DAG for the v1 core. Single implementer agent.

(meta plan
  (id "IMPL-048")
  (title "Template Components & Templated Static Pages — v1 core implementation")
  (version "1.0.0")
  (status "active")
  (created "2026-06-24")
  (author "agent:opus-impl")
  (spec "SPEC-048")
  (description "Implement the SPEC-048 v1 core in the zetl Rust codebase: new src/web/components/ module (manifest, validate, resolve, lower, nesting, tokens, css, transclude) wired into engine.rs and build.rs, plus integration tests."))

;; ---- Agents ----
(given agent-opus-impl-available)

;; ---- Tasks ----
(given task-manifest)      ; CON-4801 / REQ-4803
(given task-validate)      ; REQ-4814
(given task-resolve)       ; REQ-4804
(given task-lower)         ; REQ-4805 / ADR-4803 / CON-4802
(given task-nesting)       ; REQ-4807
(given task-tokens)        ; REQ-4812 / CON-4804
(given task-css-emit)      ; REQ-4809
(given task-site-ctx)      ; REQ-4801 / REQ-4802
(given task-transclude)    ; REQ-4818 / CON-4806 / ADR-4810
(given task-engine-wire)   ; engine.rs integration
(given task-build-wire)    ; REQ-4811 build integration + asset emission
(given task-backcompat)    ; REQ-4813
(given task-tests)         ; integration tests

;; Foundation tasks have no dependencies.
(given no-deps-manifest)
(given no-deps-lower)
(given no-deps-tokens)
(given no-deps-site-ctx)

;; ---- Task metadata ----
(meta task-manifest
  (description "src/web/components/manifest.rs: parse <name>.toml into Manifest{name,requires,slots,props}; strict TOML, reject unknown top-level keys (incl. reserved publishes/subscribes); prop schema type/required/default/enum; 64 KiB bound.")
  (acceptance "Unit tests: well-formed manifest parses; name/dir mismatch, non-kebab name, unknown key -> component-malformed."))
(meta task-validate
  (description "src/web/components/validate.rs: validate invocation kwargs against [props] schema; unknown/type/enum/missing-required errors; defaults fill omitted optionals.")
  (acceptance "Unit tests: valid props bind+defaults; each of unknown/type/enum/missing -> distinct error."))
(meta task-resolve
  (description "src/web/components/resolve.rs: three-tier whole-directory resolution vault/.zetl/components -> theme -> bundled default; unknown name -> component-not-found; record source layer for OBS-4801.")
  (acceptance "Unit tests: vault shadows theme whole-dir; unknown -> error; source layer reported."))
(meta task-lower
  (description "src/web/components/lower.rs: pre-parse source-lowering of {% component \"x\" k=v %}...{% slot \"s\" %}...{% endslot %}...{% endcomponent %} into native {% import %}+{% set _slot_s %}+{% call x(k=v, s=_slot_s) %}; recogniser per CON-4802; no custom minijinja tag.")
  (acceptance "Unit tests: default-slot lowering == caller(); named-slot via set capture; self-closing form; idempotent on no-component source."))
(meta task-nesting
  (description "src/web/components/nesting.rs: static cycle detection over component-invocation graph (Kahn) -> component-cycle naming path; render-time depth counter bound (<=16) -> component-depth-bound.")
  (acceptance "Unit tests: a->b->a cycle detected with path; depth-17 chain rejected."))
(meta task-tokens
  (description "src/web/components/tokens.rs: tokens.toml -> single _static/tokens.css under :root (+ [data-theme] blocks); key-by-key merge across layers; CSS-token-safe value recognition (Threat F) -> tokens-value-unsafe.")
  (acceptance "Unit tests: merge overrides one key; unsafe value (;/}/comment/markup) rejected; deterministic output."))
(meta task-css-emit
  (description "src/web/components/css.rs: collect component <name>.css used on a build, dedup (emit once), deterministic order (name then layer); stamp data-z marker contract; UNSCOPED in v1.")
  (acceptance "Unit tests: N uses -> one emission; stable byte order across two runs."))
(meta task-site-ctx
  (description "src/web/context.rs + engine.rs: add a site context object (name, nav, root_path, tokens ref, build mode) available to every render path incl. static pages; preserve vault/page; statically-known tier set per path kind.")
  (acceptance "Unit/integration: site present on page+folder+static paths; page-tier absent on static path."))
(meta task-transclude
  (description "src/web/components/transclude.rs + engine fn: transclude(target) reusing parse_wikilink_inner + render fragment; closed metadata allow-list (title+publishable frontmatter only); visibility gate; unresolved -> transclude-target-unresolved + dead-link; bounded by nesting.")
  (acceptance "Unit/integration: section transclude renders == embed; backlinks/edges unreachable; draft/missing -> error."))
(meta task-engine-wire
  (description "engine.rs: register resolved components as minijinja macros, run lower pass inside the loader, expose transclude() function + site context; thread strict-undefined + diagnostics.")
  (acceptance "Integration: {% component %} renders end-to-end through TemplateEngine with data-z marker; undeclared tier read -> strict-undefined."))
(meta task-build-wire
  (description "build.rs: render *.html.jinja static files with site-only context (REQ-4811, foo.html.jinja->foo/index.html); emit tokens.css + component CSS into _static/; verbatim copy unchanged for plain files.")
  (acceptance "Integration: about.html.jinja -> about/index.html sharing nav+tokens; plain .html copied verbatim; static page reading page ctx -> error."))
(meta task-backcompat
  (description "Ensure REQ-4813: vault with no components/tokens/.html.jinja builds byte-identically; all paths opt-in only.")
  (acceptance "Integration: no-opt-in build == pre-SPEC-048 golden; no tokens.css emitted absent tokens.toml."))
(meta task-tests
  (description "tests/components_integration.rs: end-to-end fixtures for HP2/HP3/HP4/HP5/HP6 + negative cases; wire into cargo test.")
  (acceptance "All TEST-48xx positive/negative-input/negative-output cases pass; cargo test green."))

;; ---- Readiness rules ----
(normally r-ready-manifest    (and task-manifest no-deps-manifest)            ready-manifest)
(normally r-ready-lower       (and task-lower no-deps-lower)                  ready-lower)
