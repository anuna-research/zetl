(normally r-ready-build-wire
  (and task-build-wire completed-engine-wire completed-tokens completed-css-emit)
  ready-build-wire)
(normally r-ready-backcompat  (and task-backcompat completed-build-wire)     ready-backcompat)
(normally r-ready-tests       (and task-tests completed-build-wire completed-backcompat) ready-tests)

