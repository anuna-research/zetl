(normally r-ready-resolve     (and task-resolve completed-manifest)          ready-resolve)
(normally r-ready-css-emit    (and task-css-emit completed-resolve)          ready-css-emit)
(normally r-ready-nesting     (and task-nesting completed-resolve completed-lower) ready-nesting)
(normally r-ready-transclude  (and task-transclude completed-site-ctx)       ready-transclude)
(normally r-ready-engine-wire
