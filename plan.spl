;; =============================================================================

(meta r-ready-scaffold (description "Scaffold has no dependencies"))
(meta r-ready-parser (description "Parser depends on scaffold for types"))
(meta r-ready-md-filter (description "Markdown filter depends on scaffold"))
(meta r-ready-resolver (description "Resolver depends on scaffold for types"))
(meta r-ready-validator (description "Validator depends on scaffold for types"))
(meta r-ready-file-scanner (description "File scanner composes parser, md-filter, and validator"))
(meta r-ready-graph-build (description "Graph build depends on scaffold for types"))
(meta r-ready-graph-queries (description "Queries depend on graph being built"))
(meta r-ready-simhash (description "SimHash is independent, only needs scaffold"))
(meta r-ready-cache (description "Cache is independent, only needs scaffold"))
(meta r-ready-cli-framework (description "CLI wires all components together"))
(meta r-ready-cli-commands (description "Commands depend on framework being in place"))
(meta r-ready-integration-tests (description "Tests run after all commands are implemented"))

