user-guide/site

# The comprehensive user-guide vault ships with a versioned `quickstart`
# theme, so whitelist its source through the global `.zetl/` ignore.
# Everything else under user-guide/.zetl/ stays ignored (index.json,
# search/, jj/, history/ are all cache and regenerate on first run).
!user-guide/.zetl/
user-guide/.zetl/*
!user-guide/.zetl/themes/
.env
# Local release artifacts (built by the release pipeline, not source).
dist-release/
