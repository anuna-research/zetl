{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zetl mobile",
  "version": "0.1.0-strawman",
  "identifier": "io.anuna.zetl.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:23423"
  },
  "app": {
    "windows": [
      {
        "title": "zetl mobile",
        "width": 420,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
