(normally r-a4 (and ready-verify agent-claude-available) assign-to-verify-claude)

(claims agent:claude
  :at "2026-06-30T09:36:02Z"
  (given claim-v1-fix-68-predicate-chips)
  (normally r-cl-state-v1-fix-68-predicate-chips claim-v1-fix-68-predicate-chips state-claimed-v1-fix-68-predicate-chips)
  (normally r-cl-chain-v1-fix-68-predicate-chips state-claimed-v1-fix-68-predicate-chips claimed-fix-68-predicate-chips)
)

