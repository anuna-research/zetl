;; Phase 2 — all ready immediately
(normally r-ready-cookie (and task-cookie-secure no-deps-cookie-secure) ready-cookie-secure)
(normally r-ready-ip-trust (and task-ip-trust no-deps-ip-trust) ready-ip-trust)
(normally r-ready-path-save (and task-path-traversal-save no-deps-path-traversal-save) ready-path-traversal-save)
(normally r-ready-nonce (and task-nonce-atomic no-deps-nonce-atomic) ready-nonce-atomic)
(normally r-ready-path-comments (and task-path-traversal-comments no-deps-path-traversal-comments) ready-path-traversal-comments)
(normally r-ready-flush-lock (and task-flush-lock-scope no-deps-flush-lock-scope) ready-flush-lock-scope)
(normally r-ready-wal-slug (and task-wal-slug-encoding no-deps-wal-slug-encoding) ready-wal-slug-encoding)
(normally r-ready-dedup-lifecycle (and task-dedup-lifecycle no-deps-dedup-lifecycle) ready-dedup-lifecycle)
(normally r-ready-slug-perf (and task-slug-lookup-perf no-deps-slug-lookup-perf) ready-slug-lookup-perf)

;; Phase 3 — all ready immediately
(normally r-ready-csrf-ct (and task-csrf-constant-time no-deps-csrf-constant-time) ready-csrf-constant-time)
(normally r-ready-dedup-cteq (and task-dedup-constant-time-eq no-deps-dedup-constant-time-eq) ready-dedup-constant-time-eq)
(normally r-ready-body-limit (and task-body-limit no-deps-body-limit) ready-body-limit)
(normally r-ready-session-purge (and task-session-purge no-deps-session-purge) ready-session-purge)
(normally r-ready-escape-spl (and task-escape-spl-scope no-deps-escape-spl-scope) ready-escape-spl-scope)

;; Phase 4 — depends on all critical + important fixes
(normally r-ready-verify
  (and task-verify-fixes
       completed-acl-save-handler completed-pending-writes-clear
       completed-flush-atomicity completed-eviction-pipeline completed-ws-csrf
       completed-cookie-secure completed-ip-trust completed-path-traversal-save
       completed-nonce-atomic completed-path-traversal-comments
       completed-flush-lock-scope completed-wal-slug-encoding
       completed-dedup-lifecycle completed-slug-lookup-perf
       completed-csrf-constant-time completed-dedup-constant-time-eq
       completed-body-limit completed-session-purge completed-escape-spl-scope)
  ready-verify-fixes)

;; ============================================================
;; Assignment Rules
;; ============================================================

(normally a-acl-save (and ready-acl-save-handler agent-claude-available) assign-to-acl-save-handler-claude)
(normally a-pending-writes (and ready-pending-writes-clear agent-claude-available) assign-to-pending-writes-clear-claude)
(normally a-flush-atom (and ready-flush-atomicity agent-claude-available) assign-to-flush-atomicity-claude)
