;; IMPL-026: Vault Scan Exclusions — Dotdir Defaults, .zetlignore, --exclude
;; Implements SPEC-026 v0.1.0

(meta plan
  (id "IMPL-026")
  (title "Vault Scan Exclusions — Dotdir Defaults, .zetlignore, --exclude")
  (version "0.1.0")
  (status "draft")
  (created "2026-04-15")
  (author "agent:claude")
  (spec "SPEC-026")
  (description "Close the dist/ leak of tool-state dotdirs (.claude, .obsidian, etc.). Skip dotdirs by default, add --exclude and --include-hidden CLI flags, align scanner/watcher, and audit all scan_vault(&[]) call sites."))

;; ── Agents ──────────────────────────────────────────────
(given agent-claude-available)

;; ── Tasks ───────────────────────────────────────────────

;; Phase 1: pure core + types
(given task-scan-options-type)
(given task-pure-resolver)

;; Phase 2: scanner integration
(given task-scanner-integration)
(given task-watcher-parity)

;; Phase 3: CLI plumbing
(given task-cli-flags)
(given task-callsite-audit)

;; Phase 4: tests + docs
(given task-integration-tests)
(given task-property-tests)
(given task-changelog-readme)

;; Phase 5: synthetic review
(given task-synthetic-user-run)
(given task-adversarial-review)

;; ── No-deps markers ────────────────────────────────────
(given no-deps-scan-options-type)

;; ── Task Metadata ──────────────────────────────────────

(meta task-scan-options-type
  (description "Add `ScanOptions { exclude_patterns: Vec<String>, include_hidden: bool }` in src/scanner.rs. Provide Default impl + From<&[String]> adapter for backward-compat of existing test call sites. No behaviour change yet — just the type.")
  (acceptance "cargo check passes; ScanOptions::default() returns include_hidden=false, empty patterns; existing scan_vault(&[]) still compiles via From adapter OR wrapper fn")
  (trace "CON-200"))

(meta task-pure-resolver
  (description "Implement pure `resolve_exclusion(path, opts, nested_vault_probe) -> Decision` function in src/scanner.rs (or new submodule scanner/exclude.rs). Implements precedence from REQ-205: (1) hardcoded force-ignores, (2) dotdir default, (3) gitignore, (4) .zetlignore, (5) --exclude. No std::fs imports in this function except via injected probe closure. Returns `Decision::Include` or `Decision::Exclude(Reason)`.")
  (acceptance "Unit tests cover all 5 precedence levels with table-driven cases; clippy::disallowed_methods denies std::fs in the module; TEST-205 passes as unit test")
  (trace "REQ-200 REQ-202 REQ-203 REQ-204 REQ-205 CON-200"))

(meta task-scanner-integration
  (description "Rewrite scan_vault() in src/scanner.rs to consume ScanOptions and call resolve_exclusion via a filter_entry callback on WalkBuilder. Remove .hidden(false) bypass when include_hidden=false. Preserve existing force-ignores for .git/, .zetl/, node_modules/, and nested-vault detection. Emit OBS-200 trace lines when verbose.")
  (acceptance "TEST-200, TEST-201, TEST-202, TEST-203, TEST-204 pass as integration tests in tests/scan_exclusions.rs; zetl build on a vault with .claude/ produces dist/ without .claude/")
  (trace "REQ-200 REQ-201 REQ-202 REQ-203 REQ-204 OBS-200"))

(meta task-watcher-parity
  (description "Update src/web/fs_watch.rs::classify_external_event to call the same resolve_exclusion function from task-pure-resolver. Remove the duplicate starts_with('.') check. Ensure the watcher loads ScanOptions from the same source as the scanner (CLI flags propagated into watch state).")
  (acceptance "TEST-206 property test passes: scanner and watcher produce identical include/exclude decisions on arbitrary vault + options inputs")
  (trace "REQ-206"))

(meta task-cli-flags
  (description "Add --exclude <PATTERN> (repeatable, via clap) and --include-hidden (bool) to `build`, `index`, `serve`, `search`, `watch` subcommands in src/cli.rs. Thread through to call sites in src/main.rs, src/web/mod.rs, src/web/build.rs, src/search.rs. Document in --help text.")
  (acceptance "CLI --help shows the flags on all five subcommands; TEST-203 and TEST-204 pass end-to-end via CLI invocation")
  (trace "REQ-203 REQ-204 CON-203"))

(meta task-callsite-audit
  (description "Audit all 12 scan_vault() call sites (src/main.rs:96, src/main.rs:2914, src/search.rs:135, src/cache.rs:1413, src/web/flush.rs:189, src/web/mod.rs:188, src/web/routes.rs:1092, src/web/routes.rs:5491, src/scanner.rs:2360 [test], src/scanner.rs:2380 [test]). For each, either propagate CLI-supplied ScanOptions or annotate with `// SCAN-OPTS: intentional <reason>`. Add CI lint script (shell or xtask) to fail on ungated scan_vault(_, &[]) or ScanOptions::default() uses outside #[cfg(test)].")
  (acceptance "TEST-207 CI lint passes; grep for raw scan_vault(_, &[]) in non-test code returns zero matches unless annotated")
  (trace "REQ-207"))

(meta task-integration-tests
  (description "Add tests/scan_exclusions.rs implementing TEST-200 through TEST-205 as tempdir-based integration tests against the scanner API. Use tempfile crate (already in dev-deps per Cargo.toml convention). Each test creates a synthetic vault layout and asserts on the returned ParsedFile page set.")
  (acceptance "cargo test --test scan_exclusions passes; each of TEST-200..205 is a named #[test] fn")
  (trace "TEST-200 TEST-201 TEST-202 TEST-203 TEST-204 TEST-205"))

(meta task-property-tests
  (description "Add proptest-based property test for TEST-206 (scanner/watcher parity): generate arbitrary vault layouts + ScanOptions, assert scan_vault result set == watcher-filtered event set. Shrinking must produce a minimal failing reproducer. If proptest is not already a dep, gate this behind a test feature and justify in the commit.")
  (acceptance "cargo test --features proptest-scan (or unconditional) runs >=100 cases and passes; intentional mutation (e.g., remove dotdir check from scanner) makes the test fail")
  (trace "REQ-206 TEST-206"))

(meta task-changelog-readme
  (description "Add CHANGELOG.md entry under the next minor version: describe the breaking change (dotdirs now skipped), migration path (use --include-hidden or `.zetlignore` with negated pattern), and call out .zetl/ was always force-ignored. Add a 'Vault scanning and ignore files' section to README.md explaining precedence (REQ-205) with a concrete example.")
  (acceptance "TEST-208 doc lint passes; CHANGELOG contains 'dotdir'; README has the new section; reviewer confirms migration instructions are unambiguous")
  (trace "REQ-208 TEST-208"))

(meta task-synthetic-user-run
  (description "Run SPEC-026 §3 happy paths as a synthetic-user simulation (per USDD Protocol §Synthetic User Protocol). Use agent profiles from §2. Log findings categorised as Gap/Ambiguity/Friction/etc. Each finding proposes a REQ amendment.")
  (acceptance "Report written to research/SPEC-026-synthetic-user.md with at least one finding or explicit 'no findings' after running all 3 happy paths")
  (trace "SPEC-026 §3"))

(meta task-adversarial-review
  (description "Per Constitutional Principle #12 (Adversarial Review): a fresh-context reviewer (different session, optionally cross-model per USDD §AI Trust Boundaries Tier 3) reviews the implementation against SPEC-026 with an explicit mandate to find defects. Focus: REQ-205 precedence edge cases, dotfile-vs-dotdir boundary (REQ-201), and the watcher-parity property test's generator coverage.")
  (acceptance "Review report in research/SPEC-026-adversarial-review.md; all raised defects either fixed or documented as accepted risks with justification")
  (trace "Constitution §12"))

