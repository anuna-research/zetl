;; IMPL-026: AST-Aware Graph Compression
;; Implements SPEC-026 — token-efficient vault export for LLM consumption

(meta plan
  (id "IMPL-026")
  (title "AST-Aware Graph Compression")
  (version "1.0.0")
  (status "active")
  (created "2026-04-07")
  (author "agent:claude")
  (spec "SPEC-026")
  (description "Implement compress module: AST-walking compressor, paragraph compression, CLI --compact flag, MCP zetl_compress tool"))

;; ── Agents ──────────────────────────────────────────────────────
(given agent-claude-available)

;; ── Tasks ───────────────────────────────────────────────────────

;; Phase 1: Pure core (no I/O)
(given task-compress-core)
(given task-paragraph)
(given task-frontmatter)
(given task-graph-summary)
(given task-token-estimate)

;; Phase 2: Integration (I/O shell)
(given task-cli)
(given task-json-envelope)
(given task-mcp)

;; Phase 3: Tests
(given task-unit-tests)
(given task-integration-tests)

;; ── Task metadata ───────────────────────────────────────────────

(meta task-compress-core
  (description "Create src/compress.rs with compress_page() that walks pulldown-cmark Event stream. Handle headings, wikilinks, lists, code blocks, block quotes, tables, images, HTML stripping, task list markers, soft/hard breaks per SPEC-026 §3.1")
  (acceptance "compress_page() produces correct output for all AST node types in §3.1 table; wikilinks emit → target; dead links emit → ✗ target; headings preserved verbatim; code blocks emit ⌜lang: first_line⌝; lists flatten to bullet; HTML stripped; images emit [img: alt]; breaks collapsed"))

(meta task-paragraph
  (description "Implement compress_paragraph() with tiered strategy per §3.2: preserve link-bearing sentences verbatim, preserve signal sentences (decision markers), reduce filler via stop-word removal")
  (acceptance "Link-bearing sentences preserved verbatim; signal words (decided, chose, because, instead of, trade-off) trigger preservation; filler sentences have stop words removed; deterministic output"))

(meta task-frontmatter
  (description "Parse YAML frontmatter and emit as @ key: value lines. Skip internal keys. Handle tags as comma-separated, aliases as comma-separated")
  (acceptance "Frontmatter emits @ tags:, @ aliases:, @ date: etc; array values comma-joined; internal keys omitted"))

(meta task-graph-summary
  (description "Implement build_graph_summary() per §3.3: header with page/edge counts, forward links with →, backlinks with ←, alphabetical ordering")
  (acceptance "Graph summary shows correct page and edge counts; forward links use →; backlinks use ←; pages sorted alphabetically"))

(meta task-token-estimate
  (description "Implement estimate_tokens() as whitespace-split word count proxy")
  (acceptance "Returns usize equal to whitespace-split word count of input string"))

(meta task-cli
  (description "Add --compact flag to zetl export command. Support <page>, --neighbours, --depth, --all, --format json|text. Wire to CompressedExport orchestrator that reads files, builds LinkGraph, calls pure core, writes stdout")
  (acceptance "zetl export --compact <page> outputs compressed single page; --neighbours includes 1-hop pages; --all compresses entire vault; multi-page output has === page === delimiters and graph summary; exit codes per CON-037"))

(meta task-json-envelope
  (description "Implement --format json output per CON-037: pages array with name, compressed, token_estimate, raw_token_estimate; graph field; total_token_estimate")
  (acceptance "JSON output parses correctly; all fields present; token_estimate < raw_token_estimate for non-trivial pages"))

(meta task-mcp
  (description "Add zetl_compress tool to MCP server per CON-038: page param (required), neighbours boolean, depth integer 1-3. Returns JSON envelope")
  (acceptance "tools/list includes zetl_compress with correct schema; tools/call returns valid JSON envelope matching CON-038"))

(meta task-unit-tests
  (description "Unit tests for compress_page, compress_paragraph, build_graph_summary, estimate_tokens covering TEST-144, TEST-147, TEST-148, TEST-149, TEST-150, TEST-151, TEST-152")
  (acceptance "All unit tests pass; covers node-type coverage, wikilink preservation, dead link marking, frontmatter, determinism, graph summary"))

(meta task-integration-tests
  (description "Integration tests for CLI and MCP: TEST-145 (neighbourhood), TEST-146 (full vault), TEST-153 (JSON envelope), TEST-154 (MCP tool)")
  (acceptance "All integration tests pass; CLI produces correct output; MCP tool returns valid responses"))

;; ── Dependencies (no-deps for root tasks) ───────────────────────

(given no-deps-compress-core)
(given no-deps-paragraph)
(given no-deps-token-estimate)

;; ── Readiness rules ─────────────────────────────────────────────

;; Phase 1: Independent pure core tasks
(normally r-ready-compress-core
  (and task-compress-core no-deps-compress-core)
  ready-compress-core)

(normally r-ready-paragraph
  (and task-paragraph no-deps-paragraph)
  ready-paragraph)

(normally r-ready-token-estimate
  (and task-token-estimate no-deps-token-estimate)
  ready-token-estimate)

;; Frontmatter depends on compress-core (needs the same module structure)
(normally r-ready-frontmatter
  (and task-frontmatter completed-compress-core)
  ready-frontmatter)

;; Graph summary depends on compress-core (shares output format)
(normally r-ready-graph-summary
  (and task-graph-summary completed-compress-core)
  ready-graph-summary)

;; Phase 2: CLI needs all pure core
(normally r-ready-cli
  (and task-cli completed-compress-core completed-paragraph completed-frontmatter completed-graph-summary completed-token-estimate)
  ready-cli)

;; JSON envelope builds on CLI
(normally r-ready-json-envelope
  (and task-json-envelope completed-cli)
  ready-json-envelope)

;; MCP needs CLI + JSON envelope (same orchestrator logic)
(normally r-ready-mcp
  (and task-mcp completed-cli completed-json-envelope)
  ready-mcp)

;; Phase 3: Tests
(normally r-ready-unit-tests
  (and task-unit-tests completed-compress-core completed-paragraph completed-frontmatter completed-graph-summary completed-token-estimate)
  ready-unit-tests)

(normally r-ready-integration-tests
  (and task-integration-tests completed-cli completed-json-envelope completed-mcp)
  ready-integration-tests)

;; ── Assignment rules ────────────────────────────────────────────

