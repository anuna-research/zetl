;; ── Meta ───────────────────────────────────────────────

(meta r-ready-scan-options-type
  (description "ScanOptions type has no deps — foundation for the rest.")
  (justification "Pure type change; no behaviour risk."))

(meta r-ready-pure-resolver
  (description "Pure resolver needs the ScanOptions type to exist.")
  (justification "Shell→core dependency rule; core cannot import types that don't exist."))

(meta r-ready-scanner-integration
  (description "Scanner uses the pure resolver via filter_entry.")
  (justification "Keeps behaviour change isolated after the pure core is unit-tested."))

(meta r-ready-watcher-parity
  (description "Watcher reuses the same pure resolver as the scanner.")
  (justification "REQ-206 parity is the whole point of the extraction."))

(meta r-ready-cli-flags
  (description "CLI flags can only be wired once the scanner consumes ScanOptions.")
  (justification "Avoids a window where flags exist but do nothing."))

(meta r-ready-callsite-audit
  (description "Audit runs after CLI plumbing exists, so the 'intentional' cases can be judged against real alternatives.")
  (justification "Prevents premature annotation of call sites that should propagate CLI options."))

(meta r-ready-synthetic-user-run
  (description "Synthetic user runs against a working implementation with docs in place.")
  (justification "Users will consult CHANGELOG/README during migration; simulation must reflect the shipping experience."))

(meta r-ready-adversarial-review
  (description "Adversarial review runs last, against the shipping artifact and synthetic-user findings.")
  (justification "Constitution §12: review function operates on the full deliverable, not partial state."))

