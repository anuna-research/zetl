;; ── threat model and tests (depend on mechanism ADRs) ───────────────────
(meta task-threat-model
  (description "Write research/SPEC-047-threat-model.md — full model behind section 12, including the Owner-offline rotation window (Q11), DHT observer analysis, per-member fleet visibility (threat P).")
  (acceptance "Document exists, every section-12 letter expanded with mitigation and residual, spec section 12 references it"))
(given task-threat-model)
(normally r-ready-threat-model (and task-threat-model completed-adr-rendezvous completed-adr-group-key) ready-threat-model)
(normally r-assign-threat-model (and ready-threat-model agent-claude-available) assign-threat-model-claude)

(meta task-test-strategy
  (description "Complete section 10 — per-REQ test-type omission justifications, mutation targets, fuzz corpus plan, adversarial test generation plan per PROTO-001.")
  (acceptance "Section 10 justification note resolved per REQ, adversarial test plan written"))
(given task-test-strategy)
(normally r-ready-test-strategy (and task-test-strategy completed-threat-model) ready-test-strategy)
(normally r-assign-test-strategy (and ready-test-strategy agent-claude-available) assign-test-strategy-claude)

;; ── Tier-1 gates ────────────────────────────────────────────────────────
(meta task-comprehension-gate
  (description "Fresh-context comprehension gate on the Orientation block per PROTO-001 — restate intent, predict behaviour on a concrete case, locate deciding artefacts. Record outcome in spec section 15.")
  (acceptance "Gate transcript recorded, pass or findings folded back into the Orientation block"))
(given task-comprehension-gate)
(given no-deps-comprehension-gate)
(normally r-ready-comprehension-gate (and task-comprehension-gate no-deps-comprehension-gate) ready-comprehension-gate)
(normally r-assign-comprehension-gate (and ready-comprehension-gate agent-claude-available) assign-comprehension-gate-claude)

(meta task-cross-model-review
  (description "Adversarial review of the full spec by a non-Anthropic model family (PROTO-001 Principle 12 cross-model gate — all passes to date are Claude-family).")
  (acceptance "Review findings from a non-Anthropic model recorded and dispositioned in the spec changelog"))
(given task-cross-model-review)
(normally r-ready-cross-model-review (and task-cross-model-review completed-threat-model) ready-cross-model-review)
(normally r-assign-cross-model-review (and ready-cross-model-review agent-hugo-available) assign-cross-model-review-hugo)

(meta task-crypto-review
  (description "Human domain-expert review of the crypto and auth-core package — Q1 rendezvous split, Q2 OOB compromise and SAS decision, Q7 SPAKE2-MLS-didcrdt composition, Q11 revocation composition. Owner HOC.")
  (acceptance "Signed review record for Q1 Q2 Q7 Q11 with accept or change verdicts, spec updated accordingly"))
(given task-crypto-review)
(normally r-ready-crypto-review (and task-crypto-review completed-adr-rendezvous completed-adr-group-key completed-threat-model) ready-crypto-review)
(normally r-assign-crypto-review (and ready-crypto-review agent-hugo-available) assign-crypto-review-hugo)

(meta task-spec-approval
  (description "Flip SPEC-047 to approved — remove strawman notice, resolve remaining Provisional markers, record gate outcomes in section 15, re-issue at 1.0.0.")
  (acceptance "Spec status approved at 1.0.0, all gates recorded discharged, zetl check clean of new dead links"))
(given task-spec-approval)
(normally r-ready-spec-approval
  (and task-spec-approval completed-crypto-review completed-cross-model-review completed-comprehension-gate completed-test-strategy)
  ready-spec-approval)
(normally r-assign-spec-approval (and ready-spec-approval agent-hugo-available) assign-spec-approval-hugo)

;; ── parallel implementation track (non-no-go) ───────────────────────────
(meta task-impl-047-plan
  (description "Author IMPL-047 for the non-no-go components — daemon lifecycle, Loro store and materialisation, guarded import, namespace manifest, Merkle reconciliation, CBCL control plane, CLI scaffolding with not-yet-implemented exits. Auth-core code explicitly excluded until crypto-review completes.")
  (acceptance "IMPL-047 document plus plans/IMPL-047.spl exist, validate strict clean, no auth-core tasks unblocked before crypto-review"))
(given task-impl-047-plan)
(given no-deps-impl-047-plan)
(normally r-ready-impl-047-plan (and task-impl-047-plan no-deps-impl-047-plan) ready-impl-047-plan)
(normally r-assign-impl-047-plan (and ready-impl-047-plan agent-claude-available) assign-impl-047-plan-claude)

