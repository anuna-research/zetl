(meta task-adr-group-key
  (description "Firm up ADR-482 (MLS) — ciphersuite, leaf-key HKDF derivation constants, epoch data key vs MLS exporter, multi-device-Owner commit authorisation rule (F67), lane element framing. Prepare the Q7 composition dossier.")
  (acceptance "ADR-482 Provisional markers removed, Q7 dossier written covering SPAKE2-MLS-didcrdt composition for the crypto review"))
(given task-adr-group-key)
(normally r-ready-adr-group-key (and task-adr-group-key completed-adr-identity) ready-adr-group-key)
