  (acceptance "ADR-471 Provisional marker removed, staging rule stated non-provisionally, provenance-token upgrade path recorded"))
(given task-adr-external-edits)
(given no-deps-adr-external-edits)
(normally r-ready-adr-external-edits (and task-adr-external-edits no-deps-adr-external-edits) ready-adr-external-edits)
(normally r-assign-adr-external-edits (and ready-adr-external-edits agent-claude-available) assign-adr-external-edits-claude)

(meta task-adr-namespace
  (description "Design the namespace manifest (Q12, F64) — DocId scheme, manifest CRDT shape vs Q3, case-folding policy, deterministic collision disambiguation.")
  (acceptance "REQ-504 Provisional markers removed, DocId scheme and collision rule specified with worked examples"))
(given task-adr-namespace)
(given no-deps-adr-namespace)
(normally r-ready-adr-namespace (and task-adr-namespace no-deps-adr-namespace) ready-adr-namespace)
(normally r-assign-adr-namespace (and ready-adr-namespace agent-claude-available) assign-adr-namespace-claude)

(meta task-adr-identity
  (description "Firm up ADR-481 (did:crdt member identity) — member-level revoke CLI form, did-crdt ADR-002 key-compromise recovery and ADR-003 Sybil analysis folded into the review package.")
  (acceptance "ADR-481 Provisional marker removed, revoke did CLI form specified, did-crdt review items enumerated for crypto-review"))
(given task-adr-identity)
(given no-deps-adr-identity)
