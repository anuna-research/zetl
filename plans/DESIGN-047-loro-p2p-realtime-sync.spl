;; DESIGN-047 — refine SPEC-047-loro-p2p-realtime-sync from strawman to approved.
;; Middle path (0.18.0): non-no-go implementation may start in parallel (IMPL-047),
;; auth-core/crypto implementation stays gated on crypto-review + spec-approval.
;; Source spec: specs/SPEC-047-loro-p2p-realtime-sync.md (0.18.0-strawman).

(meta plan
  (title "DESIGN-047 Loro P2P Realtime Sync — spec refinement to approval")
  (description "Resolve every Provisional marker in SPEC-047, run the Tier-1 gates (comprehension, cross-model, human crypto review), and approve the spec. Non-no-go implementation proceeds in parallel under IMPL-047."))

;; ── agents ──────────────────────────────────────────────────────────────
(given agent-claude-available)
(given agent-hugo-available)

;; ── Phase 0/1 — profiles and paths ──────────────────────────────────────
(meta task-user-profiles
  (description "Author canonical /users/{group}/user.md profiles (solo-multi-device, team-collaborator, vault-owner, operator) and run synthetic-user simulations per PROTO-001. Replace the Provisional section 2 of SPEC-047.")
  (acceptance "users/*/user.md exist, spec section 2 no longer Provisional, simulation findings recorded as REQ deltas or explicitly nil"))
(given task-user-profiles)
(given no-deps-user-profiles)
(normally r-ready-user-profiles (and task-user-profiles no-deps-user-profiles) ready-user-profiles)
(normally r-assign-user-profiles (and ready-user-profiles agent-claude-available) assign-user-profiles-claude)

(meta task-happy-paths
  (description "Author happy-paths.md per profile and walk each HP1-HP5 flow of SPEC-047 section 3 against them. Replace the Provisional marker.")
  (acceptance "users/*/happy-paths.md exist and SPEC-047 section 3 traces each HP to a profile task"))
(given task-happy-paths)
(given no-deps-happy-paths)
(normally r-ready-happy-paths (and task-happy-paths no-deps-happy-paths) ready-happy-paths)
(normally r-assign-happy-paths (and ready-happy-paths agent-claude-available) assign-happy-paths-claude)

;; ── Phase 2 — ADR refinements (Provisional markers) ─────────────────────
(meta task-adr-source-of-truth
  (description "Firm up ADR-470 (Loro canonical, Markdown+git export) — snapshot cadence, fsync semantics, oplog compaction interaction with Q4.")
  (acceptance "ADR-470 Provisional marker removed, Q4 answered or narrowed with rationale"))
(given task-adr-source-of-truth)
(given no-deps-adr-source-of-truth)
(normally r-ready-adr-source-of-truth (and task-adr-source-of-truth no-deps-adr-source-of-truth) ready-adr-source-of-truth)
(normally r-assign-adr-source-of-truth (and ready-adr-source-of-truth agent-claude-available) assign-adr-source-of-truth-claude)

(meta task-adr-transport
  (description "Firm up ADR-472 (iroh + pkarr) — relay policy defaults, NAT traversal assumptions, mobile constraints from SPEC-040.")
  (acceptance "ADR-472 Provisional marker removed, Q5 narrowed, relay defaults stated"))
(given task-adr-transport)
(given no-deps-adr-transport)
(normally r-ready-adr-transport (and task-adr-transport no-deps-adr-transport) ready-adr-transport)
(normally r-assign-adr-transport (and ready-adr-transport agent-claude-available) assign-adr-transport-claude)

(meta task-adr-rendezvous
  (description "Firm up ADR-473 routing/secret split — size num for collision avoidance, confirm the 22-bit word-word floor with single-use burn and rate limit, analyse the F58 anyone-can-sign rendezvous residual. Feeds Q1.")
  (acceptance "ADR-473 Provisional marker removed, NFR-475 numbers fixed, Q1 analysis document written for the crypto review"))
(given task-adr-rendezvous)
(given no-deps-adr-rendezvous)
(normally r-ready-adr-rendezvous (and task-adr-rendezvous no-deps-adr-rendezvous) ready-adr-rendezvous)
(normally r-assign-adr-rendezvous (and ready-adr-rendezvous agent-claude-available) assign-adr-rendezvous-claude)

(meta task-adr-trust-model
