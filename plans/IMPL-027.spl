;; IMPL-027: LongMemEval Memory Benchmark
;; Implements SPEC-027 — zetl-bench crate with 6 retrieval modes

(meta plan
  (id "IMPL-027")
  (title "LongMemEval Memory Benchmark")
  (version "1.0.0")
  (status "active")
  (created "2026-04-08")
  (author "agent:claude")
  (spec "SPEC-027")
  (description "Port LongMemEval benchmark to Rust as zetl-bench workspace crate. Six retrieval modes: BM25, semantic, hybrid, graph-augmented, LLM rerank, agentic. Library integration for modes 1-5, MCP for mode 6."))

;; ── Agents ──────────────────────────────────────────────────────────
(given agent-claude-available)

;; ── Tasks ───────────────────────────────────────────────────────────

;; Phase 1: Workspace & scaffold
(given task-workspace)
(given no-deps-workspace)
(meta task-workspace
  (description "Convert zetl to a Cargo workspace and create benches/zetl-bench crate scaffold with Cargo.toml, main.rs (clap subcommands: ingest, run, compare), and module stubs")
  (acceptance "cargo build -p zetl-bench compiles; zetl-bench --help shows subcommands; cargo build -p zetl still works"))

;; Phase 2: Dataset parsing
(given task-dataset)
(meta task-dataset
  (description "Parse longmemeval_s_cleaned.json. Structs: LongMemEntry{question_id, question_type, question, answer, haystack_sessions (Vec<Vec<Turn>>), haystack_session_ids, haystack_dates, answer_session_ids}. Turn{role, content}. Load full file or --limit N.")
  (acceptance "Unit test parses sample JSON fixture with 2 questions; fields roundtrip correctly; --limit flag works"))

;; Phase 3: Vault ingestion
(given task-entity)
(meta task-entity
  (description "Entity extraction from session text. Heuristics: proper nouns (capitalized multi-word not at sentence start), quoted terms, repeated noun phrases (3+ sessions), temporal markers, backtick-wrapped terms. Normalize: lowercase, collapse whitespace, stem plurals. Return Vec<Entity> with name, entity_type, mention_count, session_ids.")
  (acceptance "Unit tests: extracts 'PostgreSQL' from 'switching to PostgreSQL'; extracts quoted terms; normalizes 'PostgreSQL'='postgresql'; deduplicates"))

(given task-ingest)
(meta task-ingest
  (description "Generate Markdown vault from LongMemEval data. One .md per session with YAML frontmatter (session_id, timestamp, question_ids). Auto-insert [[wikilinks]] on first entity mention per session. Create entities/ hub pages listing referencing sessions. Add ## Related sections for sessions sharing 2+ entities. Deterministic output.")
  (acceptance "zetl-bench ingest <fixture.json> --vault-dir /tmp/test-vault creates vault; zetl index on vault succeeds; wikilinks present in session files; entity hub pages exist; same input produces identical vault"))

;; Phase 4: Scoring infrastructure
(given task-scoring)
(meta task-scoring
  (description "Implement scoring.rs: dcg(relevances, k) = sum(rel[i]/log2(i+2)), ndcg(rankings, ground_truth, corpus_ids, k), recall_any_at_k, recall_all_at_k. Session ID mapping: extract session from turn IDs via rsplit('_turn_'). Aggregate per question type.")
  (acceptance "Unit tests: DCG([1,0,1], 3) = 1/log2(2) + 0 + 1/log2(4) = 1.5; NDCG perfect ranking = 1.0; recall@5 with ground truth at rank 3 = 1.0; recall@5 with ground truth at rank 7 = 0.0"))

;; Phase 5: Retrieval modes (can parallelize within phase)
(given task-mode-bm25)
(meta task-mode-bm25
  (description "Mode 1: BM25. Load vault via scan_vault + SearchIndex::build. For each question call SearchIndex::query(question, top_k). Map SearchHit page_names back to session IDs. Return ranked Vec<RetrievalResult>{session_id, score, rank}.")
  (acceptance "Integration test: ingest 5-question fixture, run BM25 mode, verify results JSONL has correct structure and non-zero recall"))

(given task-mode-semantic)
(meta task-mode-semantic
  (description "Mode 2: Semantic. Use VectorIndex::build + query_text(question, top_k). Map VectorHit page_names to session IDs. Requires --features semantic.")
  (acceptance "Integration test: same fixture, semantic mode returns ranked results with cosine similarity scores"))

(given task-mode-hybrid)
(meta task-mode-hybrid
  (description "Mode 3: Hybrid. BM25 + semantic fusion. Retrieve top_k from both, normalize scores to [0,1], combine: score = (1-w)*bm25_norm + w*semantic_norm. Configurable --fusion-weight (default 0.5).")
  (acceptance "Integration test: hybrid results differ from both pure BM25 and pure semantic; fusion weight 0.0 matches BM25; fusion weight 1.0 matches semantic"))

(given task-mode-graph)
(meta task-mode-graph
  (description "Mode 4: Graph-augmented. Hybrid search for initial candidates, then for each result follow LinkGraph forward_links + backlinks (1 hop). Score neighbors: origin_score * decay (default 0.5). Merge, dedup, re-sort, return top_k.")
  (acceptance "Integration test: graph mode surfaces sessions not in hybrid top-k that are linked to top results; result count >= hybrid result count"))

(given task-mode-rerank)
(meta task-mode-rerank
  (description "Mode 5: LLM rerank. Hybrid retrieval for top 50, format as numbered passages, single LLM call to rerank to top_k. Parse structured JSON response. Requires LLM client.")
  (acceptance "Integration test with mock LLM client: reranked order differs from hybrid order; JSONL includes llm_stats{tokens_in, tokens_out, cost_usd}"))

(given task-mode-agentic)
(meta task-mode-agentic
  (description "Mode 6: Agentic. Spawn zetl mcp --transport stdio. System prompt lists tools (search, links, backlinks, path, blocks). LLM drives tool loop. Cap at --max-tool-calls (default 10). Collect referenced sessions as ranked list.")
  (acceptance "Integration test with mock LLM client: agent makes tool calls, receives MCP responses, produces final ranked session list; tool_calls count in llm_stats"))

;; Phase 6: LLM client
(given task-llm-client)
(meta task-llm-client
  (description "LlmClient trait with complete(messages, tools) -> Response. Three impls: GroqClient (OpenAI-compat, api.groq.com, GROQ_API_KEY, default llama-3.1-8b-instant), AnthropicClient (ANTHROPIC_API_KEY), OpenAICompatibleClient (--llm-base-url). All use reqwest. estimate_cost() method per provider.")
  (acceptance "Unit test: GroqClient builds correct request body with tools; AnthropicClient uses messages API format; mock HTTP responses parse correctly"))

;; Phase 7: Reporting
(given task-report)
(meta task-report
  (description "Console output with box-drawing chars showing Recall@5/10, NDCG@5/10, per-type breakdown, timing. JSONL writer: one JSON line per question with question_id, question_type, mode, ground_truth_sessions, retrieved_sessions, metrics, latency_ms, llm_stats. Auto-named files: results_{mode}_{timestamp}.jsonl.")
  (acceptance "Integration test: run mode produces formatted console output; JSONL file is valid (each line parses as JSON); compare subcommand loads 2+ JSONL files and prints side-by-side table"))

;; Phase 8: End-to-end
(given task-e2e)
(meta task-e2e
  (description "End-to-end test: download LongMemEval fixture (or use bundled 5-question sample), ingest, run BM25 mode with --limit 5, verify JSONL output and console summary. Add progress bar via indicatif for long runs.")
  (acceptance "zetl-bench ingest + zetl-bench run --mode bm25 --limit 5 produces valid output end-to-end; progress bar shows during run"))

;; ── Readiness rules ─────────────────────────────────────────────────

;; Phase 1: no deps
(normally r-ready-workspace
  (and task-workspace no-deps-workspace)
  ready-workspace)

;; Phase 2: needs workspace
(normally r-ready-dataset
  (and task-dataset completed-workspace)
  ready-dataset)

;; Phase 3: needs dataset
(normally r-ready-entity
  (and task-entity completed-dataset)
  ready-entity)

(normally r-ready-ingest
  (and task-ingest completed-entity)
  ready-ingest)

;; Phase 4: needs ingest (for test fixtures)
(normally r-ready-scoring
  (and task-scoring completed-dataset)
  ready-scoring)

;; Phase 5: modes need ingest + scoring
(normally r-ready-mode-bm25
  (and task-mode-bm25 completed-ingest completed-scoring)
  ready-mode-bm25)

(normally r-ready-mode-semantic
  (and task-mode-semantic completed-ingest completed-scoring)
  ready-mode-semantic)

(normally r-ready-mode-hybrid
  (and task-mode-hybrid completed-mode-bm25 completed-mode-semantic)
  ready-mode-hybrid)

(normally r-ready-mode-graph
  (and task-mode-graph completed-mode-hybrid)
  ready-mode-graph)

;; LLM client needed before rerank and agentic
(normally r-ready-llm-client
  (and task-llm-client completed-workspace)
  ready-llm-client)

(normally r-ready-mode-rerank
  (and task-mode-rerank completed-mode-hybrid completed-llm-client)
  ready-mode-rerank)

(normally r-ready-mode-agentic
  (and task-mode-agentic completed-mode-rerank)
  ready-mode-agentic)

;; Phase 7: report needs at least BM25 mode
(normally r-ready-report
  (and task-report completed-mode-bm25 completed-scoring)
  ready-report)

;; Phase 8: e2e needs everything
(normally r-ready-e2e
  (and task-e2e completed-report completed-mode-bm25)
  ready-e2e)

;; ── Assignment rules ────────────────────────────────────────────────

(normally r-assign-workspace (and ready-workspace agent-claude-available) assign-to-workspace-claude)
(normally r-assign-dataset (and ready-dataset agent-claude-available) assign-to-dataset-claude)
(normally r-assign-entity (and ready-entity agent-claude-available) assign-to-entity-claude)
(normally r-assign-ingest (and ready-ingest agent-claude-available) assign-to-ingest-claude)
(normally r-assign-scoring (and ready-scoring agent-claude-available) assign-to-scoring-claude)
(normally r-assign-mode-bm25 (and ready-mode-bm25 agent-claude-available) assign-to-mode-bm25-claude)
(normally r-assign-mode-semantic (and ready-mode-semantic agent-claude-available) assign-to-mode-semantic-claude)
(normally r-assign-mode-hybrid (and ready-mode-hybrid agent-claude-available) assign-to-mode-hybrid-claude)
(normally r-assign-mode-graph (and ready-mode-graph agent-claude-available) assign-to-mode-graph-claude)
(normally r-assign-llm-client (and ready-llm-client agent-claude-available) assign-to-llm-client-claude)
(normally r-assign-mode-rerank (and ready-mode-rerank agent-claude-available) assign-to-mode-rerank-claude)
(normally r-assign-mode-agentic (and ready-mode-agentic agent-claude-available) assign-to-mode-agentic-claude)
(normally r-assign-report (and ready-report agent-claude-available) assign-to-report-claude)
(normally r-assign-e2e (and ready-e2e agent-claude-available) assign-to-e2e-claude)

(claims agent:claude
  :at "2026-04-08T00:18:35Z"
  (given claim-v1-workspace)
  (normally r-cl-state-v1-workspace claim-v1-workspace state-claimed-v1-workspace)
  (normally r-cl-chain-v1-workspace state-claimed-v1-workspace claimed-workspace)
)

