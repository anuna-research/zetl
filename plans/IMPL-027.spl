;; ── Meta ───────────────────────────────────────────────

(meta r-ready-humanise-days
  (description "Pure humanise_days function is foundational and has no deps.")
  (justification "Used by metadata strip, base link, page_history polish, and vault_history template."))

(meta r-ready-recent-changes-builder
  (description "Pure recent-changes builder reads existing history infra; no deps.")
  (justification "Prereq for the vault history render context."))

(meta r-ready-vault-history-template
  (description "Template can be authored once humanise_days exists for consistent date rendering.")
  (justification "Template references humanise output; building it first would risk placeholder churn."))

(meta r-ready-vault-history-render-method
  (description "Render method wires template + recent-changes builder.")
  (justification "Both prerequisites must exist before the method can type-check."))

(meta r-ready-page-template-metadata-strip
  (description "Page template edit needs the humaniser.")
  (justification "The strip's stable_days label depends on humanise_days."))

(meta r-ready-base-template-recent-changes-link
  (description "Base template edit is independent of vault-history route but needs the same URL scheme.")
  (justification "Safe to do once humanise_days lands; no runtime dep on the route."))

(meta r-ready-page-history-template-polish
  (description "Polishing the existing page_history.html relies on consistent date rendering.")
  (justification "Aligns the older template with NFR-301 semantic requirements."))

(meta r-ready-vault-history-route
  (description "Route wiring requires the render method to exist.")
  (justification "Serve path is the canonical test harness for the new template."))

(meta r-ready-build-emit-page-history
  (description "Build loop extension requires polished page_history.html.")
  (justification "Avoids committing a build artefact that would immediately regress on polish."))

(meta r-ready-build-emit-vault-history
  (description "Build emission of vault history follows the render method.")
  (justification "Uses the same render path as the serve handler; emit after render is stable."))

(meta r-ready-integration-tests-serve
  (description "Serve tests run once templates + route + links are all wired.")
  (justification "End-to-end assertions require the full serve path."))

(meta r-ready-integration-tests-build
  (description "Build tests run once both build emissions are in place.")
  (justification "Asserts artefacts on disk; both per-page and vault emissions must land."))

(meta r-ready-graceful-absence-tests
  (description "Absence tests run against all four surfaces once they exist.")
  (justification "Single source of truth for REQ-305 enforcement."))

(meta r-ready-accessibility-tests
  (description "A11y tests run once templates are final.")
  (justification "Avoid churn against intermediate markup."))

(meta r-ready-performance-benchmark
  (description "Perf benchmarks run last among the test tasks.")
  (justification "Benchmarks are noisy if functional tests still churn behaviour."))

(meta r-ready-changelog-readme
  (description "Docs land once behaviour stabilises.")
  (justification "Avoid documenting behaviour that shifts during test-driven refinement."))

(meta r-ready-synthetic-user-run
  (description "Synthetic user runs against the shipping artefact including docs.")
  (justification "Users consult docs during onboarding; simulation must reflect the real experience."))

(meta r-ready-adversarial-review
  (description "Adversarial review runs last per Constitution §12.")
  (justification "Review function operates on the full deliverable including synthetic-user findings."))

(claims agent:claude
  :at "2026-04-15T03:21:33Z"
  (given claim-v1-humanise-days)
  (normally r-cl-state-v1-humanise-days claim-v1-humanise-days state-claimed-v1-humanise-days)
  (normally r-cl-chain-v1-humanise-days state-claimed-v1-humanise-days claimed-humanise-days)
)

