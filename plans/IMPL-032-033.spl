;; IMPL-032-033: Three-Stage Hooks + Ecosystem Bridges
;; Implements SPEC-032 v1.1.0 and SPEC-033 v1.0.0

(meta plan
  (id "IMPL-032-033")
  (title "Three-Stage Hooks + Ecosystem Bridges")
  (version "1.0.0")
  (status "draft")
  (created "2026-04-19")
  (author "agent:claude")
  (spec "SPEC-032, SPEC-033")
  (description "Implement SPEC-032 three-stage render hook pipeline (pre-parse / transform / post-render) and SPEC-033 ecosystem bridges (Pandoc, mdBook, remark). Phased rollout: (A) foundation plumbing behind --features hooks-v2 + author CLIs + quality gates; (B) Python + JS helper libraries; (C) canonical extensions as thin stubs pointing at ecosystem plugins; (D) ecosystem foundation behind --features ecosystems-v1; (E/F/G) Pandoc, mdBook, remark adapters each with matrix seeding and golden tests; (H) cross-ecosystem gates and feature-flag retirement. SPEC-032 Phase C + SPEC-033 Phase E converge on stub-model per the §13 Q1 resolution."))

;; ── Agents ──────────────────────────────────────────────
;; agent-core        Rust core plumbing (pipeline, protocol, manifest, selectors)
;; agent-sdk         Python + JS helper libraries and their ecosystems
;; agent-ecosystem   Pandoc / mdBook / remark adapter work
;; agent-release     Matrix maintenance, rollout, supersession, feature-flag retirement
(given agent-core-available)
(given agent-sdk-available)
(given agent-ecosystem-available)
(given agent-release-available)

