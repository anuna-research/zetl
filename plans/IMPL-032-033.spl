;; ── Readiness rules ─────────────────────────────────────

;; Foundation tasks with no deps — ready immediately.
(normally r-ready-ast-schema     task-ast-schema     ready-ast-schema)
(normally r-ready-manifest       task-manifest-parser ready-manifest-parser)
(normally r-ready-three-stage    task-three-stage-pipeline ready-three-stage-pipeline)
(normally r-ready-composition    task-composition    ready-composition)
(normally r-ready-ordering       task-ordering-hooks ready-ordering-hooks)
(normally r-ready-diagnostic-design task-diagnostic-design ready-diagnostic-design)

;; AST types + reference gen depend on schema.
(normally r-ready-ast-types
  (and task-ast-types-rust completed-ast-schema)
  ready-ast-types-rust)
(normally r-ready-ast-reference
  (and task-ast-reference-gen completed-ast-schema)
  ready-ast-reference-gen)

;; Selector + frontmatter opt-out depend on manifest parser.
(normally r-ready-selector-eval
  (and task-selector-eval completed-manifest-parser)
  ready-selector-eval)
(normally r-ready-frontmatter-opt-out
  (and task-frontmatter-opt-out completed-manifest-parser)
  ready-frontmatter-opt-out)

;; Typed AST protocol depends on AST types.
(normally r-ready-typed-ast-protocol
  (and task-typed-ast-protocol completed-ast-types-rust)
  ready-typed-ast-protocol)

;; Persistent protocol depends on three-stage pipeline.
(normally r-ready-persistent-protocol
  (and task-persistent-protocol completed-three-stage-pipeline)
  ready-persistent-protocol)

;; Capability probe depends on version exposure.
(normally r-ready-ast-version-exposure
  (and task-ast-version-exposure completed-three-stage-pipeline)
  ready-ast-version-exposure)
(normally r-ready-capability-probe
  (and task-capability-probe completed-ast-version-exposure)
  ready-capability-probe)

;; Failure scoping depends on three-stage + diagnostic design.
(normally r-ready-failure-scoping
  (and task-failure-scoping completed-three-stage-pipeline completed-diagnostic-design)
  ready-failure-scoping)

;; Build-data channel + context depend on three-stage.
(normally r-ready-build-data-channel
  (and task-build-data-channel completed-three-stage-pipeline)
  ready-build-data-channel)
(normally r-ready-build-context
  (and task-build-context completed-three-stage-pipeline)
  ready-build-context)

;; Safe-mode + behavioural contracts depend on manifest parser.
(normally r-ready-safe-mode
  (and task-safe-mode completed-manifest-parser)
  ready-safe-mode)
(normally r-ready-behavioural-contracts
  (and task-behavioural-contracts completed-manifest-parser)
  ready-behavioural-contracts)

;; Template vars need three-stage pipeline.
(normally r-ready-template-vars
  (and task-template-vars completed-three-stage-pipeline)
  ready-template-vars)

;; Node dispatch depends on AST types.
(normally r-ready-node-dispatch
  (and task-node-dispatch completed-ast-types-rust)
  ready-node-dispatch)

;; Author CLIs: dry-run + coverage need selector eval; authoring-cli
;; needs scaffolding to know the manifest shape.
(normally r-ready-hook-dry-run
  (and task-hook-dry-run completed-selector-eval completed-three-stage-pipeline)
  ready-hook-dry-run)
(normally r-ready-hook-coverage
  (and task-hook-coverage completed-selector-eval)
  ready-hook-coverage)
(normally r-ready-hook-authoring-cli
  (and task-hook-authoring-cli completed-manifest-parser completed-diagnostic-design)
  ready-hook-authoring-cli)
(normally r-ready-ast-cli
  (and task-ast-cli completed-ast-types-rust completed-ast-reference-gen)
  ready-ast-cli)

;; Quality gates depend on the full core landing (represented by
;; failure-scoping + template-vars + behavioural-contracts being in).
(normally r-ready-observability-hooks
  (and task-observability-hooks completed-failure-scoping completed-persistent-protocol)
  ready-observability-hooks)
(normally r-ready-security-hooks
  (and task-security-hooks completed-persistent-protocol completed-safe-mode)
  ready-security-hooks)
(normally r-ready-nfr-gates-032
  (and task-nfr-gates-032 completed-persistent-protocol completed-selector-eval)
  ready-nfr-gates-032)
(normally r-ready-test-032-matrix
  (and task-test-032-matrix completed-failure-scoping completed-template-vars completed-behavioural-contracts)
  ready-test-032-matrix)

;; Helper libraries depend on AST schema + types + reference.
(normally r-ready-helper-py
  (and task-helper-py completed-ast-schema completed-ast-reference-gen completed-typed-ast-protocol)
  ready-helper-py)
(normally r-ready-helper-js
  (and task-helper-js completed-ast-schema completed-ast-reference-gen completed-typed-ast-protocol)
  ready-helper-js)
(normally r-ready-helper-contracts
  (and task-helper-contracts completed-helper-py completed-helper-js)
  ready-helper-contracts)

;; Canonical extensions as thin stubs depend on helpers + template vars
;; + golden-html harness.
(normally r-ready-ext-golden-html
  (and task-ext-golden-html completed-helper-contracts completed-template-vars)
  ready-ext-golden-html)
(normally r-ready-ext-callouts
  (and task-ext-callouts completed-ext-golden-html)
  ready-ext-callouts)
(normally r-ready-ext-tasks
  (and task-ext-tasks completed-ext-golden-html)
  ready-ext-tasks)
(normally r-ready-ext-admonition
  (and task-ext-admonition completed-ext-golden-html)
  ready-ext-admonition)

;; Ecosystem foundation. Gated on SPEC-032 core being in (typed AST,
;; persistent protocol, failure scoping, behavioural contracts) —
;; ecosystems reuse every one of those surfaces.
(normally r-ready-eco-registry
  (and task-eco-registry completed-typed-ast-protocol completed-persistent-protocol)
  ready-eco-registry)
(normally r-ready-adapter-trait
  (and task-adapter-trait completed-eco-registry completed-behavioural-contracts)
  ready-adapter-trait)
(normally r-ready-parser-registry
  (and task-parser-registry completed-adapter-trait)
  ready-parser-registry)
(normally r-ready-eco-manifest
  (and task-eco-manifest completed-adapter-trait)
  ready-eco-manifest)
(normally r-ready-eco-runtime-detect
  (and task-eco-runtime-detect completed-adapter-trait completed-failure-scoping)
  ready-eco-runtime-detect)
(normally r-ready-eco-check
  (and task-eco-check completed-eco-runtime-detect)
  ready-eco-check)
(normally r-ready-eco-feature-flags
  (and task-eco-feature-flags completed-adapter-trait)
  ready-eco-feature-flags)
(normally r-ready-eco-translators-scaffold
  (and task-eco-translators-scaffold completed-ast-types-rust completed-adapter-trait)
  ready-eco-translators-scaffold)

;; Pandoc adapter: needs eco foundation + translator scaffold + parser
;; registry (for native-mode).
(normally r-ready-pandoc-adapter
  (and task-pandoc-adapter completed-adapter-trait completed-eco-manifest
       completed-eco-runtime-detect completed-parser-registry)
  ready-pandoc-adapter)
(normally r-ready-pandoc-translator
  (and task-pandoc-translator completed-eco-translators-scaffold)
  ready-pandoc-translator)
(normally r-ready-pandoc-matrix-seed
  (and task-pandoc-matrix-seed completed-pandoc-adapter completed-pandoc-translator)
  ready-pandoc-matrix-seed)
(normally r-ready-pandoc-docs
  (and task-pandoc-docs completed-pandoc-matrix-seed)
  ready-pandoc-docs)

;; mdBook adapter.
(normally r-ready-mdbook-adapter
  (and task-mdbook-adapter completed-adapter-trait completed-eco-manifest
       completed-eco-runtime-detect)
  ready-mdbook-adapter)
(normally r-ready-mdbook-envelope
  (and task-mdbook-envelope completed-mdbook-adapter completed-eco-translators-scaffold)
  ready-mdbook-envelope)
(normally r-ready-mdbook-matrix-seed
  (and task-mdbook-matrix-seed completed-mdbook-envelope)
  ready-mdbook-matrix-seed)
(normally r-ready-mdbook-docs
  (and task-mdbook-docs completed-mdbook-matrix-seed)
  ready-mdbook-docs)

;; remark adapter.
(normally r-ready-remark-harness
  (and task-remark-harness completed-adapter-trait completed-eco-manifest
       completed-eco-runtime-detect completed-persistent-protocol)
  ready-remark-harness)
(normally r-ready-remark-translator
  (and task-remark-translator completed-eco-translators-scaffold)
  ready-remark-translator)
(normally r-ready-remark-matrix-seed
  (and task-remark-matrix-seed completed-remark-harness completed-remark-translator)
  ready-remark-matrix-seed)
(normally r-ready-remark-docs
  (and task-remark-docs completed-remark-matrix-seed)
  ready-remark-docs)

;; Cross-ecosystem gates and rollout.
(normally r-ready-eco-matrix
  (and task-eco-matrix completed-pandoc-matrix-seed completed-mdbook-matrix-seed
       completed-remark-matrix-seed)
  ready-eco-matrix)
(normally r-ready-mixed-eco-diagnostic
  (and task-mixed-eco-diagnostic completed-parser-registry completed-failure-scoping)
  ready-mixed-eco-diagnostic)
(normally r-ready-plugin-version-drift
  (and task-plugin-version-drift completed-eco-matrix)
  ready-plugin-version-drift)
(normally r-ready-nfr-gates-033
  (and task-nfr-gates-033 completed-pandoc-adapter completed-mdbook-adapter completed-remark-harness)
  ready-nfr-gates-033)
(normally r-ready-spec-031-supersede
  (and task-spec-031-supersede completed-eco-matrix completed-test-032-matrix)
  ready-spec-031-supersede)

;; Feature-flag retirement gates — the semantic "two clean releases"
;; is represented as all extension + all ecosystem golden tests being in.
(normally r-ready-retire-hooks-v2
  (and task-retire-hooks-v2 completed-ext-callouts completed-ext-tasks
       completed-ext-admonition completed-nfr-gates-032 completed-test-032-matrix)
  ready-retire-hooks-v2)
(normally r-ready-retire-ecosystems-v1
  (and task-retire-ecosystems-v1 completed-eco-matrix completed-nfr-gates-033)
  ready-retire-ecosystems-v1)

;; ── Assignment rules ────────────────────────────────────

;; All agents default to a catch-all assignment; specific rules below
;; override via prefer. Pattern: core tasks → core agent; SDK tasks →
;; sdk agent; ecosystem tasks → ecosystem agent; rollout → release.

;; Default catch-all: core agent picks up anything ready.
(normally r-assign-core-default
  (and ready-ast-schema agent-core-available) assign-to-ast-schema-core)
(normally r-assign-core-ast-types
  (and ready-ast-types-rust agent-core-available) assign-to-ast-types-rust-core)
(normally r-assign-core-ast-reference
  (and ready-ast-reference-gen agent-core-available) assign-to-ast-reference-gen-core)
(normally r-assign-core-manifest
  (and ready-manifest-parser agent-core-available) assign-to-manifest-parser-core)
(normally r-assign-core-selector
  (and ready-selector-eval agent-core-available) assign-to-selector-eval-core)
(normally r-assign-core-frontmatter
  (and ready-frontmatter-opt-out agent-core-available) assign-to-frontmatter-opt-out-core)
(normally r-assign-core-three-stage
  (and ready-three-stage-pipeline agent-core-available) assign-to-three-stage-pipeline-core)
(normally r-assign-core-persistent
  (and ready-persistent-protocol agent-core-available) assign-to-persistent-protocol-core)
(normally r-assign-core-typed-ast
  (and ready-typed-ast-protocol agent-core-available) assign-to-typed-ast-protocol-core)
(normally r-assign-core-ast-version
  (and ready-ast-version-exposure agent-core-available) assign-to-ast-version-exposure-core)
(normally r-assign-core-capability
  (and ready-capability-probe agent-core-available) assign-to-capability-probe-core)
(normally r-assign-core-composition
  (and ready-composition agent-core-available) assign-to-composition-core)
(normally r-assign-core-failure
  (and ready-failure-scoping agent-core-available) assign-to-failure-scoping-core)
(normally r-assign-core-build-data
  (and ready-build-data-channel agent-core-available) assign-to-build-data-channel-core)
(normally r-assign-core-build-context
  (and ready-build-context agent-core-available) assign-to-build-context-core)
(normally r-assign-core-safe-mode
  (and ready-safe-mode agent-core-available) assign-to-safe-mode-core)
(normally r-assign-core-contracts
  (and ready-behavioural-contracts agent-core-available) assign-to-behavioural-contracts-core)
(normally r-assign-core-template-vars
  (and ready-template-vars agent-core-available) assign-to-template-vars-core)
(normally r-assign-core-ordering
  (and ready-ordering-hooks agent-core-available) assign-to-ordering-hooks-core)
(normally r-assign-core-dispatch
  (and ready-node-dispatch agent-core-available) assign-to-node-dispatch-core)

;; Author CLIs → core agent.
(normally r-assign-core-dry-run
  (and ready-hook-dry-run agent-core-available) assign-to-hook-dry-run-core)
(normally r-assign-core-coverage
  (and ready-hook-coverage agent-core-available) assign-to-hook-coverage-core)
(normally r-assign-core-authoring-cli
  (and ready-hook-authoring-cli agent-core-available) assign-to-hook-authoring-cli-core)
(normally r-assign-core-ast-cli
  (and ready-ast-cli agent-core-available) assign-to-ast-cli-core)
(normally r-assign-core-diagnostic
  (and ready-diagnostic-design agent-core-available) assign-to-diagnostic-design-core)

;; Quality gates → core agent.
(normally r-assign-core-obs
  (and ready-observability-hooks agent-core-available) assign-to-observability-hooks-core)
(normally r-assign-core-sec
  (and ready-security-hooks agent-core-available) assign-to-security-hooks-core)
(normally r-assign-core-nfr-032
  (and ready-nfr-gates-032 agent-core-available) assign-to-nfr-gates-032-core)
(normally r-assign-core-test-032
  (and ready-test-032-matrix agent-core-available) assign-to-test-032-matrix-core)

;; SDK agent owns helper libraries and their contract tests.
(normally r-assign-sdk-py
  (and ready-helper-py agent-sdk-available) assign-to-helper-py-sdk)
(normally r-assign-sdk-js
  (and ready-helper-js agent-sdk-available) assign-to-helper-js-sdk)
(normally r-assign-sdk-contracts
  (and ready-helper-contracts agent-sdk-available) assign-to-helper-contracts-sdk)

;; SDK agent also owns canonical-extension stubs (they exercise the
;; helper-lib + template-var + golden surface).
(normally r-assign-sdk-golden
  (and ready-ext-golden-html agent-sdk-available) assign-to-ext-golden-html-sdk)
(normally r-assign-sdk-callouts
  (and ready-ext-callouts agent-sdk-available) assign-to-ext-callouts-sdk)
(normally r-assign-sdk-tasks
  (and ready-ext-tasks agent-sdk-available) assign-to-ext-tasks-sdk)
(normally r-assign-sdk-admonition
  (and ready-ext-admonition agent-sdk-available) assign-to-ext-admonition-sdk)

;; Ecosystem agent owns all adapter work.
(normally r-assign-eco-registry
  (and ready-eco-registry agent-ecosystem-available) assign-to-eco-registry-ecosystem)
(normally r-assign-eco-adapter
  (and ready-adapter-trait agent-ecosystem-available) assign-to-adapter-trait-ecosystem)
(normally r-assign-eco-parser
  (and ready-parser-registry agent-ecosystem-available) assign-to-parser-registry-ecosystem)
(normally r-assign-eco-manifest
  (and ready-eco-manifest agent-ecosystem-available) assign-to-eco-manifest-ecosystem)
(normally r-assign-eco-runtime
  (and ready-eco-runtime-detect agent-ecosystem-available) assign-to-eco-runtime-detect-ecosystem)
(normally r-assign-eco-check
  (and ready-eco-check agent-ecosystem-available) assign-to-eco-check-ecosystem)
(normally r-assign-eco-flags
  (and ready-eco-feature-flags agent-ecosystem-available) assign-to-eco-feature-flags-ecosystem)
(normally r-assign-eco-translators-scaffold
  (and ready-eco-translators-scaffold agent-ecosystem-available) assign-to-eco-translators-scaffold-ecosystem)
(normally r-assign-eco-pandoc-adapter
  (and ready-pandoc-adapter agent-ecosystem-available) assign-to-pandoc-adapter-ecosystem)
(normally r-assign-eco-pandoc-translator
  (and ready-pandoc-translator agent-ecosystem-available) assign-to-pandoc-translator-ecosystem)
(normally r-assign-eco-pandoc-matrix
  (and ready-pandoc-matrix-seed agent-ecosystem-available) assign-to-pandoc-matrix-seed-ecosystem)
(normally r-assign-eco-pandoc-docs
  (and ready-pandoc-docs agent-ecosystem-available) assign-to-pandoc-docs-ecosystem)
(normally r-assign-eco-mdbook-adapter
  (and ready-mdbook-adapter agent-ecosystem-available) assign-to-mdbook-adapter-ecosystem)
(normally r-assign-eco-mdbook-envelope
  (and ready-mdbook-envelope agent-ecosystem-available) assign-to-mdbook-envelope-ecosystem)
(normally r-assign-eco-mdbook-matrix
  (and ready-mdbook-matrix-seed agent-ecosystem-available) assign-to-mdbook-matrix-seed-ecosystem)
(normally r-assign-eco-mdbook-docs
  (and ready-mdbook-docs agent-ecosystem-available) assign-to-mdbook-docs-ecosystem)
(normally r-assign-eco-remark-harness
  (and ready-remark-harness agent-ecosystem-available) assign-to-remark-harness-ecosystem)
(normally r-assign-eco-remark-translator
  (and ready-remark-translator agent-ecosystem-available) assign-to-remark-translator-ecosystem)
(normally r-assign-eco-remark-matrix
  (and ready-remark-matrix-seed agent-ecosystem-available) assign-to-remark-matrix-seed-ecosystem)
(normally r-assign-eco-remark-docs
  (and ready-remark-docs agent-ecosystem-available) assign-to-remark-docs-ecosystem)
(normally r-assign-eco-matrix-full
  (and ready-eco-matrix agent-ecosystem-available) assign-to-eco-matrix-ecosystem)
(normally r-assign-eco-mixed
  (and ready-mixed-eco-diagnostic agent-ecosystem-available) assign-to-mixed-eco-diagnostic-ecosystem)
(normally r-assign-eco-version-drift
  (and ready-plugin-version-drift agent-ecosystem-available) assign-to-plugin-version-drift-ecosystem)
(normally r-assign-eco-nfr-033
  (and ready-nfr-gates-033 agent-ecosystem-available) assign-to-nfr-gates-033-ecosystem)

;; Release agent owns supersession + feature-flag retirement.
(normally r-assign-release-supersede
  (and ready-spec-031-supersede agent-release-available) assign-to-spec-031-supersede-release)
(normally r-assign-release-retire-hooks
  (and ready-retire-hooks-v2 agent-release-available) assign-to-retire-hooks-v2-release)
(normally r-assign-release-retire-eco
  (and ready-retire-ecosystems-v1 agent-release-available) assign-to-retire-ecosystems-v1-release)

;; ── Rule metadata ───────────────────────────────────────

(meta r-assign-sdk-py
  (description "Helper libraries are published under a separate packaging discipline (PyPI/npm) — SDK agent owns the release process.")
  (justification "SPEC-032 §12 Phase B keeps helper-lib publishing distinct from the core Rust release cadence; the agent who owns npm/PyPI keys lives under agent-sdk."))

(meta r-assign-eco-adapter
  (description "Ecosystem adapters require real-runtime access (pandoc/mdbook/node binaries) in CI, plus per-ecosystem plugin expertise.")
  (justification "SPEC-033 §12 Phase A gates each adapter on a real runtime present in CI — the ecosystem agent's workflow image has all three runtimes preinstalled."))

(meta r-ready-retire-hooks-v2
  (description "Retiring --features hooks-v2 requires all canonical extensions + NFR gates + test matrix green — per SPEC-032 §12 Phase D \"two consecutive releases clean\".")
  (justification "The checklist in §12 is meaningless without all three canonical stubs and both the performance and coverage gates landed; modelled as hard prerequisites."))

(meta r-ready-retire-ecosystems-v1
  (description "Retiring --features ecosystems-v1 requires all three adapters + their matrix + NFR gates — per SPEC-033 §12 Phase F.")
  (justification "Parallel to hooks-v2 retirement; cannot drop the umbrella until all three adapters demonstrate stability."))
