;; ════════════════════════════════════════════════════════════════════════════
;; Phase 3 — Export and Polish
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Goal: Add zetl theme export, create a docs bundled theme, polish error
;; messages and verbose logging for all theme operations.
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: zetl theme export command ─────────────────────────────────────

(given task-theme-export-cmd)

(meta task-theme-export-cmd
  (description "Implement `zetl theme export <name>` per REQ-014-014.

Add to ThemeCommand enum:
```rust
/// Export a bundled theme to .zetl/themes/ for customisation
Export {
    /// Bundled theme name to export
    name: String,
    /// Overwrite existing theme directory
    #[arg(long)]
    force: bool,
},
```

Implementation:
1. Check name is a bundled theme (bundled_theme_names().contains(name)). If not, error: 'only bundled themes can be exported; <name> is not a bundled theme'.
2. If .zetl/themes/<name>/ exists and no --force, error with hint.
3. Create .zetl/themes/<name>/.
4. Write all files from the embedded theme directory to disk.
5. Output JSON: { exported: { name, path, files_written: usize } }.

After export, the user's copy takes precedence (Tier 1 > Tier 2), so they can immediately edit and see changes in serve mode.

REQ-014-014.")
  (acceptance "zetl theme export default writes bundled templates to .zetl/themes/default/; exported files are identical to bundled; --force overwrites; non-bundled name errors; JSON output; exported theme immediately usable with serve"))

(normally r-ready-theme-export-cmd
  (and task-theme-export-cmd completed-verify-phase2)
  ready-theme-export-cmd)

(normally r-assign-theme-export-cmd
  (and ready-theme-export-cmd agent-claude-available)
  assign-to-theme-export-cmd-claude)

;; ── Task: Create docs bundled theme ─────────────────────────────────────

(given task-create-docs-theme)

(meta task-create-docs-theme
  (description "Create themes/docs/ — a documentation-oriented theme optimised for technical writing. Design goals:

- Clean, professional look suitable for project documentation
- Wide content area (no transclusion sidebar by default)
- Table of contents generated from headings in the sidebar
- Code block syntax highlighting emphasis
- Print-friendly styles
- CDN-based (Tailwind/DaisyUI) like the default theme, but with a documentation-focused layout

Add theme.toml:
```toml
[theme]
name = \"docs\"
version = \"0.9.0\"
description = \"A documentation-oriented theme for technical writing\"
author = \"zetl contributors\"
license = \"AGPL-3.0\"

[theme.templates]
overrides = [\"base.html\", \"page.html\"]
```

This theme may only override base.html and page.html, inheriting index.html and folder.html from the default theme (demonstrating partial override with three-tier resolution).

NFR-014-002 — keep total bundled themes under 100 KB.")
  (acceptance "themes/docs/ exists with theme.toml and overridden templates; renders correctly in serve and build; table of contents visible in sidebar; total bundled theme size still under 100 KB; cargo check passes"))

(normally r-ready-create-docs-theme
  (and task-create-docs-theme completed-verify-phase2)
  ready-create-docs-theme)

(normally r-assign-create-docs-theme
  (and ready-create-docs-theme agent-claude-available)
  assign-to-create-docs-theme-claude)

;; ── Task: Verbose logging and error polish ──────────────────────────────

(given task-verbose-logging)

(meta task-verbose-logging
  (description "Add verbose logging and polish error messages across all theme operations per OBS-014-001, OBS-014-002.

Install verbose output (--verbose or -v):
  - Resolved git URL
  - Ref and resolved commit SHA
  - Clone duration (ms)
  - Number of files copied
  - Total size of installed theme (bytes)
  - Min zetl version warning if applicable

Template resolution verbose output (already partially in place from task-three-tier-resolution):
  - Ensure all three tiers are logged distinctly
  - Format: 'theme: <template> <- <source> (<tier>)'

Error message improvements:
  - All error messages should include actionable hints
  - Network errors: suggest checking connectivity
  - Repo not found: show the resolved URL that was tried
  - Name collision: show --force flag
  - Invalid name: show sanitised suggestion
  - Missing git: show install instructions per platform

OBS-014-001, OBS-014-002.")
  (acceptance "All theme commands produce helpful verbose output; all error paths include actionable hints; no raw git error messages leak to users without context"))

(normally r-ready-verbose-logging
  (and task-verbose-logging completed-theme-export-cmd completed-create-docs-theme)
  ready-verbose-logging)

(normally r-assign-verbose-logging
  (and ready-verbose-logging agent-claude-available)
  assign-to-verbose-logging-claude)

;; ── Task: Verify Phase 3 (Final) ────────────────────────────────────────

(given task-verify-phase3)

(meta task-verify-phase3
  (description "Final end-to-end verification of SPEC-014:

1. zetl theme list shows three bundled themes: default, minimal, docs.
2. zetl theme export default → customise → zetl serve --theme default uses disk copy.
3. zetl theme export minimal → zetl theme list shows 'installed (shadows bundled)'.
4. zetl theme install <real-github-repo> → zetl serve --theme <name> → zetl theme remove <name>.
5. zetl theme install <repo>#<tag> --path <subdir> --name custom-name → verify all flags.
6. zetl build --theme docs produces valid static site.
7. zetl build --theme minimal produces CDN-free static site.
8. Three-tier resolution verified end-to-end.
9. All error paths produce clear, actionable messages.
10. --verbose produces detailed logging for all theme operations.
11. Binary size impact < 100 KB from bundled themes.
12. cargo test passes with no regressions.

All TEST-014-* scenarios.")
  (acceptance "All 12 scenarios pass; full SPEC-014 compliance verified; no regressions in any existing functionality"))

(normally r-ready-verify-phase3
  (and task-verify-phase3 completed-verbose-logging)
  ready-verify-phase3)

(normally r-assign-verify-phase3
  (and ready-verify-phase3 agent-claude-available)
  assign-to-verify-phase3-claude)
