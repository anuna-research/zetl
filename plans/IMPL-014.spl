;; ════════════════════════════════════════════════════════════════════════════
;; IMPL-014: zetl theme — Theme Distribution and Installation
;; Implementation plan for SPEC-014
;; ════════════════════════════════════════════════════════════════════════════

(meta plan
  (id "IMPL-014")
  (title "zetl theme — Theme Distribution and Installation")
  (version "0.1.0")
  (status "active")
  (created "2026-03-02")
  (author "agent:claude")
  (spec "SPEC-014")
  (description "Implement theme distribution for zetl. Phase 1: extract built-in templates into themes/default/, add a minimal bundled theme, embed themes at compile time via include_dir or build.rs, refactor engine.rs for three-tier resolution, add `zetl theme list` subcommand. Phase 2: implement `zetl theme install` with git clone, source format parsing (GitHub shorthand, URLs, #ref, --path), name resolution, provenance tracking, and `zetl theme remove`. Phase 3: implement `zetl theme export`, add a docs bundled theme, polish error messages and verbose logging. Covers REQ-014-001 through REQ-014-016, ADR-014-001 through ADR-014-003."))

;; ════════════════════════════════════════════════════════════════════════════
;; Agents
;; ════════════════════════════════════════════════════════════════════════════

(given agent-claude-available)

;; ════════════════════════════════════════════════════════════════════════════
;; Phase 1 — Bundled Themes and theme list
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Goal: Move built-in templates from src/web/templates/ into themes/default/,
;; create a minimal bundled theme, embed all bundled themes at compile time,
;; refactor the template engine for three-tier resolution, and add `zetl theme
;; list`. After this phase, `zetl serve --theme minimal` works with a new
;; bundled theme and users can see all available themes.
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Extract default theme into themes/default/ ────────────────────

(given task-extract-default-theme)
(given no-deps-extract-default-theme)

(meta task-extract-default-theme
  (description "Create the themes/ directory at the repository root. Move the current built-in templates from src/web/templates/ (base.html, index.html, page.html, folder.html) into themes/default/. Add a theme.toml manifest:

```toml
[theme]
name = \"default\"
version = \"0.9.0\"
description = \"The default zetl theme\"
author = \"zetl contributors\"
license = \"AGPL-3.0\"

[theme.templates]
overrides = [\"base.html\", \"index.html\", \"page.html\", \"folder.html\"]
```

Keep src/web/templates/ intact for now — the include_str!() calls still reference them. The next task (compile-time embedding) will switch the source of truth. The templates in themes/default/ must be byte-for-byte identical to src/web/templates/ at this point.

REQ-014-003.")
  (acceptance "themes/default/ exists with base.html, index.html, page.html, folder.html, and theme.toml; templates are identical to src/web/templates/; cargo check passes; existing tests pass unchanged"))

(normally r-ready-extract-default-theme
  (and task-extract-default-theme no-deps-extract-default-theme)
  ready-extract-default-theme)

(normally r-assign-extract-default-theme
  (and ready-extract-default-theme agent-claude-available)
  assign-to-extract-default-theme-claude)

;; ── Task: Create minimal bundled theme ──────────────────────────────────

(given task-create-minimal-theme)

(meta task-create-minimal-theme
  (description "Create themes/minimal/ — a stripped-down theme that demonstrates theme authoring with the smallest possible surface. This theme overrides base.html to remove the DaisyUI/Tailwind CDN dependencies and uses inline CSS for a clean, typography-focused look. page.html, index.html, and folder.html extend the minimal base.html.

Design constraints:
  - No CDN dependencies — fully self-contained HTML/CSS
  - System font stack only (no web fonts)
  - Light background, dark text, minimal colour palette
  - Sidebar navigation still functional
  - Search modal still works (reuse the JS from default or simplify)
  - Responsive: readable on mobile without the drawer component

Add theme.toml:
```toml
[theme]
name = \"minimal\"
version = \"0.9.0\"
description = \"A minimal, typography-focused theme with no CDN dependencies\"
author = \"zetl contributors\"
license = \"AGPL-3.0\"

[theme.templates]
overrides = [\"base.html\", \"index.html\", \"page.html\", \"folder.html\"]
```

REQ-014-003, NFR-014-002.")
  (acceptance "themes/minimal/ exists with all four templates + theme.toml; theme renders correctly in both serve and build modes; no external CDN requests; binary size increase from this theme is < 30 KB; search modal functional"))

(normally r-ready-create-minimal-theme
  (and task-create-minimal-theme completed-extract-default-theme)
  ready-create-minimal-theme)

(normally r-assign-create-minimal-theme
  (and ready-create-minimal-theme agent-claude-available)
  assign-to-create-minimal-theme-claude)

;; ── Task: Compile-time theme embedding ──────────────────────────────────

(given task-compile-time-embedding)

(meta task-compile-time-embedding
  (description "Replace the hardcoded include_str!() calls in engine.rs with a compile-time embedding mechanism that loads all themes from the themes/ directory.

Approach: Use the `include_dir` crate (or a build.rs that generates a static HashMap). The key decision is:

Option A — `include_dir` crate:
  Add `include_dir = \"0.7\"` to Cargo.toml. In engine.rs:
  ```rust
  use include_dir::{include_dir, Dir};
  static BUNDLED_THEMES: Dir = include_dir!(\"$CARGO_MANIFEST_DIR/themes\");
  ```
  Lookup: BUNDLED_THEMES.get_file(format!(\"{theme}/{template}\"))

Option B — build.rs codegen:
  Generate a Rust source file that contains static &str constants for each theme/template pair. More control, no extra dependency.

Recommendation: Option A is simpler and well-maintained. Use it unless the dependency is unacceptable.

After this task, delete src/web/templates/ — themes/default/ is now the single source of truth for built-in templates. Update all references.

Create a helper function:
  fn bundled_template(theme: &str, name: &str) -> Option<&'static str>
that looks up a template from the embedded directory. Returns None if the theme or template does not exist.

Also create:
  fn bundled_theme_names() -> Vec<&'static str>
that returns the list of all embedded theme directory names.

REQ-014-004, ADR-014-002.")
  (acceptance "src/web/templates/ deleted; engine.rs uses embedded themes from themes/; bundled_template(\"default\", \"base.html\") returns the template content; bundled_template(\"minimal\", \"base.html\") returns the minimal template; bundled_theme_names() returns [\"default\", \"minimal\"]; cargo check passes; all existing tests pass"))

(normally r-ready-compile-time-embedding
  (and task-compile-time-embedding completed-extract-default-theme)
  ready-compile-time-embedding)

(normally r-assign-compile-time-embedding
  (and ready-compile-time-embedding agent-claude-available)
  assign-to-compile-time-embedding-claude)

;; ── Task: Three-tier template resolution ────────────────────────────────

(given task-three-tier-resolution)

(meta task-three-tier-resolution
  (description "Refactor the template loader in engine.rs build_env() to implement three-tier resolution per REQ-014-004:

1. Tier 1 (User Theme): .zetl/themes/<active-theme>/<template>.html on disk
2. Tier 2 (Bundled Theme): bundled_template(active_theme, template) from compile-time embed
3. Tier 3 (Default Fallback): bundled_template(\"default\", template) from compile-time embed

Current code only has Tier 1 (disk) and Tier 2 (hardcoded default). The change is:
- Replace the match statement in the loader with calls to bundled_template()
- Add the intermediate Tier 2 lookup for the active theme name
- Tier 3 is the final fallback to \"default\"

When --theme default: Tier 1 is skipped (existing behaviour), Tier 2 = Tier 3.
When --theme minimal: Tier 1 checks disk, Tier 2 checks bundled minimal/, Tier 3 falls back to bundled default/.
When --theme custom-user-theme: Tier 1 checks disk, Tier 2 has no bundled match (returns None), Tier 3 falls back to default.

Update validate_theme() in main.rs: currently it requires .zetl/themes/<name>/ to exist for non-default themes. It must now also accept names that match a bundled theme (bundled_theme_names().contains(theme)). A theme is valid if it exists on disk OR is bundled. Both can be true (installed shadows bundled).

Update verbose logging to show which tier resolved each template (OBS-014-002):
  theme: base.html  <- .zetl/themes/garden/base.html (disk)
  theme: index.html <- bundled:minimal/index.html
  theme: page.html  <- bundled:default/page.html (fallback)

REQ-014-004, OBS-014-002.")
  (acceptance "Three-tier resolution works: disk > bundled active > bundled default; validate_theme accepts bundled theme names without disk presence; --theme minimal works with only bundled templates (no .zetl/themes/minimal/ on disk); verbose output shows resolution tier per template; existing tests pass; new tests cover all three tiers"))

(normally r-ready-three-tier-resolution
  (and task-three-tier-resolution completed-compile-time-embedding)
  ready-three-tier-resolution)

(normally r-assign-three-tier-resolution
  (and ready-three-tier-resolution agent-claude-available)
  assign-to-three-tier-resolution-claude)

;; ── Task: theme.toml parsing ────────────────────────────────────────────

(given task-theme-toml-parsing)

(meta task-theme-toml-parsing
  (description "Add theme manifest parsing. Create a new module src/theme.rs (or src/web/theme.rs) with:

```rust
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ThemeManifest {
    pub theme: ThemeInfo,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ThemeInfo {
    pub name: String,
    pub version: String,
    #[serde(default)]
    pub description: Option<String>,
    #[serde(default)]
    pub author: Option<String>,
    #[serde(default)]
    pub license: Option<String>,
    #[serde(default)]
    pub homepage: Option<String>,
    #[serde(default)]
    pub min_zetl_version: Option<String>,
    #[serde(default)]
    pub templates: Option<ThemeTemplates>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ThemeTemplates {
    #[serde(default)]
    pub overrides: Vec<String>,
}
```

Add `toml` crate to Cargo.toml (use latest stable, likely 0.8+).

Public API:
  - parse_theme_manifest(content: &str) -> Result<ThemeManifest>
    Parses TOML content. Validates name matches ^[a-z0-9][a-z0-9_-]*$ and version is valid SemVer (use the `semver` crate or a simple regex; prefer semver crate if already available).
  - load_theme_manifest(theme_dir: &Path) -> Option<ThemeManifest>
    Reads theme.toml from the given directory. Returns None if file doesn't exist. Returns error context if file exists but is malformed.
  - load_bundled_manifest(theme_name: &str) -> Option<ThemeManifest>
    Reads theme.toml from the embedded theme directory.
  - validate_theme_name(name: &str) -> Result<()>
    Validates the name pattern. Returns descriptive error on failure.

Also parse .zetl-source.toml (provenance) with a separate struct — needed for theme list in the next task:

```rust
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ThemeSource {
    pub source: ThemeSourceInfo,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ThemeSourceInfo {
    pub url: String,
    #[serde(default)]
    pub ref_name: Option<String>,
    pub commit: String,
    #[serde(default)]
    pub path: Option<String>,
    pub installed_at: String,
    pub zetl_version: String,
}
```

REQ-014-001, REQ-014-002, CON-014-001.")
  (acceptance "parse_theme_manifest parses valid TOML; rejects invalid names and versions; unknown keys ignored; load_theme_manifest reads from disk; load_bundled_manifest reads from embedded; validate_theme_name rejects /, \\, .., uppercase, spaces; cargo check passes"))

(normally r-ready-theme-toml-parsing
  (and task-theme-toml-parsing completed-compile-time-embedding)
  ready-theme-toml-parsing)

(normally r-assign-theme-toml-parsing
  (and ready-theme-toml-parsing agent-claude-available)
  assign-to-theme-toml-parsing-claude)

