;; ════════════════════════════════════════════════════════════════════════════
;; Phase 2 — Git-Based Install and Remove
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Goal: Implement zetl theme install (git clone, source parsing, name
;; resolution, provenance) and zetl theme remove. After this phase, users
;; can install themes from any git repository.
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Source format parsing ─────────────────────────────────────────

(given task-source-parsing)

(meta task-source-parsing
  (description "Implement git source format parsing in src/theme.rs per REQ-014-006, REQ-014-007.

Create a ThemeSource struct (not to be confused with .zetl-source.toml — this is the parsed install source):

```rust
pub struct ThemeInstallSource {
    pub url: String,            // Resolved git URL
    pub git_ref: Option<String>, // Branch, tag, or SHA
    pub path: Option<String>,   // Subdirectory within repo
}
```

Public API:
  - parse_install_source(source: &str) -> Result<ThemeInstallSource>
    Parses the source string and resolves:
    - 'user/repo' -> https://github.com/user/repo.git (exactly one slash, no protocol)
    - 'user/repo#v2.0' -> same URL + ref='v2.0'
    - 'https://...' -> used directly, extract #ref if present
    - 'git@...' -> used directly, extract #ref if present
    Reject anything that doesn't match these patterns.

  - sanitize_theme_name(raw: &str) -> String
    Lowercase, replace non-alphanumeric with hyphens, strip leading/trailing hyphens.
    Used for deriving a name from a repo URL when no --name or manifest name.

  - resolve_theme_name(name_flag: Option<&str>, manifest: Option<&ThemeManifest>, path: Option<&str>, source: &ThemeInstallSource) -> Result<String>
    Precedence per REQ-014-009:
    1. --name flag
    2. manifest.theme.name
    3. Last component of --path
    4. Repo name from URL
    Validate result with validate_theme_name().

REQ-014-006, REQ-014-007, REQ-014-009.")
  (acceptance "parse_install_source handles all four formats correctly; #ref extraction works; sanitize_theme_name produces valid names; resolve_theme_name follows correct precedence; invalid source strings produce clear errors"))

(normally r-ready-source-parsing
  (and task-source-parsing completed-theme-toml-parsing)
  ready-source-parsing)

(normally r-assign-source-parsing
  (and ready-source-parsing agent-claude-available)
  assign-to-source-parsing-claude)

;; ── Task: Git clone and file copy ───────────────────────────────────────

(given task-git-clone)

(meta task-git-clone
  (description "Implement the git clone and file copy logic for theme installation per REQ-014-006, ADR-014-003.

Public API in src/theme.rs:
  - clone_theme(source: &ThemeInstallSource, target_dir: &Path) -> Result<CloneResult>

Process:
1. Create a temporary directory (tempfile::tempdir).
2. Run `git clone --depth 1 [--branch <ref>] <url> <tmpdir>`.
   - If ref is present and looks like a branch/tag name, use --branch.
   - If ref looks like a commit SHA (40 hex chars or 7+ hex prefix), do a full clone then `git checkout <sha>`.
   - If git is not on PATH, return a clear error: 'git is required for theme installation but was not found on PATH'.
3. If --path is specified, verify <tmpdir>/<path> exists and is a directory.
   - On failure, scan <tmpdir> for directories containing theme.toml and list them as hints.
4. Copy theme files from the source directory (tmpdir root or tmpdir/path) to target_dir:
   - Copy all files except .git/, .github/, .gitignore, .gitattributes.
   - Preserve directory structure.
5. Return CloneResult { commit_sha: String, files_copied: usize, total_bytes: u64 }.

CloneResult:
```rust
pub struct CloneResult {
    pub commit_sha: String,
    pub files_copied: usize,
    pub total_bytes: u64,
}
```

Get the commit SHA via `git -C <tmpdir> rev-parse HEAD` before cleanup.

Use std::process::Command for git operations. Do NOT use libgit2 — keep the dependency light (ADR-014-003).

REQ-014-006, REQ-014-008, REQ-014-015, ADR-014-003.")
  (acceptance "Shallow clone works for branches and tags; full clone + checkout works for SHA refs; --path extracts correct subdirectory; .git/ excluded from copy; commit SHA captured; missing git produces clear error; path hint on missing subdirectory; tempdir cleaned up on success and failure"))

(normally r-ready-git-clone
  (and task-git-clone completed-source-parsing)
  ready-git-clone)

(normally r-assign-git-clone
  (and ready-git-clone agent-claude-available)
  assign-to-git-clone-claude)

;; ── Task: Provenance tracking ───────────────────────────────────────────

(given task-provenance)

(meta task-provenance
  (description "Implement .zetl-source.toml provenance writing per REQ-014-011.

After clone_theme() succeeds and files are copied to .zetl/themes/<name>/, write .zetl-source.toml:

```toml
[source]
url = \"https://github.com/user/repo.git\"
ref = \"v2.0.0\"
commit = \"abc1234def5678...\"
path = \"themes/garden\"
installed_at = \"2026-03-02T14:30:00Z\"
zetl_version = \"0.9.0\"
```

Public API:
  - write_provenance(theme_dir: &Path, source: &ThemeInstallSource, clone_result: &CloneResult) -> Result<()>
  - read_provenance(theme_dir: &Path) -> Option<ThemeSource>
    (Uses the ThemeSource struct from task-theme-toml-parsing.)

The installed_at timestamp uses UTC ISO 8601. zetl_version is read from env!(\"CARGO_PKG_VERSION\").

REQ-014-011.")
  (acceptance ".zetl-source.toml written after install with all fields; read_provenance parses it back correctly; missing file returns None; timestamp is valid ISO 8601 UTC"))

(normally r-ready-provenance
  (and task-provenance completed-git-clone)
  ready-provenance)

(normally r-assign-provenance
  (and ready-provenance agent-claude-available)
  assign-to-provenance-claude)

;; ── Task: zetl theme install command ────────────────────────────────────

(given task-theme-install-cmd)

(meta task-theme-install-cmd
  (description "Wire up the `zetl theme install` CLI subcommand per CON-014-002.

Add to ThemeCommand enum:
```rust
/// Install a theme from a git repository
Install {
    /// Theme source (user/repo, URL, or git@... with optional #ref)
    source: String,
    /// Subdirectory within the repository to use as theme root
    #[arg(long)]
    path: Option<String>,
    /// Override the installed theme directory name
    #[arg(long)]
    name: Option<String>,
    /// Overwrite existing theme directory
    #[arg(long)]
    force: bool,
},
```

Implementation in cmd_theme_install():
1. Parse source with parse_install_source().
2. Check if target name already exists in .zetl/themes/. If so, require --force or error (REQ-014-010).
3. Clone with clone_theme().
4. Read theme.toml from cloned files if present; validate manifest (REQ-014-002).
5. If min_zetl_version is present and current version is older, print warning.
6. Resolve final name with resolve_theme_name().
7. If --force and target exists, delete it.
8. Move/copy files to .zetl/themes/<name>/.
9. Write provenance with write_provenance().
10. Output JSON: { installed: { name, version, source, ref, path } }.

Path traversal checks per REQ-014-016: validate name and --path before any filesystem operations.

REQ-014-006 through REQ-014-011, REQ-014-015, REQ-014-016, CON-014-002.")
  (acceptance "zetl theme install user/repo clones and installs; --force overwrites; --name overrides name; --path extracts subdirectory; JSON output on success; clear errors for: network failure, repo not found, name collision without --force, invalid name, path traversal attempts; provenance file written; min_zetl_version warning shown when applicable"))

(normally r-ready-theme-install-cmd
  (and task-theme-install-cmd completed-provenance completed-verify-phase1)
  ready-theme-install-cmd)

(normally r-assign-theme-install-cmd
  (and ready-theme-install-cmd agent-claude-available)
