;; ════════════════════════════════════════════════════════════════════════════
;; IMPL-015: zetl fountain — Screenplay Theme and Scene Chaining
;; Implementation plan for SPEC-015 v0.3.0
;; ════════════════════════════════════════════════════════════════════════════

(meta plan
  (id "IMPL-015")
  (title "zetl fountain — Screenplay Theme and Scene Chaining")
  (version "0.1.0")
  (status "active")
  (created "2026-03-02")
  (author "agent:claude")
  (spec "SPEC-015")
  (description "Implement scene chaining via prev/next frontmatter fields and a bundled fountain theme for screenwriters. Phase 1: parse prev/next frontmatter, add ChainLink and chain metadata to PageContext, implement chain walking and head detection, add chain validation to zetl check, add conditional prev/next navigation to the default theme. Phase 2: create the bundled fountain theme with Courier Prime fonts, screenplay CSS, and enhanced scene navigation. Covers REQ-015-001 through REQ-015-007, NFR-015-001."))

;; ════════════════════════════════════════════════════════════════════════════
;; Agents
;; ════════════════════════════════════════════════════════════════════════════

(given agent-claude-available)

;; ════════════════════════════════════════════════════════════════════════════
;; Phase 1 — Scene Chaining and Page Context
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Parse prev/next from frontmatter ────────────────────────────────

(given task-parse-chain-frontmatter)
(given no-deps-parse-chain-frontmatter)

(meta task-parse-chain-frontmatter
  (description "Create src/web/chain.rs with helper functions to extract prev/next chain targets from frontmatter. extract_chain_target reads fm[field] as string, strips [[ ]] delimiters if present, strips alias text after pipe, strips heading refs after #, trims whitespace. Handles plain strings, wikilink syntax, aliased links, and heading refs. Also add resolve_page_name for case-insensitive slug lookup against page_slug_map. REQ-015-004, CON-015-001.")
  (acceptance "extract_chain_target handles plain, wikilink, aliased, and heading-ref formats. Returns None for missing or non-string fields. resolve_page_name does case-insensitive lookup. Unit tests cover all variants. cargo check passes."))

(normally r-ready-parse-chain-frontmatter
  (and task-parse-chain-frontmatter no-deps-parse-chain-frontmatter)
  ready-parse-chain-frontmatter)

(normally r-assign-parse-chain-frontmatter
  (and ready-parse-chain-frontmatter agent-claude-available)
  assign-to-parse-chain-frontmatter-claude)

;; ── Task: Add ChainLink and chain fields to PageContext ───────────────────

(given task-chain-page-context)

(meta task-chain-page-context
  (description "Add ChainLink struct and chain fields to PageContext in src/web/context.rs per CON-015-002. ChainLink has title and slug fields. PageContext gets five new fields: prev_page, next_page, chain_position, chain_length, chain_head_slug. Update build_page_context to call extract_chain_target for prev and next, resolve targets via page_slug_map, and build ChainLink values. Set chain_position and chain_length to None initially -- next task adds walking. REQ-015-007, CON-015-002.")
  (acceptance "ChainLink struct derives Serialize. PageContext has all five new fields. build_page_context populates prev_page and next_page when frontmatter contains prev/next. Fields are None when no chain data. Templates can access page.prev_page.title etc. cargo check passes. Existing tests pass."))

(normally r-ready-chain-page-context
  (and task-chain-page-context completed-parse-chain-frontmatter)
  ready-chain-page-context)

(normally r-assign-chain-page-context
  (and ready-chain-page-context agent-claude-available)
  assign-to-chain-page-context-claude)

;; ── Task: Chain walking and position calculation ──────────────────────────

(given task-chain-walking)

(meta task-chain-walking
  (description "Implement chain walking in src/web/chain.rs to compute chain_position, chain_length, and chain_head_slug. Add compute_chain_position that walks backward via prev pointers to find chain head, then forward to count total length. Returns position/length/head_slug tuple or None if not in a chain. Detect cycles by tracking visited pages. Cap at 1000 steps. Also add find_chain_heads to detect all pages with next but no prev. Update build_page_context to call compute_chain_position and populate the chain fields. REQ-015-005, REQ-015-007.")
  (acceptance "compute_chain_position returns correct position/length/head_slug for interior nodes, heads, and tails. Returns None for non-chain pages. Handles cycles gracefully. find_chain_heads correctly identifies pages with next but no prev. PageContext chain fields populated. Unit tests for 3-node chain, single node, cycle, broken chain."))

(normally r-ready-chain-walking
  (and task-chain-walking completed-chain-page-context)
  ready-chain-walking)

(normally r-assign-chain-walking
  (and ready-chain-walking agent-claude-available)
  assign-to-chain-walking-claude)

;; ── Task: Chain validation in zetl check ──────────────────────────────────

(given task-chain-validation)

(meta task-chain-validation
  (description "Add scene chain validation diagnostics to cmd_check in src/main.rs per REQ-015-006. Scan all files for prev/next frontmatter. Build forward and backward maps. Emit five diagnostic types: broken forward link as error, asymmetric chain as warning, cycle detection as error with path, fan-in / multiple predecessors as error, orphaned chain nodes as warning. Integrate with existing check output format. When --verbose, log chain summary per OBS-015-001: number of chains found and chain lengths. REQ-015-006, OBS-015-001.")
  (acceptance "zetl check reports all five diagnostic types correctly. Diagnostics integrate with existing output format. --verbose shows chain summary. cargo test passes."))

(normally r-ready-chain-validation
  (and task-chain-validation completed-chain-walking)
  ready-chain-validation)

(normally r-assign-chain-validation
  (and ready-chain-walking agent-claude-available)
  assign-to-chain-validation-claude)

;; ── Task: Prev/next navigation in default theme ───────────────────────────

(given task-prevnext-default-theme)

(meta task-prevnext-default-theme
  (description "Add conditional prev/next navigation to themes/default/page.html. Show a nav bar with left arrow link to prev_page, position indicator showing N of M, and right arrow link to next_page. Render at top and bottom of content area. Only show when page.prev_page or page.next_page exists. Use DaisyUI classes consistent with existing theme. REQ-015-003.")
  (acceptance "Prev/next navigation renders on pages with chain data. Does not render on non-chain pages. Arrows link to correct pages. Position indicator shows correctly. Works in serve and build modes. Existing theme appearance not broken."))

(normally r-ready-prevnext-default-theme
  (and task-prevnext-default-theme completed-chain-walking)
  ready-prevnext-default-theme)

(normally r-assign-prevnext-default-theme
  (and ready-prevnext-default-theme agent-claude-available)
  assign-to-prevnext-default-theme-claude)

;; ── Task: Integration tests for scene chaining ────────────────────────────

(given task-chain-integration-tests)

(meta task-chain-integration-tests
  (description "Add integration tests for scene chaining to tests/integration.rs. Test: basic 3-scene chain navigation with correct prev/next links and position in built HTML; chain head has no prev and shows 1 of 3; chain tail has no next; non-chain pages have no nav; wikilink syntax in frontmatter resolves correctly; zetl check reports broken chain errors; zetl check reports cycle errors; multi-chain vault works independently. TEST-015-003 through TEST-015-007.")
  (acceptance "All seven test scenarios pass. Tests cover happy path and error cases. Tests work with zetl build and zetl check. No regressions in existing integration tests."))

(normally r-ready-chain-integration-tests
  (and task-chain-integration-tests completed-chain-validation completed-prevnext-default-theme)
  ready-chain-integration-tests)

(normally r-assign-chain-integration-tests
  (and ready-chain-integration-tests agent-claude-available)
  assign-to-chain-integration-tests-claude)

;; ── Task: Verify Phase 1 ────────────────────────────────────────────────

(given task-verify-phase1)

(meta task-verify-phase1
  (description "End-to-end verification of Phase 1. Create 5-scene chain vault. Verify: serve shows prev/next nav with position indicators; build HTML contains correct links; zetl check passes on valid chain; broken chain reported; cycle reported; fan-in reported; non-chain pages have no nav; multi-chain vault works. cargo test passes. TEST-015-003 through TEST-015-007.")
  (acceptance "All scenarios pass. Chain navigation works in serve and build. Check diagnostics correct. No regressions."))

(normally r-ready-verify-phase1
  (and task-verify-phase1 completed-chain-integration-tests)
  ready-verify-phase1)

(normally r-assign-verify-phase1
  (and ready-verify-phase1 agent-claude-available)
  assign-to-verify-phase1-claude)

;; ════════════════════════════════════════════════════════════════════════════
;; Phase 2 — Fountain Theme
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Courier Prime font files ───────────────────────────────────────

(given task-courier-prime-fonts)

(meta task-courier-prime-fonts
  (description "Download and bundle Courier Prime WOFF2 font files for the fountain theme. Create themes/fountain/static/ with Regular, Italic, Bold, BoldItalic WOFF2 files and OFL.txt license. Fonts are approximately 30-50 KB each and will be embedded via include_dir at compile time. NFR-015-001.")
  (acceptance "Four WOFF2 files present in themes/fountain/static/. OFL.txt license included. Total font size under 200 KB. Files are valid WOFF2 format."))

(normally r-ready-courier-prime-fonts
  (and task-courier-prime-fonts completed-verify-phase1)
  ready-courier-prime-fonts)

(normally r-assign-courier-prime-fonts
  (and ready-courier-prime-fonts agent-claude-available)
  assign-to-courier-prime-fonts-claude)

;; ── Task: Fountain theme base template and CSS ───────────────────────────

(given task-fountain-base-template)

(meta task-fountain-base-template
  (description "Create themes/fountain/base.html and theme.toml. Base template: no CDN dependencies, self-contained. Loads Courier Prime via font-face from bundled WOFF2 files. Screenplay CSS: content area approx 6 inches wide, left margin wider than right, single-spaced, 12pt Courier Prime with fallback. Element CSS: scene headings uppercase bold, action left-aligned full width, character names centered approx 3.7 inches from left, dialogue centered approx 2.5 inches wide, parenthetical narrower than dialogue, transitions right-aligned uppercase. White page on grey background with dark mode support. Collapsible sidebar collapsed by default. REQ-015-001, REQ-015-002, ADR-015-001, ADR-015-003.")
  (acceptance "themes/fountain/base.html exists with all CSS. No external CDN requests. Courier Prime loaded via font-face. Screenplay elements approximately formatted. Dark mode works. Sidebar collapsible and collapsed by default. theme.toml is valid."))

(normally r-ready-fountain-base-template
  (and task-fountain-base-template completed-courier-prime-fonts)
  ready-fountain-base-template)

(normally r-assign-fountain-base-template
  (and ready-fountain-base-template agent-claude-available)
  assign-to-fountain-base-template-claude)

;; ── Task: Fountain page template with scene navigation ───────────────────

(given task-fountain-page-template)

(meta task-fountain-page-template
  (description "Create themes/fountain/page.html extending base.html. Enhanced prev/next scene navigation at top and bottom: prev arrow with title, position indicator showing Scene N of M, next arrow with title. Styled to match screenplay aesthetics. Sidebar shows scenes in chain order when page is part of a chain, falls back to alphabetical. Content area renders page.content_html within screenplay-formatted page. REQ-015-003.")
  (acceptance "Page renders with screenplay formatting. Prev/next navigation appears at top and bottom when chain data exists. Position indicator correct. Navigation hidden on non-chain pages. Sidebar lists scenes in chain order. Works in serve and build modes."))

(normally r-ready-fountain-page-template
  (and task-fountain-page-template completed-fountain-base-template)
  ready-fountain-page-template)

(normally r-assign-fountain-page-template
  (and ready-fountain-page-template agent-claude-available)
  assign-to-fountain-page-template-claude)

;; ── Task: Fountain index and folder templates ────────────────────────────

(given task-fountain-index-folder)

(meta task-fountain-index-folder
  (description "Create themes/fountain/index.html and folder.html extending base.html. Index page: vault landing with screenplay aesthetics, lists detected chain heads as Screenplays section, lists non-chain pages as Reference Pages, includes search functionality. Folder page: folder listing with screenplay aesthetic, shows which pages are part of chains. REQ-015-001.")
  (acceptance "index.html renders vault landing with screenplay theme. Chain heads listed as Screenplays. folder.html lists folder contents. Both work in serve and build modes. Search functionality works."))

(normally r-ready-fountain-index-folder
  (and task-fountain-index-folder completed-fountain-base-template)
  ready-fountain-index-folder)

(normally r-assign-fountain-index-folder
  (and ready-fountain-index-folder agent-claude-available)
  assign-to-fountain-index-folder-claude)

;; ── Task: Fountain theme integration tests ───────────────────────────────

(given task-fountain-integration-tests)

(meta task-fountain-integration-tests
  (description "Add integration tests for the fountain theme. Verify: zetl build --theme fountain produces HTML with Courier Prime font-face and no CDN URLs; WOFF2 fonts copied to _static/ in build output; 3-scene chain vault has prev/next navigation with correct links and positions; non-chain pages have no scene nav; zetl theme list shows fountain as bundled. TEST-015-001, TEST-015-002, TEST-015-003.")
  (acceptance "All five test scenarios pass. Fountain theme produces valid self-contained HTML. Fonts bundled correctly. Scene navigation present for chained pages."))

(normally r-ready-fountain-integration-tests
  (and task-fountain-integration-tests completed-fountain-page-template completed-fountain-index-folder)
  ready-fountain-integration-tests)

(normally r-assign-fountain-integration-tests
  (and ready-fountain-integration-tests agent-claude-available)
  assign-to-fountain-integration-tests-claude)

;; ── Task: Verify Phase 2 ────────────────────────────────────────────────

(given task-verify-phase2)

(meta task-verify-phase2
  (description "Final end-to-end verification. Verify: zetl serve --theme fountain renders screenplay pages with Courier Prime and grey background; scene headings uppercase bold, character names centered, dialogue narrower; prev/next nav with Scene N of M; sidebar collapsed by default, shows chain order when opened; dark mode works; zetl build --theme fountain produces self-contained static site with fonts in _static/ and no CDN refs; zetl theme list shows fountain; chaining works with both default and fountain themes; zetl check validates chains; non-chain pages normal; multi-chain vault works; cargo test passes. TEST-015-001 through TEST-015-007, NFR-015-001.")
  (acceptance "All 12 scenarios pass. Full SPEC-015 Phase 1 and Phase 2 compliance verified. No regressions."))

(normally r-ready-verify-phase2
  (and task-verify-phase2 completed-fountain-integration-tests)
  ready-verify-phase2)

(normally r-assign-verify-phase2
  (and ready-verify-phase2 agent-claude-available)
  assign-to-verify-phase2-claude)

