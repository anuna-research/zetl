;; TEST-demo-vault.spl — User testing plan for demo-vault happy paths
;; Tests all CLI commands, web UI, and collab features against demo-vault/

(meta plan
  (id "TEST-demo-vault")
  (title "Demo vault user testing — happy paths")
  (status "active")
  (description "Systematically test every zetl feature against demo-vault, fix bugs"))

;; ── Agent ──────────────────────────────────────────────────────────────
(given agent-claude-available)

;; ── CLI read-only commands ─────────────────────────────────────────────
(given task-cli-list)
(meta task-cli-list
  (description "Test: zetl list, zetl list -f table, zetl list --json")
  (acceptance "All output formats work, page count matches stats"))

(given task-cli-links)
(meta task-cli-links
  (description "Test: zetl links for pages with known forward links")
  (acceptance "Forward links listed correctly for Cache, Wikilinks"))

(given task-cli-backlinks)
(meta task-cli-backlinks
  (description "Test: zetl backlinks for heavily-linked pages")
  (acceptance "Backlinks match stats for Reasoning Engine, Link Graph"))

(given task-cli-search)
(meta task-cli-search
  (description "Test: zetl search with various queries")
  (acceptance "Finds expected results, handles no-match gracefully"))

(given task-cli-check)
(meta task-cli-check
  (description "Test: zetl check reports dead links, orphans, diagnostics")
  (acceptance "Dead links and orphans reported correctly"))

(given task-cli-stats)
(meta task-cli-stats
  (description "Test: zetl stats output is consistent with list/check")
  (acceptance "Page count, link count, dead links all consistent"))

(given task-cli-path)
(meta task-cli-path
  (description "Test: zetl path between connected and disconnected pages")
  (acceptance "Finds paths between connected pages, reports no-path for disconnected"))

(given task-cli-similar)
(meta task-cli-similar
  (description "Test: zetl similar finds near-duplicate page names")
  (acceptance "Finds similar pages without errors"))

(given task-cli-export)
(meta task-cli-export
  (description "Test: zetl export produces valid graph JSON")
  (acceptance "JSON parses, contains nodes and edges"))

(given task-cli-blocks)
(meta task-cli-blocks
  (description "Test: zetl blocks lists Merkle blocks for a page")
  (acceptance "Blocks listed with hashes, resolve by hash works"))

(given task-cli-diff)
(meta task-cli-diff
  (description "Test: zetl diff against HEAD~1")
  (acceptance "Diff output shows changes without errors"))

;; ── Web UI ─────────────────────────────────────────────────────────────
(given task-web-landing)
(meta task-web-landing
  (description "Test: landing page renders page grid with link counts")
  (acceptance "All pages visible, link counts match CLI"))

(given task-web-page-render)
(meta task-web-page-render
  (description "Test: page rendering with wikilinks, backlinks panel")
  (acceptance "Wikilinks clickable, backlinks shown, breadcrumbs correct"))

(given task-web-search)
(meta task-web-search
  (description "Test: search overlay finds pages")
  (acceptance "Search returns results matching CLI search"))

(given task-web-editor)
(meta task-web-editor
  (description "Test: editor loads, CodeMirror mounts, save works")
  (acceptance "Editor connected, content editable, save persists to disk"))

;; ── Collab mode ────────────────────────────────────────────────────────
(given task-collab-bootstrap)
(meta task-collab-bootstrap
  (description "Test: --collab --init-owner bootstrap flow")
  (acceptance "Owner created, bootstrap redirects to passkey register"))

(given task-collab-auth-redirect)
(meta task-collab-auth-redirect
  (description "Test: unauthenticated browser redirects to /auth/bootstrap")
  (acceptance "307 redirect for browsers, 401 for API"))

(given task-collab-save)
(meta task-collab-save
  (description "Test: save with CSRF token in collab mode")
  (acceptance "PUT with CSRF returns 200"))

;; ── Dependencies ───────────────────────────────────────────────────────
;; CLI tasks are independent (all ready immediately)
;; Web tasks depend on CLI sanity
(normally r-ready-web-landing (and task-web-landing completed-cli-stats) ready-web-landing)
(normally r-ready-web-page (and task-web-page-render completed-cli-links) ready-web-page-render)
(normally r-ready-web-search (and task-web-search completed-cli-search) ready-web-search)
(normally r-ready-web-editor (and task-web-editor completed-web-landing) ready-web-editor)

;; Collab depends on web working
(normally r-ready-collab-bootstrap (and task-collab-bootstrap completed-web-editor) ready-collab-bootstrap)
(normally r-ready-collab-redirect (and task-collab-auth-redirect completed-collab-bootstrap) ready-collab-auth-redirect)
(normally r-ready-collab-save (and task-collab-save completed-collab-auth-redirect) ready-collab-save)

;; ── CLI readiness (all ready immediately) ──────────────────────────────
(normally r-ready-cli-list task-cli-list ready-cli-list)
(normally r-ready-cli-links task-cli-links ready-cli-links)
(normally r-ready-cli-backlinks task-cli-backlinks ready-cli-backlinks)
(normally r-ready-cli-search task-cli-search ready-cli-search)
(normally r-ready-cli-check task-cli-check ready-cli-check)
(normally r-ready-cli-stats task-cli-stats ready-cli-stats)
(normally r-ready-cli-path task-cli-path ready-cli-path)
(normally r-ready-cli-similar task-cli-similar ready-cli-similar)
(normally r-ready-cli-export task-cli-export ready-cli-export)
(normally r-ready-cli-blocks task-cli-blocks ready-cli-blocks)
(normally r-ready-cli-diff task-cli-diff ready-cli-diff)

;; ── Assignment (all to claude) ─────────────────────────────────────────
(normally r-assign-cli-list (and ready-cli-list agent-claude-available) assign-to-cli-list-claude)
(normally r-assign-cli-links (and ready-cli-links agent-claude-available) assign-to-cli-links-claude)
(normally r-assign-cli-backlinks (and ready-cli-backlinks agent-claude-available) assign-to-cli-backlinks-claude)
(normally r-assign-cli-search (and ready-cli-search agent-claude-available) assign-to-cli-search-claude)
(normally r-assign-cli-check (and ready-cli-check agent-claude-available) assign-to-cli-check-claude)
(normally r-assign-cli-stats (and ready-cli-stats agent-claude-available) assign-to-cli-stats-claude)
(normally r-assign-cli-path (and ready-cli-path agent-claude-available) assign-to-cli-path-claude)
(normally r-assign-cli-similar (and ready-cli-similar agent-claude-available) assign-to-cli-similar-claude)
(normally r-assign-cli-export (and ready-cli-export agent-claude-available) assign-to-cli-export-claude)
(normally r-assign-cli-blocks (and ready-cli-blocks agent-claude-available) assign-to-cli-blocks-claude)
(normally r-assign-cli-diff (and ready-cli-diff agent-claude-available) assign-to-cli-diff-claude)

(normally r-assign-web-landing (and ready-web-landing agent-claude-available) assign-to-web-landing-claude)
(normally r-assign-web-page (and ready-web-page-render agent-claude-available) assign-to-web-page-render-claude)
(normally r-assign-web-search (and ready-web-search agent-claude-available) assign-to-web-search-claude)
(normally r-assign-web-editor (and ready-web-editor agent-claude-available) assign-to-web-editor-claude)

(normally r-assign-collab-bootstrap (and ready-collab-bootstrap agent-claude-available) assign-to-collab-bootstrap-claude)
(normally r-assign-collab-redirect (and ready-collab-auth-redirect agent-claude-available) assign-to-collab-auth-redirect-claude)
(normally r-assign-collab-save (and ready-collab-save agent-claude-available) assign-to-collab-save-claude)

(claims agent:ed25519:xfRAzZFG
  :at "2026-03-20T01:00:00Z"
  (given claim-v1-cli-list)
  (normally r-cl-state-v1-cli-list claim-v1-cli-list state-claimed-v1-cli-list)
  (normally r-cl-chain-v1-cli-list state-claimed-v1-cli-list claimed-cli-list)
)

(claims agent:ed25519:xfRAzZFG
  :at "2026-03-20T01:00:00Z"
  (given claim-v1-cli-links)
  (normally r-cl-state-v1-cli-links claim-v1-cli-links state-claimed-v1-cli-links)
  (normally r-cl-chain-v1-cli-links state-claimed-v1-cli-links claimed-cli-links)
)

;; Propagation rules: failures in 'cli-links' block downstream tasks
(normally r-propagate-web-page-render-from-cli-links-failed failed-cli-links upstream-blocked-web-page-render)
