  (reqs "REQ-020-050"))

(given task-page-comments)
(meta task-page-comments
  (description "Implement page comments: sidecar storage in .ztl/comments/<slug>.json, comment sidebar, WebSocket broadcast, ACL-gated, 30-day auto-prune")
  (acceptance "TEST-020-051 passes; comments appear in real time; pruned after 30 days")
