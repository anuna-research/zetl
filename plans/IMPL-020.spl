;; ============================================================
;; Phase 8: Security Hardening
;; REQ-020-055 through REQ-020-067
;; ============================================================

(given task-mnemonic-security)
(meta task-mnemonic-security
  (description "Implement mnemonic display security: CSP header, user-select:none, auto-clear DOM after 5min, one-time serve, clipboard clear after 60s")
  (acceptance "TEST-020-056 passes; CSP present; DOM auto-clears; reload fails")
  (phase "8")
  (reqs "REQ-020-056"))

(given task-server-key-protection)
(meta task-server-key-protection
  (description "Implement server key protection: 0600 permissions on creation, auto-add .ztl/collab/, .ztl/users/, .ztl/sessions/ to .gitignore, permission check on startup")
  (acceptance "TEST-020-057 passes; .gitignore updated; WARN on permissive file permissions")
  (phase "8")
  (reqs "REQ-020-057"))

(given task-owner-hardening)
(meta task-owner-hardening
  (description "Implement owner fact stripping: strip (given (owner ...)) from access.spl and page SPL; inject owner only from profile.json; WARN on stripped facts")
  (acceptance "TEST-020-058 passes; access.spl owner assertion ignored; owner privileges only from profile")
  (phase "8")
  (reqs "REQ-020-058"))

(given task-spl-sandbox)
(meta task-spl-sandbox
  (description "Implement page-level SPL sandboxing: validate on re-scan; allow only own-page access conclusions; strip global predicates (owner/admin/role/scope/visibility-mode/is-agent) with WARN")
  (acceptance "TEST-020-059 passes; page cannot assert admin/owner; can restrict own page access")
  (phase "8")
  (reqs "REQ-020-059"))

(given task-rate-limiting)
(given security-sensitive-rate-limiting)
(meta task-rate-limiting
  (description "Implement authentication rate limiting: per-user and per-IP limits on login, recovery, invitation, and agent token endpoints; in-memory counters; 429 responses")
  (acceptance "TEST-020-060 passes; 6th failed recovery returns 429; counters reset after window")
  (phase "8")
  (reqs "REQ-020-060"))

(given task-ws-ticket)
(meta task-ws-ticket
  (description "Implement WebSocket ticket auth: POST /auth/ws-ticket issues 30s one-time ticket; WS validates and invalidates; prevents bearer tokens in logs")
  (acceptance "TEST-020-061 passes; ticket single-use; expired ticket rejected; logs show ticket not bearer")
  (phase "8")
  (reqs "REQ-020-061"))

(given task-challenge-expiry)
(meta task-challenge-expiry
  (description "Implement recovery challenge expiry: 5-minute TTL, max 3 active per user, lazy pruning, 410 Gone on expired")
  (acceptance "TEST-020-062 passes; expired challenge returns 410; max 3 concurrent challenges")
  (phase "8")
  (reqs "REQ-020-062"))

(given task-csp-headers)
(meta task-csp-headers
  (description "Implement Content-Security-Policy header on all HTML responses: script-src 'self', frame-ancestors 'none', connect-src 'self' wss:")
  (acceptance "TEST-020-063 passes; CSP header present on all pages; inline scripts blocked")
  (phase "8")
  (reqs "REQ-020-063"))

(given task-csrf)
(meta task-csrf
  (description "Implement CSRF protection: issue token with session, require X-CSRF-Token header on PUT/POST/DELETE, exempt Bearer auth and WebSocket")
  (acceptance "TEST-020-064 passes; PUT without CSRF token → 403; Bearer-authed API calls exempt")
  (phase "8")
  (reqs "REQ-020-064"))

(given task-admin-hardcode)
(meta task-admin-hardcode
  (description "Implement hardcoded admin check on /_admin/* routes: profile-based owner||admin check before SPL evaluation; not defeatable by policy")
  (acceptance "TEST-020-065 passes; non-admin blocked even with permissive SPL")
  (phase "8")
  (reqs "REQ-020-065"))

(given task-comment-integrity)
(meta task-comment-integrity
  (description "Implement comment HMAC integrity: HMAC-SHA256(server_key, user_id||text||at) per comment; verify on read; (unverified) badge on tampered comments")
  (acceptance "TEST-020-066 passes; tampered comment shows unverified badge")
  (phase "8")
  (reqs "REQ-020-066"))

(given task-tls-warning)
(meta task-tls-warning
  (description "Implement TLS enforcement: refuse --collab on non-loopback without ztl_INSECURE_COLLAB=1; WARN on startup; no warning on localhost")
  (acceptance "TEST-020-067 passes; non-loopback without env var exits with error; localhost works")
  (phase "8")
  (reqs "REQ-020-067"))

;; Phase 8 readiness — security tasks depend on the features they harden
(normally r-ready-mnemonic-security
  (and task-mnemonic-security completed-recovery-ux)
  ready-mnemonic-security)

(normally r-ready-server-key-protection
  (and task-server-key-protection completed-invitation-gen)
  ready-server-key-protection)

(normally r-ready-owner-hardening
  (and task-owner-hardening completed-acl-pipeline)
  ready-owner-hardening)

(normally r-ready-spl-sandbox
  (and task-spl-sandbox completed-acl-pipeline completed-spl-rehash)
  ready-spl-sandbox)

(normally r-ready-rate-limiting
  (and task-rate-limiting completed-passkey-auth completed-bip39-recovery completed-agent-token)
  ready-rate-limiting)

(normally r-ready-ws-ticket
  (and task-ws-ticket completed-ws-protocol completed-agent-token)
  ready-ws-ticket)

(normally r-ready-challenge-expiry
  (and task-challenge-expiry completed-bip39-recovery)
  ready-challenge-expiry)

(normally r-ready-csp-headers
  (and task-csp-headers completed-collab-gate)
  ready-csp-headers)

(normally r-ready-csrf
  (and task-csrf completed-session-mgmt completed-agent-token)
  ready-csrf)

(normally r-ready-admin-hardcode
  (and task-admin-hardcode completed-permission-ui completed-web-invite)
  ready-admin-hardcode)

(normally r-ready-comment-integrity
  (and task-comment-integrity completed-page-comments)
  ready-comment-integrity)

(normally r-ready-tls-warning
  (and task-tls-warning completed-collab-gate)
  ready-tls-warning)

