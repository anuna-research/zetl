  (reqs "REQ-020-051"))

(given task-merge-notification)
(meta task-merge-notification
  (description "Implement agent merge notification in editor: external-merge WebSocket message, banner with summary, changed range highlighting, review button for large merges")
  (acceptance "TEST-020-052 passes; banner shows source and summary; changed ranges highlighted briefly")
