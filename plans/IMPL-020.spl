  (and ready-ws-ticket agent-security-available)
  assign-to-ws-ticket-security)

(normally r-assign-challenge-expiry
  (and ready-challenge-expiry agent-backend-available)
  assign-to-challenge-expiry-backend)

(normally r-assign-csp-headers
  (and ready-csp-headers agent-security-available)
  assign-to-csp-headers-security)

(normally r-assign-csrf
  (and ready-csrf agent-security-available)
  assign-to-csrf-security)

(normally r-assign-admin-hardcode
  (and ready-admin-hardcode agent-security-available)
