  (reqs "REQ-020-052"))

(given task-page-history-ui)
(meta task-page-history-ui
  (description "Implement /{slug}/_history: chronological edit list from git log, author/timestamp/message, diff view, restore button, draft indicator for active CRDT")
  (acceptance "TEST-020-053 passes; diff view renders correctly; restore creates new commit")
