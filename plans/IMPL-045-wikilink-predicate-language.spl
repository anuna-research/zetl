;; IMPL-045: Wikilink Predicate Language — typed named edges
;; Implements SPEC-045 v0.1.9 (committed v1 surface).

(meta plan
  (id "IMPL-045")
  (title "Wikilink Predicate Language")
  (version "1.0.0")
  (status "active")
  (created "2026-06-09")
  (author "agent:claude")
  (spec "SPEC-045")
  (description "Implement SPEC-045 typed named edges of the shape predicate::[[Target]] layered additively on the existing wikilink graph. Core path: recognise the predicate at the scanner parse boundary and carry it as an OPTIONAL field on WikiLink + the zetl-ext AST Wikilink node (bare link = empty predicates = untyped, full backward compat); expand each typed link into one directed EdgeMeta.predicate edge per predicate in the LinkGraph; type backlinks/dead-links/orphans; capture list-item annotations; ship `zetl edges` query CLI; predicate lints in `zetl check`; OPTIONAL strict `.zetl/predicates.toml`; project typed edges to provenance-tagged SPL facts under --features reason; expose page.edges/edges_by_predicate/backlinks_by_predicate/vault.predicates template vars + typed backlink render; predicate search field; typed graph-data feed (predicate/annotation, multi:true) + filter/colour/legend styling in the graph widget; RDF export (jsonld/turtle/ntriples) with PROV-O/SKOS; read-only tags->predicate migration helper. v1 excludes the materialised named-inverse (Q4, reserved null field) and CURIE->SPL projection."))

;; ── Agents ──────────────────────────────────────────────
(given agent-claude-available)

;; ── Tasks (Phase 1: core data model + parse) ────────────
(given task-ast-predicates)
(given task-scanner-grammar)
(given task-graph-edges)
(given task-annotation-capture)

;; ── Tasks (Phase 2: CLI + governance) ───────────────────
(given task-predicates-toml)
(given task-edges-cli)
(given task-check-lints)

;; ── Tasks (Phase 3: consumers) ──────────────────────────
(given task-spl-projection)
(given task-template-vars)
(given task-backlink-render)
(given task-search-predicate)
(given task-graph-feed)
(given task-graph-styling)
(given task-rdf-export)
(given task-migrate-helper)

;; root tasks have no upstream dependency
(given no-deps-ast-predicates)
(given no-deps-scanner-grammar)
(given no-deps-predicates-toml)

;; ── Task metadata ───────────────────────────────────────
(meta task-ast-predicates
  (description "REQ-4503/CON-4505: add OPTIONAL `predicates` array of {predicate, inverse:null} specs to the zetl-ext AST Wikilink node (src/hooks/ast/mod.rs) + tools/zetl-ast-schema-v1.json; bump ast_version 1.0->1.1; Embed node unchanged (ADR-4501). Additive round-trip property test.")
  (acceptance "Wikilink node carries predicates; schema pattern enforces snake|CURIE; existing hooks round-trip unchanged; ast_version=1.1; tests green."))
(meta task-scanner-grammar
  (description "REQ-4501/4502/CON-4501: recognise `1*(predicate '::') [[Target]]` named-edge grammar in src/scanner.rs extract_wikilinks (and parse.rs). Snake + CURIE predicates, multi-predicate chaining on ::, order-insensitive dedup set. Conservative LangSec disposition table (space/triple-colon/uppercase/slash -> text or syntax diagnostic). Add predicates field to types.rs WikiLink.")
  (acceptance "Disposition table from CON-4501 fully covered by unit tests; no phantom edges from malformed tokens; bare links unchanged."))
(meta task-graph-edges
  (description "REQ-4506: EdgeMeta gains predicate:Option<String> + annotation:Option<String>; LinkGraph::build expands a K-predicate link to K directed edges (untyped link = one untyped edge), dedup key (source,target,predicate); BacklinkResult/DeadLink/Orphan carry predicate+annotation. REQ-4514 typed ghost edges.")
  (acceptance "Typed edges in graph; typed backlinks/dead-links carry predicate; untyped vault byte-identical to before; tests green."))
(meta task-annotation-capture
  (description "REQ-4504: capture nested list-item block content under a list-item named edge as the edge annotation, attached at EdgeMeta.annotation. Available to edges CLI + backlink renderer. Absence = null, not error.")
  (acceptance "Indented sub-bullet under `- pred::[[X]]` becomes EdgeMeta.annotation; no annotation = null; test covers HP2."))
(meta task-predicates-toml
  (description "REQ-4507/CON-4502: OPTIONAL strict-vocabulary file `.zetl/predicates.toml` parser. Absent=emergent default. Fields: enforce, accept_is_a, [prefixes], [predicates] with display/category/maps_to/construction/catch_all. deny_unknown_fields top-level; governance/presentation only, no semantics. Never seeded.")
  (acceptance "File parses to typed struct; absent file = emergent; malformed = config error; no semantic fields accepted; tests green."))
(meta task-edges-cli
  (description "REQ-4509/CON-4503/ADR-4506: new `zetl edges` Command variant. Filters --predicate(repeat)/--from/--to/--by-predicate/--untyped/--annotated; -f auto|json|table. Read-only, idempotent, superset of `zetl links`. JSON row {source,target,predicate|null,annotation|null,line,is_ghost}.")
  (acceptance "All filters work; --by-predicate histogram; no filter = superset of links; unknown predicate = zero rows not error; tests green."))
(meta task-check-lints
  (description "REQ-4508: predicate lints in `zetl check` over observed usage: predicate-drift (Levenshtein<=2 freq-asymmetry), predicate-relates-to-overuse, predicate-prefer-conforms-to (ADR-4503), predicate-undeclared-prefix, predicate-duplicate. Strict-file: predicate-undeclared escalates to error under enforce=true, warn under false.")
  (acceptance "Each lint fires on its trigger; emergent default never errors w/o --fail-on; strict enforce=true errors on undeclared; tests green."))
(meta task-spl-projection
  (description "REQ-4510/CON-4504/ADR-4504: under --features reason project each typed SNAKE edge to fact (predicate \"source\" \"target\") with _source_file/_source_line/_source_page provenance via src/reason/mod.rs. Untyped + CURIE excluded. Deterministic/order-stable. Threat-Model-A provenance.")
  (acceptance "Snake edges -> provenance-tagged facts; untyped/CURIE skipped; deterministic; default build pays nothing; feature-gated test green."))
(meta task-template-vars
  (description "REQ-4515/CON-4506: PageContext gains page.edges, page.edges_by_predicate (sentinel __untyped key), backlinks extended with predicate/label/annotation, page.backlinks_by_predicate, VaultContext.vault.predicates. Auto-label fn (local part, _/- -> space, capitalise). Additive, Chainable undefined behaviour for missing.")
  (acceptance "Template vars serialise per CON-4506; __untyped sentinel; auto-label correct; existing themes unaffected; tests green."))
(meta task-backlink-render
  (description "REQ-4511: zetl build web output renders the backlink panel grouped by predicate from the REQ-4515 vars, auto-derived label + count, annotation inline (progressive disclosure). Untyped 'see also' last; no typed backlink = pre-SPEC-045 flat list.")
  (acceptance "Grouped typed backlink panel renders; annotation surfaces; zero-typed vault renders flat list; test green."))
(meta task-search-predicate
  (description "REQ-4512: search index (src/search_index.rs) gains a faceted `predicate` field (STRING|STORED) capturing a page's outgoing typed-edge predicates. Additive, re-index on upgrade; existing fields unchanged.")
  (acceptance "Predicate field indexed + filterable; existing search unchanged; test green."))
(meta task-graph-feed
  (description "REQ-4517/CON-4508: graph-data feed (SPEC-028/037) carries per-edge predicate(null) + annotation(null) under attributes; graphology options.multi:true with predicate-qualified edge keys for K parallel edges; backward-compatible superset of CON-101 (byte-identical when no typed edges).")
  (acceptance "Feed carries predicate/annotation; multi:true keys; no-typed-edge feed unchanged from CON-101; test green."))
(meta task-graph-styling
  (description "REQ-4518: interactive graph view consumes the feed for typed-edge filtering (multi-select per predicate + untyped bucket), predicate legend w/ colour swatch + toggle + counts, colour-by-predicate (category when strict), directed arrowheads, annotation on hover. Within SPEC-028 FPS/LCP budgets; no-typed-edge = unchanged view.")
  (acceptance "Filter/legend/colour/arrowhead/hover behaviour present; default all-visible; no-typed-edge unchanged; budgets respected."))
(meta task-rdf-export
  (description "REQ-4516/CON-4507: `zetl export --format {jsonld,turtle,ntriples}` projecting typed edges to triples: vault-namespace IRIs, CURIE/maps_to expansion via [prefixes], annotation as rdfs:comment, provenance as PROV-O, predicate vocabulary as SKOS scheme. No SPARQL endpoint.")
  (acceptance "Three RDF serialisations emit valid triples w/ PROV-O + SKOS; CURIE expansion via prefixes; test green."))
(meta task-migrate-helper
  (description "REQ-4513/ADR-4505: `zetl predicates migrate --dry-run` scans frontmatter tags: (and configured scalar-list keys), REPORTS (file, tag, candidate predicate, candidate target page) without rewriting. Without --dry-run refuse + print dry-run-only.")
  (acceptance "Dry-run report lists candidate conversions; no file modified; non-dry-run refuses; test green."))

