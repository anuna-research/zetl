(normally r-propagate-update-graph-tests-from-nest-graph-html-failed failed-nest-graph-html upstream-blocked-update-graph-tests)
(normally r-propagate-update-graph-tests-from-nest-graph-html-permanently-failed permanently-failed-nest-graph-html upstream-blocked-update-graph-tests)
(normally r-propagate-update-graph-tests-from-nest-graph-html-stale-v1 stale-v1-nest-graph-html upstream-blocked-update-graph-tests)
(normally r-propagate-update-graph-tests-from-nest-graph-html-timeout-v1 timeout-v1-nest-graph-html upstream-blocked-update-graph-tests)
(normally r-propagate-update-graph-tests-from-nest-graph-html-blocked upstream-blocked-nest-graph-html upstream-blocked-update-graph-tests)

(claims agent:claude
  :at "2026-05-04T10:36:30Z"
