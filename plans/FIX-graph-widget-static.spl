(normally r-propagate-verify-cargo-from-update-graph-tests-permanently-failed permanently-failed-update-graph-tests upstream-blocked-verify-cargo)
(normally r-propagate-verify-cargo-from-update-graph-tests-stale-v1 stale-v1-update-graph-tests upstream-blocked-verify-cargo)
(normally r-propagate-verify-cargo-from-update-graph-tests-timeout-v1 timeout-v1-update-graph-tests upstream-blocked-verify-cargo)

(claims agent:claude
  :at "2026-05-04T10:37:46Z"
  (given completed-update-graph-tests))

(claims agent:claude
  :at "2026-05-04T10:37:46Z"
