  (description "Graph interactivity lives in a frontend JS module.")
  (justification "Sigma/graph lib calls + keyboard handlers are frontend concerns."))
(meta r-a-reserved-underscore-routes
  (description "Route-reservation change lives in src/web/mod.rs.")
  (justification "Router dispatch + 404 is a backend change."))
(meta r-a-sidebar-actions-group
  (description "Visual hierarchy change — designer leads, frontend ships.")
  (justification "Group-with-icons is a design decision about weight + spacing."))

