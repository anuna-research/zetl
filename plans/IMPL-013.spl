;; ════════════════════════════════════════════════════════════════════════════
;; Phase 3 — Serve Mode Browser Search
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Goal: Add GET /api/search to ztl serve that queries the Tantivy index.
;; Upgrade the Cmd+K modal from fuzzy page-name matching to full-text
;; ranked search with heading context. The Tantivy index is opened at
;; server startup and held in WebState.
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Add Tantivy index to WebState ───────────────────────────────────

(given task-tantivy-webstate)

(meta task-tantivy-webstate
  (description "Extend WebState in src/web/mod.rs to hold a Tantivy IndexReader. During server startup in cmd_serve():

  1. Build or open the Tantivy search index (same logic as ztl index).
  2. Obtain an IndexReader from the SearchIndex.
  3. Store the reader (or the SearchIndex itself) in WebState alongside the existing VaultData.

The IndexReader is thread-safe and can be shared across requests via Arc. When the vault is re-indexed (e.g., on file change in watch mode), the reader should be refreshed or rebuilt.

WebState addition:
  pub struct WebState {
      pub data: Arc<RwLock<VaultData>>,
      pub vault_root: Arc<PathBuf>,
      pub search_index: Arc<SearchIndex>,  // NEW
  }

REQ-013-012.")
  (acceptance "WebState holds SearchIndex; index built at server startup; search queries executable from the web context; cargo check passes"))

(normally r-ready-tantivy-webstate
  (and task-tantivy-webstate completed-verify-phase2)
  ready-tantivy-webstate)

(normally r-assign-tantivy-webstate
  (and ready-tantivy-webstate agent-claude-available)
  assign-to-tantivy-webstate-claude)

;; ── Task: Create /api/search endpoint ─────────────────────────────────────

(given task-api-search)

(meta task-api-search
  (description "Add GET /api/search route to the Axum router in src/web/routes.rs (or a new api.rs module).

Query parameters per CON-013-003:
  - q (required): search query string
  - limit (optional, default 20): max results

Response (200 OK):
  Content-Type: application/json
  Body: SearchOutput JSON (same schema as CLI output, without near/depth/neighbourhood_size — graph scoping is CLI-only for v1)

Response (400 Bad Request):
  Empty or whitespace-only q parameter.

Implementation:
  1. Extract q and limit from query string.
  2. Validate q is non-empty.
  3. Query SearchIndex with q and limit.
  4. For each matched document, re-scan for line-level positions and headings (same logic as CLI search).
  5. Serialize SearchOutput to JSON and return.

The handler reads from the SearchIndex stored in WebState. No graph scoping in serve API for v1.

NFR-013-007: ≤50ms latency for 10,000 indexed documents (95th percentile).

REQ-013-012, CON-013-003.")
  (acceptance "/api/search?q=term returns 200 with JSON SearchOutput; results BM25-scored with heading context; empty query returns 400; limit parameter works; latency under 50ms for reasonable corpus"))

(normally r-ready-api-search
  (and task-api-search completed-tantivy-webstate)
  ready-api-search)

(normally r-assign-api-search
  (and ready-api-search agent-claude-available)
  assign-to-api-search-claude)

;; ── Task: Upgrade Cmd+K modal for serve mode ──────────────────────────────

(given task-serve-cmdk)

(meta task-serve-cmdk
  (description "Upgrade the existing Cmd+K search modal in the serve mode HTML (src/web/html.rs or the base template if IMPL-012 has landed) to query /api/search instead of filtering the sidebar page list.

Current behavior: The Cmd+K modal filters a pre-built JSON array of page names client-side (fuzzy match on name only).

New behavior per REQ-013-013:
  1. On keyup in the search input, debounce 150ms, then fetch GET /api/search?q=<input>&limit=20.
  2. Display results showing: page name, heading (if present), context snippet, and BM25 score.
  3. Keyboard navigation: arrow keys to move between results, Enter to navigate to the selected page.
  4. Show a loading indicator while the fetch is in flight.
  5. Clear results when input is cleared.

The existing page-name fuzzy filter can be kept as a fast fallback for very short queries (≤2 chars) or shown while waiting for the API response.

Result display format:
  <div class='search-result'>
    <span class='page-name'>Page Name</span>
    <span class='heading'>## Heading</span>
    <span class='context'>...matching context...</span>
    <span class='score'>8.72</span>
  </div>

REQ-013-013.")
  (acceptance "Cmd+K modal shows full-text search results from /api/search; debounced at 150ms; results show page name, heading, context, score; keyboard navigation works; Enter navigates to page"))

(normally r-ready-serve-cmdk
  (and task-serve-cmdk completed-api-search)
  ready-serve-cmdk)

(normally r-assign-serve-cmdk
  (and ready-serve-cmdk agent-claude-available)
  assign-to-serve-cmdk-claude)

;; ── Task: Verify Phase 3 ─────────────────────────────────────────────────

(given task-verify-phase3)

(meta task-verify-phase3
  (description "End-to-end verification of serve mode search:

  1. Start ztl serve with an indexed vault.
  2. GET /api/search?q=algorithm returns 200 with BM25-scored results, heading context (TEST-013-012).
  3. GET /api/search?q= returns 400 (TEST-013-012).
  4. GET /api/search?q=test&limit=3 returns at most 3 results (TEST-013-012).
  5. Cmd+K modal shows full-text results with page, heading, context, score (TEST-013-013).
  6. Keyboard navigation in modal works (TEST-013-013).
  7. All Phase 1 and Phase 2 tests still pass.

TEST-013-012, TEST-013-013.")
  (acceptance "API endpoint returns correct results; Cmd+K modal functional; no regressions"))

(normally r-ready-verify-phase3
  (and task-verify-phase3 completed-serve-cmdk)
  ready-verify-phase3)

(normally r-assign-verify-phase3
  (and ready-verify-phase3 agent-claude-available)
  assign-to-verify-phase3-claude)

;; ════════════════════════════════════════════════════════════════════════════
;; Phase 4 — Build Mode Static Search
;; ════════════════════════════════════════════════════════════════════════════
;;
;; Goal: Emit search-index.json during ztl build with compact BM25 data.
;; Embed a ~50-line JS BM25 scorer in the layout HTML. Upgrade build mode
;; Cmd+K to perform client-side full-text search with no backend.
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Generate search-index.json during build ─────────────────────────

(given task-search-index-json)

(meta task-search-index-json
  (description "Extend build_static() in src/web/build.rs to emit search-index.json in the output directory root. Extract corpus statistics from the Tantivy index (or directly from the parsed files).

Schema per CON-013-004:
{
  'avgDl': <number>,             // average document length (total terms)
  'docs': [
    {
      'n': '<page_name>',        // page name
      's': '<slug>',             // URL slug
      'dl': <doc_length>,        // total terms in document
      'tf': { '<term>': <count>, ... }  // term frequency map
    }
  ],
  'df': { '<term>': <doc_count>, ... }  // document frequency per term
}

To generate term frequencies: tokenize each document's body text using the same tokenization as Tantivy (lowercase, split on whitespace/punctuation). Count term occurrences per document. Compute document frequency (number of documents containing each term). Compute average document length.

Short field names (n, s, dl, tf, df) minimize JSON size per NFR-013-006 (≤30% of vault text content).

The file is written to {out_dir}/search-index.json.

REQ-013-014, CON-013-004, ADR-013-004.")
  (acceptance "search-index.json emitted in build output; contains avgDl, docs array with n/s/dl/tf per doc, df map; term frequencies match body text; cargo check passes"))

(normally r-ready-search-index-json
  (and task-search-index-json completed-verify-phase2)
  ready-search-index-json)

(normally r-assign-search-index-json
  (and ready-search-index-json agent-claude-available)
  assign-to-search-index-json-claude)

;; ── Task: Embed BM25 scorer JS in build layout ───────────────────────────

(given task-bm25-js)

(meta task-bm25-js
  (description "Embed a ~50-line inline JavaScript BM25 scorer in the build mode HTML layout. The scorer implements the standard BM25 formula per SPEC-013 §4.9:

  score(q, d) = Σ IDF(t) * (tf(t,d) * (k1 + 1)) / (tf(t,d) + k1 * (1 - b + b * dl/avgDl))

  where k1 = 1.2, b = 0.75
  IDF(t) = ln((N - df(t) + 0.5) / (df(t) + 0.5) + 1)

The JS module should:
  1. Expose a search(query, index) function.
  2. Tokenize the query (lowercase, split on whitespace/punctuation — same as Tantivy's default).
  3. For each document, compute BM25 score against query terms.
  4. Return results sorted by descending score, filtered to score > 0.

The scorer is embedded via include_str!() of a .js file or inline in the HTML template. Store the JS in src/web/assets/bm25.js or similar.

ADR-013-004.")
  (acceptance "BM25 scorer is valid JavaScript; produces correct scores for known inputs; matches Tantivy BM25 formula; tokenization consistent with server-side; ~50 lines"))

(normally r-ready-bm25-js
  (and task-bm25-js completed-search-index-json)
  ready-bm25-js)

(normally r-assign-bm25-js
  (and ready-bm25-js agent-claude-available)
  assign-to-bm25-js-claude)

;; ── Task: Upgrade build mode Cmd+K to full-text search ────────────────────

(given task-build-cmdk)

(meta task-build-cmdk
  (description "Upgrade the Cmd+K modal in the build mode HTML to use client-side full-text search per REQ-013-015:

  1. On first Cmd+K activation, lazy-fetch search-index.json and cache it in memory.
  2. On keyup (debounced 150ms), tokenize the query and run the BM25 scorer against the cached index.
  3. Display top results showing page name and BM25 score.
  4. Arrow keys navigate results, Enter follows link to the page slug.
  5. Target: results within 100ms of keystroke for indexes under 10,000 documents.

The existing page-name fuzzy filter is replaced entirely — the BM25 scorer handles page name matches because page names are part of the indexed body text.

For build mode, heading context and line-level positions are NOT available in the static index (deferred to v2 per Open Question #4). Results show page name and score only.

REQ-013-015, ADR-013-004.")
  (acceptance "Build mode Cmd+K fetches search-index.json lazily; full-text BM25 search works client-side; results sorted by score; navigation works; responsive under 100ms for reasonable corpus"))

(normally r-ready-build-cmdk
  (and task-build-cmdk completed-bm25-js)
  ready-build-cmdk)

(normally r-assign-build-cmdk
  (and ready-build-cmdk agent-claude-available)
  assign-to-build-cmdk-claude)

;; ── Task: Verify Phase 4 ─────────────────────────────────────────────────

(given task-verify-phase4)

(meta task-verify-phase4
  (description "End-to-end verification of build mode search:

  1. ztl build emits search-index.json in output directory (TEST-013-014).
  2. search-index.json contains avgDl, docs (correct count), df (TEST-013-014).
  3. Each doc has n, s, dl, tf with correct term frequencies (TEST-013-014).
  4. Open built static site in browser, press Cmd+K — search-index.json fetched (TEST-013-015).
  5. Type a query — results ranked by BM25 score (TEST-013-015).
  6. Navigate results with keyboard and click to follow (TEST-013-015).
  7. All Phase 1, 2, 3 tests still pass.

TEST-013-014, TEST-013-015.")
  (acceptance "search-index.json correct; client-side search functional; BM25 ranking works; no regressions"))

(normally r-ready-verify-phase4
  (and task-verify-phase4 completed-build-cmdk)
  ready-verify-phase4)

(normally r-assign-verify-phase4
  (and ready-verify-phase4 agent-claude-available)
  assign-to-verify-phase4-claude)

;; ════════════════════════════════════════════════════════════════════════════
;; Final — Integration Verification
;; ════════════════════════════════════════════════════════════════════════════

;; ── Task: Full integration test ───────────────────────────────────────────

(given task-integration-test)

(meta task-integration-test
  (description "Comprehensive integration test covering the full SPEC-013 feature set. Create or use a test vault with: multiple pages with known content, known link structure, headings at various levels, exclusion zones (code blocks, frontmatter with searchable terms, HTML comments), and at least one isolated page.

Verify:
  1. ztl index builds both link graph and search index.
  2. ztl search returns BM25-scored results with heading context — relevance ranking correct.
  3. Exclusion zones: frontmatter/code/comments not indexed.
  4. --near restricts to neighbourhood correctly (bidirectional).
  5. --near composes with --path, --context, --case-sensitive, --limit.
  6. ztl serve /api/search returns same results as CLI (minus graph scoping).
  7. Serve mode Cmd+K shows full-text results with heading context.
  8. ztl build emits valid search-index.json.
  9. Build mode Cmd+K performs client-side BM25 search.
  10. Index invalidation: modify a file, re-index, verify search reflects changes.
  11. Lazy index: search without prior index works.
  12. All NFR targets met: index build ≤5s, query ≤100ms, BFS ≤50ms, API ≤50ms (for reasonable corpus sizes).
  13. cargo test passes.

All REQ-013-*, TEST-013-*, NFR-013-*.")
  (acceptance "All 13 scenarios pass; full feature set from SPEC-013 operational; no regressions in existing ztl functionality; search parity across CLI, serve, and build interfaces"))

(normally r-ready-integration-test
  (and task-integration-test completed-verify-phase3 completed-verify-phase4)
  ready-integration-test)

(normally r-assign-integration-test
  (and ready-integration-test agent-claude-available)
  assign-to-integration-test-claude)

;; ════════════════════════════════════════════════════════════════════════════
;; Rule Metadata
;; ════════════════════════════════════════════════════════════════════════════

(meta r-ready-add-tantivy
  (description "Tantivy dependency has no prerequisites")
  (justification "First task — no existing code depends on it yet"))

(meta r-ready-search-index-module
  (description "Search index module requires tantivy to be available")
  (justification "Module directly imports tantivy types for schema, index, and query"))

(meta r-ready-heading-detection
  (description "Heading detection requires tantivy to be available")
  (justification "While heading detection itself doesn't use tantivy, it's part of the same phase and shares the search module"))

(meta r-ready-integrate-index
  (description "Index integration requires the search index module")
  (justification "cmd_index calls SearchIndex::build() which must exist first"))

(meta r-ready-refactor-search
  (description "Search refactor requires both the index module and heading detection")
  (justification "New search flow queries Tantivy and attaches heading context to results"))

(meta r-ready-update-cli
  (description "CLI update requires the refactored search module")
  (justification "CLI flags must match the new search API — no --regex, new output fields"))

(meta r-ready-lazy-index
  (description "Lazy index requires the refactored search")
  (justification "Lazy build is a fallback path in the search flow — needs the new search to exist"))

(meta r-ready-verify-phase1
  (description "Phase 1 verification requires all Phase 1 tasks complete")
  (justification "End-to-end check of Tantivy search, headings, lazy build, CLI"))

(meta r-ready-neighbourhood-bfs
  (description "Neighbourhood BFS depends on Phase 1 being verified")
  (justification "Phase 2 builds on a working Tantivy search from Phase 1"))

(meta r-ready-near-depth-cli
  (description "CLI flags require the neighbourhood BFS implementation")
  (justification "Flags must invoke the neighbourhood computation which must exist"))

(meta r-ready-wire-graph-scoping
  (description "Graph scoping requires the CLI flags and neighbourhood BFS")
  (justification "Wiring connects the CLI flags to the neighbourhood filter in search"))

(meta r-ready-verify-phase2
  (description "Phase 2 verification requires graph scoping to be wired")
  (justification "End-to-end check of --near/--depth with various graph structures"))

(meta r-ready-tantivy-webstate
  (description "WebState extension depends on Phase 2 being verified")
  (justification "Phase 3 builds on working CLI search; serve mode shares the same index"))

(meta r-ready-api-search
  (description "API endpoint requires SearchIndex in WebState")
  (justification "Handler reads from SearchIndex stored in WebState"))

(meta r-ready-serve-cmdk
  (description "Cmd+K upgrade requires the API endpoint")
  (justification "Modal fetches results from /api/search which must exist"))

(meta r-ready-verify-phase3
  (description "Phase 3 verification requires serve Cmd+K to be functional")
  (justification "End-to-end check of serve search API and modal"))

(meta r-ready-search-index-json
  (description "Static index generation depends on Phase 2 being verified")
  (justification "Build needs the same search pipeline; Phase 2 ensures it works"))

(meta r-ready-bm25-js
  (description "BM25 JS scorer requires search-index.json to exist")
  (justification "Scorer is designed to consume the specific JSON schema"))

(meta r-ready-build-cmdk
  (description "Build Cmd+K requires the BM25 scorer")
  (justification "Modal uses the scorer to rank results client-side"))

(meta r-ready-verify-phase4
  (description "Phase 4 verification requires build Cmd+K to be functional")
  (justification "End-to-end check of static search index and client-side search"))

(meta r-ready-integration-test
  (description "Integration test requires all phases verified")
  (justification "Final comprehensive test of the complete SPEC-013 feature set"))
