;; TEST-user-testing.spl — Comprehensive user testing of ztl
;; Following USDD Agent Protocol for synthetic user testing

(meta plan
  (id "TEST-USER")
  (title "Comprehensive User Testing of ztl")
  (status "active")
  (description "Systematic user testing of all ztl features against ztl-vault, documenting bugs, improvements, and findings per USDD protocol"))

;; ── Agents ──────────────────────────────────────────────────────
(given agent-claude-available)

;; ── T1: User profiles ──────────────────────────────────────────
(given task-T1)
(given no-deps-T1)
(meta task-T1
  (description "Create synthetic user profiles and happy paths for testing")
  (acceptance "User profiles and happy paths documented in test report"))

(normally r-ready-T1
  (and task-T1 no-deps-T1)
  ready-T1)

(normally r-assign-T1
  (and ready-T1 agent-claude-available)
  assign-to-T1-claude)

;; ── T2: Core graph commands ─────────────────────────────────────
(given task-T2)
(meta task-T2
  (description "Test core graph commands: index, links, backlinks, path, similar, blocks, list, stats, export")
  (acceptance "All core commands tested, findings documented"))

(normally r-ready-T2
  (and task-T2 completed-T1)
  ready-T2)

(normally r-assign-T2
  (and ready-T2 agent-claude-available)
  assign-to-T2-claude)

;; ── T3: Search ──────────────────────────────────────────────────
(given task-T3)
(meta task-T3
  (description "Test search: full-text, context, case-sensitive, path filter, near/neighbourhood")
  (acceptance "Search functionality fully exercised, findings documented"))

(normally r-ready-T3
  (and task-T3 completed-T1)
  ready-T3)

(normally r-assign-T3
  (and ready-T3 agent-claude-available)
  assign-to-T3-claude)

;; ── T4: Diagnostics ─────────────────────────────────────────────
(given task-T4)
(meta task-T4
  (description "Test check command: dead-links, orphans, syntax, format modes")
  (acceptance "All diagnostic modes tested, findings documented"))

(normally r-ready-T4
  (and task-T4 completed-T1)
  ready-T4)

(normally r-assign-T4
  (and ready-T4 agent-claude-available)
  assign-to-T4-claude)

;; ── T5: View TUI ────────────────────────────────────────────────
(given task-T5)
(meta task-T5
  (description "Test ztl view: page rendering, context cards, navigation, help overlay")
  (acceptance "View TUI tested for rendering correctness"))

(normally r-ready-T5
  (and task-T5 completed-T1)
  ready-T5)

(normally r-assign-T5
  (and ready-T5 agent-claude-available)
  assign-to-T5-claude)

;; ── T6: TUI dashboard ───────────────────────────────────────────
(given task-T6)
(meta task-T6
  (description "Test ztl tui: tabs, navigation, search, diagnostics, page view")
  (acceptance "TUI dashboard tested across all tabs"))

(normally r-ready-T6
  (and task-T6 completed-T1)
  ready-T6)

(normally r-assign-T6
  (and ready-T6 agent-claude-available)
  assign-to-T6-claude)

;; ── T7: Web serve and build ─────────────────────────────────────
(given task-T7)
(meta task-T7
  (description "Test ztl serve and build: web UI, API endpoints, themes, static export")
  (acceptance "Web serve and build tested, findings documented"))

(normally r-ready-T7
  (and task-T7 completed-T1)
  ready-T7)

(normally r-assign-T7
  (and ready-T7 agent-claude-available)
  assign-to-T7-claude)

;; ── T8: Theme management ────────────────────────────────────────
(given task-T8)
(meta task-T8
  (description "Test theme list, export, install, remove")
  (acceptance "Theme commands tested, findings documented"))

(normally r-ready-T8
  (and task-T8 completed-T1)
  ready-T8)

(normally r-assign-T8
  (and ready-T8 agent-claude-available)
  assign-to-T8-claude)

;; ── T9: Hooks ───────────────────────────────────────────────────
(given task-T9)
(meta task-T9
  (description "Test hook list and hook run")
  (acceptance "Hook commands tested, findings documented"))

(normally r-ready-T9
  (and task-T9 completed-T1)
  ready-T9)

(normally r-assign-T9
  (and ready-T9 agent-claude-available)
  assign-to-T9-claude)

;; ── T10: Diff and watch ─────────────────────────────────────────
(given task-T10)
(meta task-T10
  (description "Test diff command and watch mode")
  (acceptance "Diff and watch tested, findings documented"))

(normally r-ready-T10
  (and task-T10 completed-T1)
  ready-T10)

(normally r-assign-T10
  (and ready-T10 agent-claude-available)
  assign-to-T10-claude)

;; ── T11: Compile report ─────────────────────────────────────────
(given task-T11)
(meta task-T11
  (description "Compile all findings into USDD-format test report markdown")
  (acceptance "Complete test report in docs/TEST-user-testing.md"))

(normally r-ready-T11
  (and task-T11 completed-T2 completed-T3 completed-T4 completed-T5 completed-T6 completed-T7 completed-T8 completed-T9 completed-T10)
  ready-T11)

(normally r-assign-T11
  (and ready-T11 agent-claude-available)
  assign-to-T11-claude)

(claims agent:ed25519:xfRAzZFG
  :at "2026-04-07T05:52:52Z"
  (given claim-v1-T1)
  (normally r-cl-state-v1-T1 claim-v1-T1 state-claimed-v1-T1)
  (normally r-cl-chain-v1-T1 state-claimed-v1-T1 claimed-T1)
)

