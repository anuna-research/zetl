;; ─── Safety defeaters ────────────────────────────────────────────────────────

;; Block any temporal command task if jj-backend is not complete
(except d-block-temporal-without-jj
  (not completed-jj-backend)
  (not ready-point-in-time-query))

;; Block integration tests if any feature task has failed
(except d-block-integration-if-failed
  (or failed-vcs-init
      failed-auto-snapshot
      failed-historical-index-cache
      failed-time-expression-parser
      failed-point-in-time-query
      failed-history-cli
      failed-history-page-cli
      failed-diff-jj-backend
      failed-watch-mode-snapshot
      failed-graceful-degradation
      failed-vault-history-template-context
      failed-page-history-template-context
      failed-backlink-timestamps
      failed-serve-history-api
      failed-build-history-export
      failed-hook-context-history
      failed-tui-timeline-navigation
      failed-observability)
  (not ready-integration-tests))

(prefer d-block-integration-if-failed r-ready-integration-tests)

;; ─── Rule metadata ───────────────────────────────────────────────────────────

(meta d-block-temporal-without-jj
  (description "Point-in-time query infrastructure cannot be built before the jj-lib backend is complete")
  (justification "REQ-078 requires JjBackend for MergedTree access; all temporal commands depend on it"))

(meta d-block-integration-if-failed
  (description "Integration tests must not run if any feature task has failed")
  (justification "Failed prerequisite tasks produce incomplete or incorrect implementations; running integration tests against them wastes resources and produces misleading results"))

(meta r-assign-integration-tests
  (description "Integration tests assigned to tester agent by default")
  (justification "Dedicated tester agent verifies NFR latency bounds and full TEST-080 through TEST-113 suite"))
