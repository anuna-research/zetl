(normally r-a1 (and ready-fix-72-dark-scheme agent-claude-available) assign-to-fix-72-dark-scheme-claude)
(normally r-a2 (and ready-fix-73-spa-verify agent-claude-available) assign-to-fix-73-spa-verify-claude)
(normally r-a3 (and ready-fix-73-build-404 agent-claude-available) assign-to-fix-73-build-404-claude)
(normally r-a4 (and ready-verify agent-claude-available) assign-to-verify-claude)

(claims agent:claude
  :at "2026-07-03T01:01:41Z"
  (given claim-v1-fix-72-dark-scheme)
  (normally r-cl-state-v1-fix-72-dark-scheme claim-v1-fix-72-dark-scheme state-claimed-v1-fix-72-dark-scheme)
  (normally r-cl-chain-v1-fix-72-dark-scheme state-claimed-v1-fix-72-dark-scheme claimed-fix-72-dark-scheme)
)

