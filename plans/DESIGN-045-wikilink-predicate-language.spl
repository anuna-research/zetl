(meta task-adr-ast-representation
  (description "Finalise ADR-4501: extend the Wikilink AST node with an optional predicate field vs introduce a new NamedEdge node. Use task-survey-ast-evolution and task-survey-parse-boundary findings. Decide the annotation-placement asymmetry (predicate on the node, annotation at the graph layer from the ListItem subtree -- REQ-4504) and whether ![[embed]] gains a predicate (strawman: no). Document the additive-evolution argument and consequences.")
  (acceptance "SPEC-045 contains ADR-4501 with the two-option analysis, decision, the additive-compatibility justification, the annotation-placement decision, the embed decision, and consequences (positive + negative).")
  (trace "ADR-4501 in SPEC-045"))

(meta task-adr-vocab-governance
  (description "Finalise ADR-4502 (curated folksonomy: undeclared predicate WARNS not errors, reusing the existing --fail-on warning gate) and ADR-4503 (ship is_a::->conforms_to:: as advice not auto-rewrite, with the accept_is_a escape hatch). Ground both in task-prior-art-vocab-governance and the source guide's governance stance. Confirm no new gate primitive is introduced.")
  (acceptance "SPEC-045 contains ADR-4502 and ADR-4503 each with option analysis, decision, and consequences; both explicitly cite the guide's folksonomy/naming-sovereignty stance; ADR-4502 confirms reuse of the existing fail-on machinery.")
  (trace "ADR-4502 ADR-4503 in SPEC-045"))

(meta task-adr-spl-projection
  (description "Finalise ADR-4504: named edges project to provenance-tagged SPL facts (sugar-over-SPL, mirroring SPEC-042's public_paths). Ground in task-survey-reason-projection. This is the Tier-2 ADR: it MUST address the page-authored-fact trust boundary (Threat Model A), the provenance-tagging requirement, the untyped-edges-not-projected rule, determinism/order-stability, and the projection-volume/NFR-4503 bound. Cross-reference SPEC-042's sugar-over-SPL precedent explicitly.")
  (acceptance "SPEC-045 contains ADR-4504 with option analysis, decision, the trust-boundary treatment, the provenance-tagging mandate, and consequences flagging that any rule consuming a projected fact is Tier-2; cross-references SPEC-042.")
  (trace "ADR-4504 in SPEC-045 ThreatModelA"))

(meta task-adr-frontmatter-boundary
  (description "Finalise ADR-4505 (predicates live in the body, not the frontmatter). Ground it in the guide's unconflation principle (YAML = scalars, body = relationships to pages that participate in the graph) and the migration-helper rationale (REQ-4513 moves relationship-shaped tags out of frontmatter). Address the consequence that some document properties (e.g. has_status::[[Draft]]) become body edges rather than YAML fields, and why the guide argues that is correct.")
  (acceptance "SPEC-045 contains ADR-4505 with option analysis (body vs frontmatter vs both), decision, and consequences; cites the unconflation principle; reconciles with REQ-4513.")
  (trace "ADR-4505 in SPEC-045"))

(meta task-adr-query-surface
  (description "Finalise ADR-4506: a new zetl edges subcommand vs extending the existing zetl links / zetl backlinks commands (src/cli.rs:120). Ground in USDD Constitutional Principle 15 (right place for the function) and the composition-first feasibility check (could the predicate-filter set be flags on zetl links without bloating it?). Use task-survey-graph-internals for the filter set and the NFR-4502 latency budget. Document the intentional untyped-case overlap (zetl edges --untyped ~ zetl links) as a superset relationship, not duplication.")
  (acceptance "SPEC-045 contains ADR-4506 with two-option analysis, a recorded composition-first feasibility check, decision, and consequences; cites Principle 15 and documents the deliberate superset overlap with zetl links.")
  (trace "ADR-4506 in SPEC-045 REQ-4509"))

(meta task-grammar-langsec
  (description "Finalise the named-edge grammar (CON-4501) per USDD section LangSec / Constitutional Principle 14. Deliver: the ABNF for predicate '::' wikilink (regular grammar, the lowest sufficient class); the binding rule (predicate binds to the immediately-following wikilink, no intervening whitespace); the malformed-token disposition matrix (each row -> untyped-edge or syntax-diagnostic, never a guessed normalisation); the code/frontmatter exclusion guarantee; and the recogniser's one-parser-per-language commitment (the predicate recogniser composes with, not forks, the existing wikilink recogniser). Confirm conservative-in-what-you-accept (reject, do not repair).")
  (acceptance "SPEC-045 CON-4501 contains the ABNF, the binding rule, the complete disposition matrix matching the strawman, pre/post-conditions, and an error model stating no typed edge is ever produced by guessing; the grammar class is named and justified as the lowest sufficient.")
  (trace "CON-4501 in SPEC-045 PROTO-001 LangSec"))

(meta task-contracts
  (description "Finalise the public contracts for SPEC-045: CON-4501 named-edge grammar (from task-grammar-langsec); CON-4502 .zetl/predicates.toml schema (category set with deny_unknown_fields, per-predicate display/construction/catch_all markers, accept_is_a, fail-closed on malformed file); CON-4503 zetl edges CLI (filters, json row shape, read-only/idempotent, superset of zetl links); CON-4504 SPL fact projection (fact shape, provenance fields, untyped-not-projected, determinism, information-preserving triple property); CON-4505 Wikilink AST extension (optional predicate, required-set unchanged, ast_version bump, schema pattern). Each contract: pre-conditions, post-conditions, error model, structured per-clause so each implemented REQ maps to a distinct clause.")
  (acceptance "SPEC-045 contains CON-4501..CON-4505 each with the four required subsections and a non-empty implements-list; per-clause structure verified so each REQ maps to a distinct clause.")
  (trace "CON-### in SPEC-045"))

(meta task-purity-boundary-map
  (description "Finalise the Purity Boundary Map. PURE core: the named-edge recogniser (string -> Wikilink{predicate}; the LangSec recogniser, a fuzz+property target); the vocabulary classifier (predicate + declared-set -> category|undeclared + nearest-match); the fact projector (Wikilink{predicate}+slugs -> fact triple; roundtrip property holds); the labelled-graph builder. EFFECTFUL shell: vault scan, predicates.toml load, zetl edges/check/predicates handlers, search-index write, SPL theory assembly + reasoner invocation. Boundary contracts: Wikilink{predicate}, EdgeMeta{predicate,annotation}, (predicate src tgt)+provenance. Document the dependency rule (recogniser/classifier/projector take vocabulary as data, do no I/O) and the enforcement (Rust module visibility + the existing SPEC-032 parse-pipeline purity discipline).")
  (acceptance "SPEC-045 'Purity Boundary Map' section has the four required subsections; the pure core explicitly lists the recogniser/classifier/projector/graph-builder; the dependency rule states the pure functions receive vocabulary as a parameter and perform no I/O.")
  (trace "USDD section Purity Boundary Map"))

(meta task-test-strategy
  (description "Finalise the verification strategy. SPEC-045 is an AI-synthesised spec, so per the USDD selection table it requires requirement-targeted decomposition + mutation testing + adversarial testing (mandatory). The recogniser is a parser at a trust boundary -> fuzzing REQUIRED (with the src/hooks/ast/parse.rs multibyte-panic hazard as a named target). The projection is a transform -> roundtrip property test REQUIRED (triple(project(e))==e) plus provenance-preservation and determinism properties. Deliver: TEST-45xx per REQ with positive/negative-input/negative-output decomposition; the CON-4501 disposition matrix as example cases; golden-equivalence tests for REQ-4505 backward compat (graph+web+search byte-identical on a predicate-free vault); mutation-testing targets (recogniser, predicate-filter logic) with thresholds.")
  (acceptance "SPEC-045 'Verification and Testing Strategy' section contains TEST-4501..TEST-4514 (+ NFR tests) matched to REQs with explicit three-type coverage; the fuzz target + multibyte hazard named; the projection property tests specified; mutation-testing target modules + thresholds stated.")
  (trace "TEST-### in SPEC-045"))

(meta task-threat-model
  (description "Finalise the threat model. The PRIMARY new boundary is page-authored facts. AT MINIMUM: (A) predicate fact spoofing -- page A asserts validated_by::/conforms_to:: about B/a contract that never granted it; mitigation: provenance-tagged facts + trust-scoping by _source_page + Tier-2 review of any consuming rule; (B) predicate injection via content -- crafted :: in tables/footnotes/HTML/autolinks tricks the recogniser or panics the multibyte byte-indexer; mitigation: LangSec full recognition + fuzzing; (C) vocabulary-file confusion -- malformed predicates.toml silently disables governance; mitigation: deny_unknown_fields + fail-closed; (D) ghost-edge title leakage on public pages -- interacts with SPEC-042 REQ-4213 redaction; mitigation: typed edges inherit the existing public-page rendering policy. Each: severity, likelihood, mitigation (referencing implementing REQ/CON/NFR), residual risk.")
  (acceptance "SPEC-045 'Threat Model' section has one entry per A..D (plus any new threats surfaced) with severity/likelihood/mitigation/residual-risk; mitigations reference implementing REQ/CON; Threat Model A explicitly drives the Tier-2 classification.")
  (trace "Threat Model in SPEC-045"))

(meta task-phase2-quality-gates
  (description "Apply USDD Phase 2 Quality Gates to SPEC-045: adheres to constitutional principles; single-responsibility components; functionality via well-defined interfaces; capability placement justified (the zetl edges command, the predicate field, the projection step each have a recorded placement rationale per Principle 15); tests derived from requirements; security controls specified with verifiable criteria (Threat Model A..D); observability captured (OBS-4501..4303). Failures fixed before completion.")
  (acceptance "SPEC-045 Quality Gates section has a Phase 2 checklist with every gate marked pass and a trace to the artefact establishing each (composition-first feasibility check recorded for the new zetl edges command).")
  (trace "USDD section Phase 2 Quality Gates"))

(meta task-cross-model-review
  (description "Per USDD Multi-Model Cognitive Diversity (Tier 2): submit SPEC-045 to a fresh-context review by a DIFFERENT model family. Reviewer receives SPEC-045, the user profiles, the happy paths, and the threat model, plus an adversarial prompt instructing them to find defects -- not to ratify. Reviewer MUST NOT see this generating session's reasoning or the prior-art notes (so blind spots are not transferred). Special focus on the trust-boundary ADR-4504 and Threat Model A, and on whether the additive-AST claim (ADR-4501) truly preserves every existing hook contract. Findings categorised per the USDD finding taxonomy.")
  (acceptance "research/SPEC-045-cross-model-review.md exists with reviewer model+version, the review prompt, categorised findings, and an explicit disposition per finding; findings produce >= 3 SPEC-045 amendments OR a recorded explanation for why none warranted.")
  (trace "USDD section Multi-Model Cognitive Diversity"))

(meta task-adversarial-tests
  (description "Per USDD section Adversarial Testing: a separate fresh-context agent generates adversarial tests aimed at BREAKING SPEC-045. Particular attention to: recogniser bypass/confusion (:: inside link text/aliases, nested brackets, predicate adjacent to ![[embed]], Unicode/homoglyph predicates that look declared but are not, multibyte chars adjacent to ::); projection-fact spoofing variants (a page minting facts about many other pages); determinism breaks (does edge ordering depend on filesystem iteration order?); vocabulary-classifier nearest-match abuse; backward-compat violations (any predicate-free input whose output differs from baseline). Iterate until adversary exhaustion.")
  (acceptance "research/SPEC-045-adversarial-tests.md exists with >= 25 adversarial cases; per-case disposition; SPEC-045 amendments applied; final adversary-exhaustion statement OR escalated open questions.")
  (trace "USDD section Adversarial Testing"))

(meta task-draft-impl-045
  (description "Author plans/IMPL-045-wikilink-predicate-language.spl scaffolded for downstream implementation. Use the IMPL-### plan structure (e.g. plans/IMPL-032-033.spl, IMPL-026.spl). Required: (meta plan ...), (given agent-...-available), tasks per REQ/CON with a sensible build order (grammar+recogniser -> AST extension -> graph typing -> vocab file+lints -> zetl edges -> SPL projection -> typed backlinks -> search -> migration helper), ready- rules encoding that dependency DAG, assign-to- rules, and task metadata (description + acceptance per task). Do NOT execute. Do NOT write code. Must pass hence plan validate.")
  (acceptance "plans/IMPL-045-wikilink-predicate-language.spl exists; 'hence plan validate plans/IMPL-045-wikilink-predicate-language.spl --strict' returns zero errors; every REQ-### and CON-### in SPEC-045 traces to at least one IMPL-045 task.")
  (trace "IMPL-045 plan deliverable"))

(meta task-mark-spec-approved
  (description "Final task. Update specs/SPEC-045-wikilink-predicate-language.md frontmatter status from 'draft' to 'approved' and version from 0.2.0 to 1.0.0. Update CHANGELOG.md recording: SPEC-045 approved, references DESIGN-045 plan, IMPL-045 implementation plan ready, no code written under DESIGN-045. Commit per repo convention. DO NOT merge without explicit human approval. Phase 3 begins after a human reviewer signs off (note: the SPL-projection trust boundary makes that sign-off load-bearing).")
  (acceptance "SPEC-045 status=approved version=1.0.0; CHANGELOG.md entry exists; commit (or PR) prepared but not merged without human approval.")
  (trace "USDD Phase 1+2 closeout"))

;; -- Readiness Rules (DAG) -----------------------------

;; Phase 0 -- reconciliation + surveys + prior art are root tasks
(normally r-ready-reconcile-spec-044
  (and task-reconcile-spec-044 no-deps-reconcile-spec-044)
  ready-reconcile-spec-044)

(normally r-ready-survey-parse-boundary
  (and task-survey-parse-boundary no-deps-survey-parse-boundary)
  ready-survey-parse-boundary)

(normally r-ready-survey-graph-internals
  (and task-survey-graph-internals no-deps-survey-graph-internals)
  ready-survey-graph-internals)

(normally r-ready-survey-reason-projection
  (and task-survey-reason-projection no-deps-survey-reason-projection)
  ready-survey-reason-projection)

(normally r-ready-survey-ast-evolution
  (and task-survey-ast-evolution no-deps-survey-ast-evolution)
  ready-survey-ast-evolution)

(normally r-ready-prior-art-typed-links
  (and task-prior-art-typed-links no-deps-prior-art-typed-links)
  ready-prior-art-typed-links)

(normally r-ready-prior-art-vocab-governance
  (and task-prior-art-vocab-governance no-deps-prior-art-vocab-governance)
  ready-prior-art-vocab-governance)

;; Phase 1 -- profiles + happy paths after relevant surveys.
;; Reconciliation with SPEC-044 GATES all of Phase 1 onward (it can change the
;; authoring surface and thus the whole REQ shape).
(normally r-ready-user-profiles
  (and task-user-profiles
       completed-reconcile-spec-044
       completed-prior-art-typed-links
       completed-prior-art-vocab-governance)
  ready-user-profiles)

(normally r-ready-happy-paths
  (and task-happy-paths completed-user-profiles)
  ready-happy-paths)

;; Phase 2 -- requirements + concept pages + synthetic-user + phase-1 gates
(normally r-ready-draft-requirements
  (and task-draft-requirements
       completed-happy-paths
       completed-survey-parse-boundary
       completed-survey-graph-internals
       completed-survey-reason-projection
       completed-survey-ast-evolution)
  ready-draft-requirements)

(normally r-ready-author-concept-pages
  (and task-author-concept-pages completed-draft-requirements)
  ready-author-concept-pages)

(normally r-ready-synthetic-user-run
  (and task-synthetic-user-run completed-draft-requirements)
  ready-synthetic-user-run)

(normally r-ready-phase1-quality-gates
  (and task-phase1-quality-gates completed-synthetic-user-run)
  ready-phase1-quality-gates)

;; Phase 3 -- ADRs + grammar + contracts + maps + threat-model + phase-2 gates
(normally r-ready-adr-ast-representation
  (and task-adr-ast-representation
       completed-phase1-quality-gates
       completed-survey-ast-evolution
       completed-survey-parse-boundary)
  ready-adr-ast-representation)

(normally r-ready-adr-vocab-governance
  (and task-adr-vocab-governance
       completed-phase1-quality-gates
       completed-prior-art-vocab-governance)
  ready-adr-vocab-governance)

(normally r-ready-adr-spl-projection
  (and task-adr-spl-projection
       completed-phase1-quality-gates
       completed-survey-reason-projection)
  ready-adr-spl-projection)

(normally r-ready-adr-frontmatter-boundary
  (and task-adr-frontmatter-boundary completed-phase1-quality-gates)
  ready-adr-frontmatter-boundary)

(normally r-ready-adr-query-surface
  (and task-adr-query-surface
       completed-phase1-quality-gates
       completed-survey-graph-internals)
  ready-adr-query-surface)

(normally r-ready-grammar-langsec
  (and task-grammar-langsec
       completed-adr-ast-representation
       completed-survey-parse-boundary)
  ready-grammar-langsec)

(normally r-ready-contracts
  (and task-contracts
       completed-adr-ast-representation
       completed-adr-vocab-governance
       completed-adr-spl-projection
       completed-adr-frontmatter-boundary
       completed-adr-query-surface
       completed-grammar-langsec)
  ready-contracts)

(normally r-ready-purity-boundary-map
  (and task-purity-boundary-map completed-contracts)
  ready-purity-boundary-map)

(normally r-ready-test-strategy
  (and task-test-strategy completed-purity-boundary-map)
  ready-test-strategy)

(normally r-ready-threat-model
  (and task-threat-model
       completed-adr-spl-projection
       completed-grammar-langsec)
  ready-threat-model)

(normally r-ready-phase2-quality-gates
  (and task-phase2-quality-gates
       completed-contracts
       completed-purity-boundary-map
       completed-test-strategy
       completed-threat-model)
  ready-phase2-quality-gates)

;; Phase 4 -- Tier 2 review + adversarial tests
(normally r-ready-cross-model-review
  (and task-cross-model-review completed-phase2-quality-gates)
  ready-cross-model-review)

(normally r-ready-adversarial-tests
  (and task-adversarial-tests completed-phase2-quality-gates)
  ready-adversarial-tests)

;; Phase 5 -- IMPL-045 scaffold + spec approval
(normally r-ready-draft-impl-045
  (and task-draft-impl-045
       completed-cross-model-review
       completed-adversarial-tests)
  ready-draft-impl-045)

(normally r-ready-mark-spec-approved
  (and task-mark-spec-approved
       completed-draft-impl-045
       completed-author-concept-pages)
  ready-mark-spec-approved)

;; -- Assignment Rules ----------------------------------

(normally r-assign-reconcile-spec-044 (and ready-reconcile-spec-044 agent-claude-available) assign-to-reconcile-spec-044-claude)
(normally r-assign-survey-parse-boundary (and ready-survey-parse-boundary agent-claude-available) assign-to-survey-parse-boundary-claude)
