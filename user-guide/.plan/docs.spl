; =============================================================================
; zetl User Guide — comprehensive vault at ../zetl-docs
; =============================================================================

(meta plan
  (title "zetl User Guide")
  (status "active")
  (created "2026-04-21")
  (description "Build a comprehensive zetl user guide as a zetl vault at /Users/anuna-01/Code/zetl-docs. Audience: writers and knowledge workers. Scope: every feature in README.md + zetl-features.md (install, vault basics, writing, finding, reading, history, reasoning, collaboration, automation, reference, help)."))

; --- AGENTS ---
(given agent-hugo-available)

; --- TASKS ---
(given task-scaffold)
(given task-getting-started)
(given task-concepts)
(given task-writing)
(given task-finding)
(given task-reading)
(given task-history)
(given task-reasoning)
(given task-collaboration)
(given task-automation)
(given task-reference)
(given task-help)
(given task-crosslink)
(given task-verify)

; --- TASK METADATA ---
(meta task-scaffold
  (description "Scaffold the docs vault: Index.md, directory skeleton, optional .zetl/ config, README.md for GitHub/Codeberg visitors")
  (acceptance "Directory /Users/anuna-01/Code/zetl-docs exists with Index.md, all section folders, and README.md explaining how to read the guide"))

(meta task-getting-started
  (description "Write getting-started/ section: What is zetl, Installation, Quick Start, Your First Vault, Migrating from Obsidian")
  (acceptance "5 pages in getting-started/, each with working examples a writer can copy-paste"))

(meta task-concepts
  (description "Write concepts/ section: Vaults, Wikilinks, The Link Graph, Blocks, Frontmatter, Local-first, What is SPL")
  (acceptance "7 pages in concepts/ explaining the mental model; no CLI minutiae"))

(meta task-writing
  (description "Write writing/ section: Writing Pages, Linking Pages, Embeds and Transclusion, Headings and Blocks, Organising Your Vault, Tags and Frontmatter")
  (acceptance "6 pages in writing/; practical how-tos with before/after examples"))

(meta task-finding
  (description "Write finding/ section: Searching, Backlinks, Similar Pages, Following Links, Finding Orphans and Dead Links")
  (acceptance "5 pages in finding/; covers search, similar, links, dead-links, stats"))

(meta task-reading
  (description "Write reading/ section: Terminal Viewer, Web Server, Static Site Export, Customising the Look (themes)")
  (acceptance "4 pages in reading/; covers view, serve, build, themes"))

(meta task-history
  (description "Write history/ section: Time Travel, Watching for Changes, Page History, Snapshots under the hood (jj)")
  (acceptance "4 pages in history/; feature-gated notes for --features history"))

(meta task-reasoning
  (description "Write reasoning/ section: What is Defeasible Reasoning, Writing SPL, Running Queries, Proof Trees, What-if and Abduction")
  (acceptance "5 pages in reasoning/; motivates SPL for non-programmers, feature-gated"))

(meta task-collaboration
  (description "Write collaboration/ section: Running a Team Server, Passkeys and Accounts, Invitations, Co-editing, Access Control, Capability URLs")
  (acceptance "5-6 pages in collaboration/; includes BIP39 recovery and capability-URL static distribution"))

(meta task-automation
  (description "Write automation/ section: Lifecycle Hooks, Render Pipeline Hooks, Plugin Ecosystems (Pandoc/mdBook/remark), MCP Server for AI agents")
  (acceptance "4 pages in automation/; ecosystems feature-gated, safe-mode explained"))

(meta task-reference
  (description "Write reference/ section: CLI Overview, Configuration, Frontmatter Fields, Glossary")
  (acceptance "4 pages in reference/; cross-referenced from the rest of the vault"))

(meta task-help
  (description "Write help/ section: Troubleshooting, FAQ")
  (acceptance "2 pages in help/; covers common first-time-user pitfalls"))

(meta task-crosslink
  (description "Audit wikilinks across the vault: ensure every page links to its prerequisites, parent concept, and related pages; add a short 'Related' section where helpful")
  (acceptance "`zetl check /Users/anuna-01/Code/zetl-docs` reports no dead links; every page has at least one inbound link (no orphans except Index.md)"))

(meta task-verify
  (description "Build the vault with `zetl build` and `zetl serve` to confirm it renders; fix any parse errors or frontmatter issues")
  (acceptance "`zetl build /Users/anuna-01/Code/zetl-docs --out /tmp/zetl-docs-dist` succeeds with no errors"))

; --- READINESS RULES ---
; scaffold is ready immediately
(given no-deps-scaffold)
(normally r-ready-scaffold
  (and task-scaffold no-deps-scaffold)
  ready-scaffold)

; all content sections are ready once scaffold is done
(normally r-ready-getting-started completed-scaffold ready-getting-started)
(normally r-ready-concepts        completed-scaffold ready-concepts)
(normally r-ready-writing         completed-scaffold ready-writing)
(normally r-ready-finding         completed-scaffold ready-finding)
(normally r-ready-reading         completed-scaffold ready-reading)
(normally r-ready-history         completed-scaffold ready-history)
(normally r-ready-reasoning       completed-scaffold ready-reasoning)
(normally r-ready-collaboration   completed-scaffold ready-collaboration)
(normally r-ready-automation      completed-scaffold ready-automation)
(normally r-ready-reference       completed-scaffold ready-reference)
(normally r-ready-help            completed-scaffold ready-help)

; crosslink is ready once every content section is done
(normally r-ready-crosslink
  (and completed-getting-started
       completed-concepts
       completed-writing
       completed-finding
       completed-reading
       completed-history
       completed-reasoning
       completed-collaboration
       completed-automation
       completed-reference
       completed-help)
  ready-crosslink)

; verify is ready once crosslink is done
(normally r-ready-verify completed-crosslink ready-verify)

; --- ASSIGNMENT RULES ---
(normally r-assign-scaffold        (and ready-scaffold        agent-hugo-available) assign-to-scaffold-hugo)
(normally r-assign-getting-started (and ready-getting-started agent-hugo-available) assign-to-getting-started-hugo)
(normally r-assign-concepts        (and ready-concepts        agent-hugo-available) assign-to-concepts-hugo)
(normally r-assign-writing         (and ready-writing         agent-hugo-available) assign-to-writing-hugo)
(normally r-assign-finding         (and ready-finding         agent-hugo-available) assign-to-finding-hugo)
(normally r-assign-reading         (and ready-reading         agent-hugo-available) assign-to-reading-hugo)
(normally r-assign-history         (and ready-history         agent-hugo-available) assign-to-history-hugo)
(normally r-assign-reasoning       (and ready-reasoning       agent-hugo-available) assign-to-reasoning-hugo)
(normally r-assign-collaboration   (and ready-collaboration   agent-hugo-available) assign-to-collaboration-hugo)
(normally r-assign-automation      (and ready-automation      agent-hugo-available) assign-to-automation-hugo)
(normally r-assign-reference       (and ready-reference       agent-hugo-available) assign-to-reference-hugo)
(normally r-assign-help            (and ready-help            agent-hugo-available) assign-to-help-hugo)
(normally r-assign-crosslink       (and ready-crosslink       agent-hugo-available) assign-to-crosslink-hugo)
(normally r-assign-verify          (and ready-verify          agent-hugo-available) assign-to-verify-hugo)

(claims agent:hugo
  :at "2026-04-21T05:13:49Z"
  (given claim-v1-scaffold)
  (normally r-cl-state-v1-scaffold claim-v1-scaffold state-claimed-v1-scaffold)
  (normally r-cl-chain-v1-scaffold state-claimed-v1-scaffold claimed-scaffold)
)

